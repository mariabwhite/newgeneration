  function loadProgress() {
    const saved = localStorage.getItem('restaurantMenuProgress_RoseGold');
    if (saved) {
      const data = JSON.parse(saved);
      activityCompleted = data.completed || false;
      if (data.menu) menuState = data.menu;
      updateProgress();
