              </div>
            </div>
            <div class="menu-summary">
              <strong>Your Menu Summary</strong>
              <div class="summary-grid">
                <div class="summary-item"><strong>Appetizer</strong><span id="summary-appetizer">Not chosen yet</span></div>
                <div class="summary-item"><strong>Soup</strong><span id="summary-soup">Optional</span></div>
