<!DOCTYPE html>
<html lang="en" data-theme="rosegold">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Restaurant Menu Lab | B1 | LinguaBoost Lab</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;800;900&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
/* ========== ROSE GOLD В· CREAM В· BROWN В· GOLD DESIGN SYSTEM ========== */
[data-theme="rosegold"] {
  --bg: #fffaf5;
  --bg-2: #fef4ea;
  --card: #ffffff;
  --card-2: #fff9f2;
  --text: #3e2a21;
  --muted: #9b7b62;
  --faint: #c9aa8b;
  --accent: #d4a373;
  --accent-2: #e6c394;
  --accent-on: #fff8f0;
  --brand: #b87c4f;
  --brand-2: #9b5e37;
  --line: rgba(184,124,79,0.12);
  --line-2: rgba(184,124,79,0.20);
  --line-dot: rgba(184,124,79,0.30);
  --hero-glow1: rgba(212,163,115,0.08);
  --hero-glow2: rgba(184,124,79,0.06);
  --term-bg: rgba(184,124,79,0.04);
  --soft: rgba(212,163,115,0.08);
  --ok: #8b6b42;
  --warn: #a85b16;
}

:root {
  --display: "Unbounded", "Manrope", system-ui, sans-serif;
  --body: "Manrope", system-ui, sans-serif;
  --mono: "JetBrains Mono", Consolas, monospace;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--body);
  color: var(--text);
  background: var(--bg);
  background-attachment: fixed;
  overflow-x: hidden;
}
a { color: inherit; text-decoration: none; }
h1, h2, h3, h4, p { margin: 0; }
button, input, select, textarea { font: inherit; }

.topbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 12px 32px;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
  min-height: 64px;
}

.brand { display: flex; align-items: center; gap: 12px; }
.brand-mark {
  width: 36px; height: 36px;
  border: 1px solid var(--line-2); border-radius: 8px;
  background: var(--soft);
  display: grid; place-items: center;
  position: relative;
  color: var(--accent);
}
.brand-mark::after{ content:''; position:absolute; right:4px; bottom:4px; width:5px; height:5px; border-radius:50%; background: var(--brand); }
.brand-mark svg { width: 20px; height: 20px; stroke: currentColor; stroke-width: 1.8; fill: none; stroke-linejoin: round; }
.brand-copy { display: grid; gap: 2px; }
.brand-name { font-family: var(--display); font-size: 14px; font-weight: 800; color: var(--text); letter-spacing: -0.02em; line-height: 1; }
.brand-tag { font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--faint); }
.topbar-nav { display: flex; gap: clamp(12px, 2vw, 22px); margin-left: 12px; flex-wrap: wrap; }
.top-link { font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); transition: color 0.18s; cursor: pointer; text-decoration: none; }
.top-link:hover, .top-link.active { color: var(--accent); }
.topbar-tools { margin-left: auto; display: flex; gap: 12px; align-items: center; }
.btn-tool {
  height: 36px;
  min-width: 42px;
  padding: 0 14px;
  border: 1px solid var(--line-2);
  border-radius: 10px;
  background: white;
  color: var(--muted);
  font: 700 11px/1 var(--mono);
  cursor: pointer;
  transition: all 0.2s;
}
.btn-tool:hover { border-color: var(--accent); color: var(--accent); }
select.btn-tool { width: 110px; }
.level-bubble {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line-2);
  border-radius: 50%;
  background: white;
  font-weight: 900;
  color: var(--accent);
}

.wrap { max-width: 1280px; margin: 0 auto; padding: 32px 32px 80px; }
.hero {
  position: relative;
  background: linear-gradient(135deg, var(--card-2), var(--bg-2));
  border-radius: 32px;
  padding: 48px 56px;
  margin-bottom: 32px;
  border: 1px solid var(--line);
  overflow: hidden;          /* clip image to rounded corners */
  min-height: 360px;
}
.hero-inner {
  position: relative; z-index: 2;
  display: grid; grid-template-columns: 1fr; gap: 0;
  align-items: center;
}
.hero-inner > div:first-child{
  position: relative;
  z-index: 3;                /* keep text on top of the absolute image */
  /* Fit only into the cream/empty area on the left of the chef image */
  width: clamp(260px, 40%, 460px);
  max-width: 460px;
  margin-left: 2cm;          /* shift the whole text block 2 cm to the right */
}
/* Tighter type to live inside the cream pocket */
.hero-title{ font-size: clamp(1.8rem, 3.6vw, 3rem); }
.hero-lead{ max-width: 100%; font-size: 10px; line-height: 1.5; color: var(--text); }
.hero-meta .meta-pill{ font-size: 11px; padding: 6px 14px; }
.hero-eyebrow { font-family: var(--mono); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 20px; margin-top: 2mm; }
.hero-title { font-family: var(--display); font-size: clamp(2.2rem, 5vw, 4.2rem); line-height: 0.96; letter-spacing: -0.04em; margin-bottom: 20px; color: var(--text); }
.hero-title em { font-style: normal; color: var(--accent); }
.hero-lead { color: var(--text); font-size: 17px; line-height: 1.6; margin-bottom: 24px; max-width: 520px; }
.hero-meta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
.hero-actions { display: flex; gap: 5mm; flex-wrap: wrap; }
.meta-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: rgba(212, 163, 115, 0.18);   /* light cream tint ~18% */
  border: 1px solid rgba(212, 163, 115, 0.22);
  border-radius: 40px;
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 700;
  color: var(--accent);
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 50px;
  padding: 0 26px;
  border-radius: 14px;
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  border: none;
  text-decoration: none;
  position: relative;
}
.btn::before{
  font-size: 14px;
  line-height: 1;
  opacity: 0.95;
}
.btn.primary{
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-2) 100%);
  color: white;
  box-shadow: 0 10px 22px rgba(184,124,79,0.28), inset 0 -2px 0 rgba(0,0,0,0.06);
}
.btn.primary::before{ content: ""; display: none; }
.btn.primary:hover{
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 14px 26px rgba(184,124,79,0.34), inset 0 -2px 0 rgba(0,0,0,0.06);
}
.btn.primary:active{ transform: translateY(-1px) scale(0.99); }
.btn.ghost{
  background: rgba(255,255,255,0.55);
  border: 1.5px solid var(--accent);
  color: var(--accent);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}
.btn.ghost::before{ content: ""; display: none; color: var(--accent); }
.btn.ghost:hover{
  background: var(--accent);
  color: white;
  transform: translateY(-3px);
  box-shadow: 0 10px 20px rgba(184,124,79,0.22);
}
.btn.ghost:hover::before{ color: white; }
.btn.ghost:active{ transform: translateY(-1px); }
/* Hero image fills the entire hero block вЂ” chef on the right, cream space on the left under the text */
.hero-visual {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
  pointer-events: none;
}
.hero-visual img{
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: right center;   /* keep chef on the right, cream area aligned to left */
  display: block;
}
.hero-visual p{ display: none; }    /* hide leftover label if any */
/* Soft cream overlay on the left so text reads on top of the image */
.hero::after{
  content: "";
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(to right,
    rgba(255, 250, 245, 0.55) 0%,
    rgba(255, 250, 245, 0.20) 32%,
    rgba(255, 250, 245, 0.0) 50%);
  pointer-events: none;
}
@media (max-width: 820px){
  .hero{ min-height: 420px; }
  .hero-inner > div:first-child{ max-width: 100%; }
  .hero::after{
    background: linear-gradient(to bottom,
      rgba(255, 250, 245, 0.82) 0%,
      rgba(255, 250, 245, 0.35) 50%,
      rgba(255, 250, 245, 0.0) 75%);
  }
}

/* Inline drop-feedback toast & rubric flash */
.drop-toast{
  position: fixed; right: 20px; bottom: 20px;
  background: var(--card); color: var(--brand-2);
  border: 1px solid var(--line-2);
  border-radius: 12px;
  padding: 10px 18px;
  font-family: var(--mono); font-size: 12px; font-weight: 700;
  box-shadow: 0 8px 22px rgba(184,124,79,0.18);
  z-index: 200;
  animation: dropToastIn .2s ease;
}
.drop-toast.err{ background: #fbe4d4; color: #a85b16; border-color: #efb98a; }
.drop-toast.ok { background: #e6f3da; color: #386428; border-color: #b9d99a; }
@keyframes dropToastIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
.dropzone.flash-err{ animation: shake .35s ease; border-color: #d4793c !important; }
@keyframes shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-4px)} 75%{transform:translateX(4px)} }
#totalScoreRubricDisplay.flash{ animation: scoreFlash .9s ease; }
@keyframes scoreFlash { 0% { background: #fff5d8; transform: scale(1); } 50% { background: #ffeab8; transform: scale(1.05); } 100% { background: transparent; transform: scale(1); } }

/* Dish photo strip вЂ” sits under the Speaking Mission tracker */
.dish-strip{
  width: 100%;
  margin: 0 0 24px;
  border-radius: 18px;
  overflow: hidden;
  background: var(--card-2);
  border: 1px solid var(--line);
  /* No fixed aspect вЂ” let the strip keep its natural proportions so all 7 dishes fit */
  max-height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dish-strip img{
  width: 100%;
  height: auto;
  max-height: 200px;
  object-fit: contain;             /* show entire strip; no side cropping */
  object-position: center;
  display: block;
}

.step-tracker {
  background: white;
  border-radius: 60px;
  padding: 12px 24px;
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 20px;
  border: 1px solid var(--line);
}
.step-count { font-family: var(--mono); font-size: 11px; font-weight: 800; color: var(--accent); }
.step-track { flex: 1; height: 6px; background: #f0e3d6; border-radius: 6px; overflow: hidden; }
.step-fill { height: 100%; width: 0%; background: var(--accent); border-radius: 6px; transition: width 0.3s; }
.step-name { font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--muted); }

.round-card {
  background: white;
  border-radius: 24px;
  margin-bottom: 20px;
  overflow: hidden;
  border: 1px solid var(--line);
}
.round-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 24px;
  background: var(--card-2);
  border-bottom: 1px solid var(--line);
}
.round-title { font-family: var(--display); font-size: 18px; font-weight: 800; color: var(--text); }
.round-badge { font-family: var(--mono); font-size: 11px; font-weight: 700; padding: 4px 12px; border-radius: 40px; background: #f0e3d6; color: var(--muted); }
.round-score { font-family: var(--mono); font-size: 12px; font-weight: 700; color: var(--accent); }
.round-body { padding: 24px; display: block !important; }

/* ===== RESTAURANT SPECIFIC STYLES ===== */
.ingredient-pool {
  background: var(--bg-2);
  border-radius: 48px;
  padding: 18px 20px;
  margin-bottom: 32px;
  border: 1px dashed var(--line-2);
  overflow-x: auto;
  white-space: nowrap;
  display: flex;
  gap: 12px;
}
.drag-item {
  background: white;
  border-radius: 60px;
  padding: 10px 22px;
  font-weight: 600;
  cursor: grab;
  border: 1px solid #f0dec8;
  display: inline-flex;
  user-select: none;
}
.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin: 20px 0;
}
.menu-category {
  background: var(--card-2);
  border-radius: 24px;
  padding: 16px 14px 14px;
  border: 1px solid var(--line);
  display: flex; flex-direction: column;
  position: relative;
  z-index: 1;
}
.cat-thumb{
  width: 100%;
  aspect-ratio: 1 / 1;
  margin-bottom: 10px;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.cat-thumb img{
  width: 100%; height: 100%;
  object-fit: contain;
  display: block;
}
.menu-category h3 {
  font-family: var(--display); font-size: 0.95rem; letter-spacing: 0.08em;
  margin: 0 0 12px;
  background: #edd6bb;
  display: inline-flex; align-items: center; gap: 8px;
  padding: 7px 14px;
  border-radius: 40px;
  font-weight: 800;
  color: #7a563a;
  align-self: flex-start;
}
.menu-category h3 .h-count{
  font-family: var(--mono); font-size: 11px; font-weight: 700;
  background: white;
  border: 1px solid var(--line-2);
  border-radius: 30px;
  padding: 2px 10px;
  color: var(--brand-2);
}
.dropzone {
  flex: 1;
  min-height: 110px;
  background: #fefaf5;
  border: 1.5px dashed var(--line-2);
  border-radius: 18px;
  padding: 14px 12px;
  font-family: var(--mono);
  font-size: 12px; font-weight: 600;
  color: var(--muted);
  letter-spacing: 0.04em;
  text-align: center;
  display: flex; flex-direction: column;
  align-items: stretch; justify-content: center;
  gap: 8px;
}
.dropzone:empty::before{ content: "Drag dishes here"; display: block; }
.dropzone:empty::after{ content: "(multiple allowed)"; display: block; font-size: 10px; opacity: 0.7; margin-top: 2px; }
.dropzone.drag-over{ background: var(--soft); border-color: var(--accent); border-style: solid; }

/* Chef tip вЂ” wide image card spanning 3 columns of the bottom row, sits next to dessert */
.chef-tip{
  grid-column: 2 / -1;          /* cols 2-4 = 3 cells wide */
  align-self: stretch;
  position: relative;
  background: #ffffff;
  border: 1px solid var(--line);
  border-radius: 20px;
  overflow: visible;            /* allow image to bleed below the frame */
  z-index: 0;
  min-height: 260px;
}
.chef-tip-img{
  position: absolute;
  top: 5mm;                     /* push image down 5 mm вЂ” its bottom escapes the frame */
  left: 0; right: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center center;
  display: block;
  pointer-events: none;
}
.menu-workshop, .menu-grid, .round-body{ overflow: visible; }
@media (max-width: 920px){
  .menu-grid{ grid-template-columns: repeat(2, 1fr); }
  .chef-tip{ grid-column: 1 / -1; min-height: 220px; }
}
@media (max-width: 540px){
  .menu-grid{ grid-template-columns: 1fr; }
}
.menu-item {
  background: white;
  margin: 8px 0;
  padding: 10px 14px;
  border-radius: 50px;
  border-left: 5px solid var(--accent);
  display: flex;
  justify-content: space-between;
}
.remove-btn {
  background: none;
  border: none;
  cursor: pointer;
  color: #b87c4f;
  font-size: 1.2rem;
}
.sentence-starters {
  background: #fef6ed;
  border-radius: 36px;
  padding: 20px;
  margin: 20px 0;
  border-left: 6px solid var(--accent);
}
.step-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin: 20px 0;
}
.step {
  background: var(--bg-2);
  border-radius: 28px;
  padding: 12px;
  flex: 1;
  text-align: center;
}
.reset-menu-btn, .calc-btn {
  background: var(--accent);
  border: none;
  padding: 10px 24px;
  border-radius: 60px;
  color: white;
  font-weight: bold;
  cursor: pointer;
  margin-top: 12px;
}
textarea { width: 100%; border-radius: 28px; border: 1px solid var(--line-2); padding: 12px; }
.footnote { text-align: center; margin-top: 40px; font-size: 0.7rem; color: var(--faint); }
table { width: 100%; border-collapse: collapse; margin: 18px 0; }
th, td { padding: 12px 8px; border-bottom: 1px solid var(--line); text-align: left; }
th { background: #fdf3e8; }
.total-score {
  font-weight: 800;
  background: #edd6bb;
  padding: 6px 20px;
  border-radius: 60px;
  display: inline-block;
}

/* ===== SPEAKING MISSION UPGRADE В· CONTENT ONLY ===== */
.mission-card {
  background: linear-gradient(135deg, #fff7ef, #fdf0e2);
  border: 1px solid var(--line-2);
  border-left: 6px solid var(--accent);
  border-radius: 32px;
  padding: 22px;
  margin: 18px 0 22px;
}
.mission-card h3 { margin-bottom: 8px; font-family: var(--display); font-size: 1.1rem; }
.mission-brief { margin: 0 0 24px; }
.mission-path {
  display: grid;
  grid-template-columns: repeat(5, minmax(120px, 1fr));
  gap: 10px;
  margin-top: 16px;
}
.mission-step, .language-pill {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 12px 14px;
  font-weight: 800;
  color: var(--brand-2);
}
.mission-step span {
  display: block;
  font-family: var(--mono);
  font-size: 10px;
  color: var(--muted);
  margin-bottom: 4px;
}
.concept-grid, .language-grid, .summary-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(140px, 1fr));
  gap: 12px;
  margin-top: 14px;
}
.concept-field {
  display: grid;
  gap: 6px;
}
.concept-field label {
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 800;
  color: var(--muted);
  text-transform: uppercase;
}
.concept-field input, .concept-field select {
  min-height: 42px;
  border-radius: 16px;
  border: 1px solid var(--line-2);
  background: #fff;
  padding: 8px 12px;
  color: var(--text);
}
.balance-tip, .menu-summary, .useful-language, .speaking-frame, .preflight-check {
  background: #fffaf2;
  border: 1px solid var(--line);
  border-radius: 28px;
  padding: 18px 20px;
  margin: 18px 0;
}
.balance-tip-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(160px, 1fr));
  gap: 12px;
  margin-top: 12px;
}
.balance-tip-grid div, .summary-item {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 12px;
}
.summary-item strong {
  display: block;
  color: var(--brand-2);
  margin-bottom: 4px;
}
.menu-ready {
  margin-top: 12px;
  font-weight: 800;
  color: var(--warn);
}
.menu-ready.is-ready { color: var(--ok); }
.language-grid { grid-template-columns: repeat(3, minmax(180px, 1fr)); }
.language-pill { line-height: 1.7; font-weight: 700; }
.speaking-frame ol, .preflight-check ul {
  margin: 10px 0 0 18px;
  padding: 0;
  line-height: 1.75;
}
.speech-chip-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
.speech-chip {
  border: 1px solid var(--line-2);
  background: white;
  color: var(--text);
  border-radius: 999px;
  padding: 10px 15px;
  cursor: pointer;
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 800;
  transition: all .2s;
}
.speech-chip:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--brand); background: var(--accent-on); }
.cuisine-pills { display: flex; flex-wrap: wrap; gap: 10px; margin: 14px 0; }
.cuisine-pill {
  border: 1px solid var(--line-2);
  background: white;
  border-radius: 999px;
  padding: 8px 14px;
  cursor: pointer;
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 800;
  color: var(--muted);
}
.cuisine-pill.is-active, .cuisine-pill:hover { background: var(--accent); color: white; border-color: var(--accent); }
.example-highlight {
  background: #fff8ef;
  padding: 18px;
  border-radius: 32px;
  margin-top: 8px;
  line-height: 1.65;
  border: 1px solid var(--line);
}
.example-highlight mark { background: #f4dfc6; color: var(--brand-2); border-radius: 999px; padding: 2px 8px; }
.speech-draft { width: 100%; min-height: 120px; margin-top: 14px; background: white; }
.performance-panel { display: grid; grid-template-columns: 1.1fr .9fr; gap: 16px; margin-top: 20px; }
