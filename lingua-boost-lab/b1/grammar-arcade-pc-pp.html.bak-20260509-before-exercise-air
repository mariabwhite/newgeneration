<script>
// ---------- SPEECH ----------
function speakText(text) { if(window.speechSynthesis){ speechSynthesis.cancel(); let u=new SpeechSynthesisUtterance(text); u.lang='en-US'; u.rate=0.9; speechSynthesis.speak(u); } }

// ---------- PROGRESS & SCORE (8 activities) ----------
let activityCompleted = new Array(8).fill(false);
let globalScore = 0, combo = 1, comboTimeout = null;
function updateProgress() {
  let c = activityCompleted.filter(v=>v===true).length;
  document.getElementById('progressFill').style.width = `${(c/8)*100}%`;
  document.getElementById('progressText').innerHTML = `${c} / 8 activities`;
  if(c===8) launchConfetti();
}
function completeActivity(idx) {
  if(activityCompleted[idx]) return;
  activityCompleted[idx] = true;
  updateProgress();
  let card = document.getElementById(`activityCard${idx}`);
  if(card) { card.querySelector('.round-badge').textContent = 'Complete'; card.querySelector('.round-score').textContent = 'Done'; }
}
function addScore(amount, x=null, y=null) {
  globalScore += amount * combo;
  document.getElementById('globalScore').innerText = globalScore;
  if(comboTimeout) clearTimeout(comboTimeout);
  combo = Math.min(combo + 1, 8);
  document.getElementById('comboMultiplier').innerText = combo;
  comboTimeout = setTimeout(() => { combo = 1; document.getElementById('comboMultiplier').innerText = combo; }, 4000);
  if(x && y) createParticleBurst(x, y, 12);
  else createParticleBurst(window.innerWidth/2, window.innerHeight/2, 10);
}
function launchConfetti() {
  let canvas = document.createElement('canvas'); canvas.style.position='fixed'; canvas.style.inset=0; canvas.style.pointerEvents='none'; canvas.style.zIndex=1000;
  document.body.appendChild(canvas); let ctx=canvas.getContext('2d'); canvas.width=innerWidth; canvas.height=innerHeight;
  let parts=Array.from({length:180},()=>({x:Math.random()*canvas.width,y:Math.random()*canvas.height,vy:Math.random()*3+2,size:Math.random()*6+4,color:`hsl(${Math.random()*360},70%,60%)`}));
  function anim(){ ctx.clearRect(0,0,canvas.width,canvas.height); let alive=false; parts.forEach(p=>{ p.y+=p.vy; if(p.y<canvas.height) alive=true; ctx.fillStyle=p.color; ctx.fillRect(p.x,p.y,p.size,p.size); }); if(alive) requestAnimationFrame(anim); else canvas.remove(); } anim();
}

// ---------- PARTICLE ENGINE ----------
const particleCanvas = document.getElementById('particle-canvas');
let pCtx = particleCanvas.getContext('2d'), particles = [], particleAnim = null;
function resizeParticle() { particleCanvas.width = window.innerWidth; particleCanvas.height = window.innerHeight; }
window.addEventListener('resize', resizeParticle); resizeParticle();
function createParticleBurst(x, y, count=15) {
  for(let i=0;i<count;i++){ let angle=Math.random()*Math.PI*2, speed=Math.random()*3+2; particles.push({ x:x||innerWidth/2, y:y||innerHeight/2, vx:Math.cos(angle)*speed, vy:Math.sin(angle)*speed, life:1, size:Math.random()*6+3, color:`hsl(${Math.random()*40+40},80%,60%)` }); }
  if(!particleAnim) startParticleLoop();
}
function startParticleLoop() {
  if(particleAnim) cancelAnimationFrame(particleAnim);
  function update(){
    pCtx.clearRect(0,0,particleCanvas.width,particleCanvas.height);
    let alive=false;
    for(let i=0;i<particles.length;i++){ let p=particles[i]; p.x+=p.vx; p.y+=p.vy; p.vy+=0.15; p.life-=0.02; if(p.life<=0){ particles.splice(i,1); i--; continue; } alive=true; pCtx.globalAlpha=p.life*0.8; pCtx.fillStyle=p.color; pCtx.beginPath(); pCtx.arc(p.x,p.y,p.size,0,Math.PI*2); pCtx.fill(); }
    if(alive) particleAnim=requestAnimationFrame(update); else particleAnim=null;
  }
  update();
}

