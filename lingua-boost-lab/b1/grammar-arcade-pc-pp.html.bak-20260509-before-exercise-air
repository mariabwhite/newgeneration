<style>
:root {
  --bg: #f4f9fc;
  --bg-2: #eef3f8;
  --card: #ffffff;
  --card-2: #f9fdfe;
  --text: #1a2c3e;
  --muted: #4a627a;
  --faint: #7c95ae;
  --accent: #2c7da0;
  --accent-2: #61a5c2;
  --accent-on: #ffffff;
  --brand: #2c7da0;
  --brand-2: #1f5e7a;
  --line: rgba(44,125,160,0.12);
  --line-2: rgba(44,125,160,0.20);
  --ok: #2e8b57;
  --warn: #cd5c5c;
  --radius: 1.2rem;
  --shadow: 0 8px 20px rgba(0,0,0,0.05);
  --mono: "JetBrains Mono", Consolas, monospace;
  --display: "Unbounded", "Manrope", sans-serif;
  --body: "Manrope", system-ui, sans-serif;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: var(--bg);
  font-family: var(--body);
  color: var(--text);
  min-height: 100vh;
  line-height: 1.5;
}
a { text-decoration: none; color: inherit; }
/* ── TOPBAR ── unified with Easter / China / Space ── */
.topbar{
  position:sticky; top:0; z-index:100;
  display:flex; align-items:center; gap:16px;
  padding:10px clamp(16px,3vw,28px);
  background:color-mix(in srgb,var(--bg) 88%,transparent);
  border-bottom:1px solid var(--line);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  min-height:56px;
}
.brand{display:flex;align-items:center;gap:12px;}
.brand-mark{
  width:36px; height:36px; border:1px solid var(--line-2); border-radius:8px;
  display:grid; place-items:center; background:var(--card-2); position:relative;
  font-family:var(--display); font-size:20px; font-weight:900; color:var(--accent);
}
.brand-mark::after{content:'';position:absolute;right:4px;bottom:4px;width:5px;height:5px;border-radius:50%;background:var(--accent);}
.brand-mark.book-mark{font-size:0;}
.brand-mark.book-mark::before{
  content:"";width:23px;height:18px;border:2px solid var(--accent);border-radius:5px 5px 4px 4px;
  background:
    linear-gradient(90deg,transparent 0 47%,var(--accent) 47% 53%,transparent 53% 100%),
    linear-gradient(180deg,rgba(44,125,160,.16),rgba(255,255,255,.92));
  box-shadow:inset 7px 0 0 rgba(44,125,160,.08),inset -7px 0 0 rgba(44,125,160,.08);
}
.brand-mark.book-mark::after{
  content:"";position:absolute;right:8px;bottom:8px;width:8px;height:2px;border-radius:2px;background:var(--accent);
  box-shadow:-11px 0 0 rgba(44,125,160,.5);
}
.brand-copy{display:grid;gap:2px;}
.brand-name{font-family:var(--display);font-size:14px;font-weight:800;letter-spacing:-.02em;line-height:1;color:var(--text);}
.brand-tag{font-family:var(--mono);font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--faint);margin:0;}
.topbar-nav{display:flex;gap:clamp(12px,2vw,22px);margin-left:12px;flex-wrap:wrap;}
.top-link{font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);transition:color .18s;cursor:pointer;}
.top-link:hover,.top-link.active{color:var(--accent);}
.topbar-tools{margin-left:auto;display:flex;gap:8px;align-items:center;}
.btn-tool{
  height:32px; min-width:38px; padding:0 10px; border:1px solid var(--line-2);
  border-radius:8px; background:var(--card); color:var(--muted);
  font:800 11px/1 var(--mono); letter-spacing:.08em; cursor:pointer;
  display:inline-grid; place-items:center; transition:all .16s;
}
.btn-tool:hover{border-color:var(--accent);color:var(--accent);}
.btn-tool.active{background:var(--accent);color:#fff;border-color:var(--accent);}
.level-bubble{width:36px;height:36px;display:grid;place-items:center;border:1px solid var(--line-2);border-radius:50%;background:var(--card-2);font:900 12px/1 var(--display);color:var(--accent);}
.wrap { max-width: 1280px; margin: 0 auto; padding: 32px 32px 80px; }
.hero { background: linear-gradient(135deg, #eef5fa, #ffffff); border-radius: 32px; padding: 48px 56px; margin-bottom: 32px; border: 1px solid var(--line); }
.hero-inner { display: grid; grid-template-columns: 1.3fr 0.9fr; gap: 48px; align-items: center; }
.hero-eyebrow { font-family: var(--mono); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 20px; }
.hero-eyebrow::before { content: ""; }
.hero-title { font-family: var(--display); font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1; letter-spacing: -0.03em; margin-bottom: 20px; }
.hero-title em { font-style: normal; color: var(--accent); }
.hero-lead { color: var(--muted); font-size: 17px; line-height: 1.6; margin-bottom: 24px; }
.hero-meta { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
.meta-pill { padding: 6px 14px; background: rgba(44,125,160,0.08); border-radius: 40px; font-family: var(--mono); font-size: 10px; font-weight: 700; color: var(--accent); }
.btn { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 24px; border-radius: 12px; font-family: var(--mono); font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; border: none; }
.btn.primary { background: var(--accent); color: white; box-shadow: 0 4px 12px rgba(44,125,160,0.3); }
.btn.primary:hover { transform: translateY(-2px); background: var(--brand-2); }
.step-tracker { background: white; border-radius: 60px; padding: 12px 24px; margin-bottom: 24px; display: flex; align-items: center; gap: 20px; border: 1px solid var(--line); flex-wrap: wrap; }
.step-count { font-family: var(--mono); font-size: 11px; font-weight: 800; color: var(--accent); }
.step-track { flex: 1; height: 6px; background: #e0eef4; border-radius: 6px; overflow: hidden; }
.step-fill { height: 100%; width: 0%; background: var(--accent); border-radius: 6px; transition: width 0.3s; }
.step-name { font-family: var(--mono); font-size: 11px; font-weight: 700; color: var(--muted); }
.round-card { background: white; border-radius: 28px; margin-bottom: 24px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow); }
.round-header { display: flex; justify-content: space-between; align-items: center; padding: 18px 24px; background: #f9fdfe; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
.round-title { font-family: var(--display); font-size: 18px; font-weight: 800; }
.round-badge { font-family: var(--mono); font-size: 11px; font-weight: 700; padding: 4px 12px; border-radius: 40px; background: #eef3f8; color: var(--muted); }
.round-score { font-family: var(--mono); font-size: 14px; font-weight: 700; color: var(--accent); }
.round-body { padding: 24px; display: block !important; }
/* Flip cards */
.flip-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
.flip-card { background: transparent; perspective: 1000px; cursor: pointer; min-height: 200px; }
.flip-card-inner { position: relative; width: 100%; height: 100%; transition: transform 0.5s; transform-style: preserve-3d; border-radius: 20px; }
.flip-card.flipped .flip-card-inner { transform: rotateY(180deg); }
.flip-front, .flip-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; border-radius: 20px; padding: 20px; border: 1px solid var(--line); background: var(--card-2); }
.flip-back { transform: rotateY(180deg); background: var(--accent); color: white; display: flex; flex-direction: column; justify-content: center; }
.flip-front strong { color: var(--accent); }
.speak-rule { background: none; border: none; font-size: 20px; cursor: pointer; margin-top: 10px; }
/* Bubble pop */
.bubble-canvas { background: radial-gradient(circle at 30% 20%, #6bb0cc, #2c7da0); border-radius: 28px; width: 100%; height: 300px; display: block; margin: 0 auto; cursor: crosshair; touch-action: none; border: 2px solid var(--line); }
.bubble-stats { display: flex; justify-content: space-between; margin: 12px 0; font-weight: 600; }
.bubble-reset { background: var(--accent); border: none; border-radius: 40px; padding: 6px 16px; color: white; cursor: pointer; }
/* Sentence Trail */
.trail-container { background: #eef3f8; border-radius: 24px; padding: 16px; }
.trail-question { background: white; border-radius: 60px; padding: 12px; text-align: center; margin-bottom: 16px; font-weight: 700; border: 1px solid var(--line); }
.trail-words { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 20px; }
.word-chip { background: var(--accent); color: white; padding: 8px 20px; border-radius: 60px; font-weight: 800; cursor: pointer; transition: 0.1s; }
.word-chip:active { transform: scale(0.96); }
.trail-sentence { background: white; border-radius: 28px; padding: 16px; min-height: 70px; display: flex; flex-wrap: wrap; gap: 8px; border: 2px dashed var(--accent); margin-bottom: 16px; }
.trail-word { background: var(--brand-2); padding: 6px 16px; border-radius: 40px; cursor: pointer; color: white; }
.check-trail-btn { background: var(--accent); border: none; padding: 10px; border-radius: 40px; font-weight: 800; color: white; width: 100%; cursor: pointer; }
.trail-feedback { margin-top: 10px; text-align: center; font-weight: 600; }
/* MCQ, gap, match, TF, final challenge (same as original) */
.mcq-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin: 12px 0; }
.mcq-btn { background: #f0f6fa; border: 1px solid var(--line); padding: 10px; border-radius: 60px; cursor: pointer; text-align: center; font-weight: 600; }
.mcq-btn.selected { background: var(--accent); color: white; }
.mcq-btn.correct { background: var(--ok); color: white; }
.mcq-btn.wrong { background: var(--warn); color: white; text-decoration: line-through; }
.gap-input { border: 2px solid var(--line); border-radius: 40px; padding: 8px 16px; width: 160px; text-align: center; }
.match-pairs { display: flex; flex-direction: column; gap: 12px; }
.match-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; }
.match-left, .match-right { flex: 1; background: #f0f6fa; border-radius: 40px; padding: 10px; text-align: center; font-weight: 600; border: 1px solid var(--line); cursor: pointer; }
.match-left.selected, .match-right.selected { background: var(--accent); color: white; }
.match-left.matched, .match-right.matched { background: var(--ok); color: white; text-decoration: line-through; cursor: default; opacity: 0.8; }
.tf-item { background: #f9fdfe; border-radius: 20px; padding: 16px; margin-bottom: 12px; }
.tf-options { display: flex; gap: 20px; margin-top: 12px; }
.tf-btn { padding: 8px 24px; border-radius: 40px; border: 1px solid var(--line); background: white; cursor: pointer; font-weight: 600; }
.tf-btn.selected-true { background: var(--ok); color: white; }
.tf-btn.selected-false { background: var(--warn); color: white; }
.challenge-question { background: #f9fdfe; border-radius: 16px; padding: 16px; margin-bottom: 16px; border-left: 5px solid var(--accent); }
.final-options { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 10px; }
#particle-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 999; }
.hud { position: fixed; bottom: 20px; right: 20px; background: rgba(0,0,0,0.7); backdrop-filter: blur(8px); border-radius: 60px; padding: 8px 20px; display: flex; gap: 16px; color: white; font-weight: 800; z-index: 1000; }
.hud span { color: var(--accent); }
@media (max-width: 720px) { .hero-inner { grid-template-columns: 1fr; } .topbar-nav { display: none; } .wrap { padding: 20px; } .hud { bottom: 10px; right: 10px; padding: 4px 12px; font-size: 0.8rem; } }

/* ── HERO BANNER (image) + RULES TABLE (image) ─────────────────────────── */
.hero-banner{padding:0;background:transparent;border:none;margin-bottom:20px;}
.hero-banner-link{display:block;border-radius:24px;overflow:hidden;
  border:1px solid var(--line);background:var(--card);
  box-shadow:0 8px 28px rgba(44,125,160,.08);
