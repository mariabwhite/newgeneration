function initAllActivities(){
  // ----- 0) Flip cards (same as original)
  let rules = [{title:"Present Continuous",desc:"am/is/are + V-ing. Action happening NOW / around now / planned future. Example: I am reading a book right now."},{title:"Present Perfect",desc:"have/has + past participle. Experience, result, unfinished time. Example: I have read this book."},{title:"Signal words (PC)",desc:"now, at the moment, today, this week, Look!, Listen!"},{title:"Signal words (PP)",desc:"ever, never, just, already, yet, recently, this month, so far"}];
