  }
  renderGap();
  document.getElementById('gapCheckBtn')?.addEventListener('click', checkGap);

  // ----- 5) MATCH TIME EXPRESSIONS
  const timeExprs = [
    { expr: "right now",     tense: "PC" },
    { expr: "ever / never",  tense: "PP" },
    { expr: "this week",     tense: "PC" },
    { expr: "since 2020",    tense: "PP" },
    { expr: "at the moment", tense: "PC" },
    { expr: "already / yet", tense: "PP" }
  ];
  let matchedExprs = new Set();
  function renderMatch(){
    const area = document.getElementById('matchArea'); if(!area) return;
    area.innerHTML = `
      <div class="match-grid">
        <div class="match-col">
          <h4>Time expressions</h4>
          ${timeExprs.map((t,i)=>`<div class="match-card expr" data-i="${i}" data-tense="${t.tense}">${t.expr}</div>`).join('')}
        </div>
        <div class="match-col">
          <h4>Tenses</h4>
          <div class="match-card target" data-target="PC">Present Continuous</div>
          <div class="match-card target" data-target="PP">Present Perfect</div>
        </div>
      </div>`;
    let selected = null;
    area.querySelectorAll('.expr').forEach(card => {
      card.addEventListener('click', ()=>{
        if(card.classList.contains('matched')) return;
        area.querySelectorAll('.expr').forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        selected = card;
      });
    });
    area.querySelectorAll('.target').forEach(t => {
      t.addEventListener('click', ()=>{
        if(!selected) return;
        if(selected.dataset.tense === t.dataset.target){
          selected.classList.remove('selected');
          selected.classList.add('matched');
          matchedExprs.add(selected.dataset.i);
          addScore(10);
          const st = document.getElementById('matchStatus');
          if(st){ st.innerHTML = `Matched ${matchedExprs.size}/${timeExprs.length}`; st.style.color='var(--ok)'; }
          if(matchedExprs.size === timeExprs.length && !activityCompleted[5]){ completeActivity(5); addScore(25); }
        } else {
          selected.classList.remove('selected');
          const st = document.getElementById('matchStatus');
          if(st){ st.innerHTML = `Not a match — try again.`; st.style.color='var(--warn)'; }
        }
        selected = null;
      });
    });
  }
  renderMatch();

  // ----- 6) TRUE OR FALSE
  const tfQ = [
    { text: "Present Continuous uses 'have/has + V3'.",                          ok: false },
    { text: "Present Perfect can describe an action with results in the present.", ok: true },
    { text: "'Now / at the moment' are signal words for Present Continuous.",     ok: true },
    { text: "'Ever / never / already / yet' are typical of Present Continuous.",  ok: false },
    { text: "Present Continuous uses 'am/is/are + V-ing'.",                       ok: true }
  ];
  function renderTF(){
    const area = document.getElementById('tfArea'); if(!area) return;
    area.innerHTML = tfQ.map((q,i)=>
      `<div class="tf-item"><span>${i+1}. ${q.text}</span>
        <span class="tf-buttons">
          <button class="tf-btn" data-i="${i}" data-v="true">TRUE</button>
          <button class="tf-btn" data-i="${i}" data-v="false">FALSE</button>
        </span></div>`
    ).join('');
    area.querySelectorAll('.tf-btn').forEach(btn => {
      btn.addEventListener('click', ()=>{
        const sib = btn.parentElement.querySelectorAll('.tf-btn');
        sib.forEach(b => b.classList.remove('chosen'));
        btn.classList.add('chosen');
      });
    });
  }
  function checkTF(){
    let correct = 0;
    tfQ.forEach((q,i)=>{
      const chosen = document.querySelector(`.tf-btn.chosen[data-i="${i}"]`);
      if(!chosen) return;
      const ans = chosen.dataset.v === 'true';
      if(ans === q.ok){ correct++; chosen.style.background='var(--ok)'; chosen.style.color='#fff'; }
      else { chosen.style.background='var(--warn)'; chosen.style.color='#fff'; }
    });
    const fb = document.getElementById('tfFeedback');
    if(fb){
      fb.innerHTML = `${correct}/${tfQ.length} correct → +${correct*12}`;
      fb.style.color = correct===tfQ.length ? 'var(--ok)' : 'var(--muted)';
    }
    addScore(correct*12);
    if(correct===tfQ.length && !activityCompleted[6]) completeActivity(6);
  }
  renderTF();
  document.getElementById('tfCheckBtn')?.addEventListener('click', checkTF);

  // ----- 7) FINAL CHALLENGE — mixed
  const finalQ = [
    { text: "He ______ (write) emails since 9am.",         answer: "has been writing", alt: ["has written"] },
    { text: "Listen! Someone ______ (knock) at the door.", answer: "is knocking" },
    { text: "I ______ (never / try) sushi before today.",   answer: "have never tried" },
    { text: "We ______ (paint) the kitchen this weekend.",  answer: "are painting", alt: ["paint"] },
    { text: "She ______ (just / arrive) at the airport.",    answer: "has just arrived" }
  ];
  function renderFinal(){
    const area = document.getElementById('finalArea'); if(!area) return;
    area.innerHTML = finalQ.map((q,i)=>
      `<div class="final-item"><div>${i+1}. ${q.text}</div>
        <input type="text" id="final${i}" class="gap-input" placeholder="full verb form" autocomplete="off"></div>`
    ).join('');
  }
  function checkFinal(){
    let correct = 0;
    finalQ.forEach((q,i)=>{
      const inp = document.getElementById('final'+i);
      const v = (inp?.value || '').trim().toLowerCase().replace(/\s+/g,' ');
      const okList = [q.answer, ...(q.alt||[])].map(s => s.toLowerCase());
      if(okList.includes(v)){ correct++; inp.style.borderColor = 'var(--ok)'; }
      else if(v){ inp.style.borderColor = 'var(--warn)'; }
    });
    const fb = document.getElementById('finalFeedback');
    if(fb){
      fb.innerHTML = `${correct}/${finalQ.length} correct → +${correct*20}`;
      fb.style.color = correct===finalQ.length ? 'var(--ok)' : 'var(--muted)';
    }
    addScore(correct*20);
    if(correct===finalQ.length && !activityCompleted[7]){
      completeActivity(7);
      const fb2 = document.getElementById('finalFeedback');
      if(fb2) fb2.innerHTML += ' · MISSION COMPLETE!';
    }
  }
  renderFinal();
  document.getElementById('finalCheckBtn')?.addEventListener('click', checkFinal);
}

// ---------- BOOTSTRAP ----------
document.addEventListener('DOMContentLoaded', renderActivities);
</script>
