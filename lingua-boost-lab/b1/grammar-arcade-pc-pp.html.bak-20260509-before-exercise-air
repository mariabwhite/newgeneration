          if(!activityCompleted[0] && window.flippedRules.size === rules.length){
            completeActivity(0);
          }
        }
      });
      grid.appendChild(f);
    });
  }
  
  // ----- 1) BUBBLE POP — animated, no alerts ------------------------
  (function setupBubblePop(){
    const bubbleCanvas = document.getElementById('bubbleCanvas');
    if(!bubbleCanvas) return;
    const ctx = bubbleCanvas.getContext('2d');
    const fbEl = document.getElementById('bubbleFeedback');
    let bubbles = [], pops = [], poppedCount = 0, roundNo = 1;
    const BUBBLE_TARGET = 8;
    const WORDS = [
      {text:"am checking",tense:"PC"},{text:"is working",tense:"PC"},{text:"are building",tense:"PC"},
      {text:"have finished",tense:"PP"},{text:"has visited",tense:"PP"},{text:"have never seen",tense:"PP"},
      {text:"is improving",tense:"PC"},{text:"have worn",tense:"PP"},{text:"are meeting",tense:"PC"},
      {text:"has just arrived",tense:"PP"},{text:"is raining",tense:"PC"},{text:"has lost",tense:"PP"},
      {text:"are studying",tense:"PC"},{text:"have already eaten",tense:"PP"}
    ];
    window.currentTarget = 'PC';
    function setTarget(t){
      window.currentTarget = t;
      const el = document.getElementById('bubbleTargetDisplay');
      if(el) el.innerText = t==='PC' ? 'Present Continuous' : 'Present Perfect';
    }
    function flash(msg, ok){
      if(!fbEl) return;
      fbEl.innerText = msg;
      fbEl.style.color = ok ? 'var(--ok)' : 'var(--warn)';
      clearTimeout(fbEl._t);
      fbEl._t = setTimeout(()=>{ fbEl.innerText=''; }, 1400);
    }
    function resize(){
      const w = Math.max(640, bubbleCanvas.parentElement.clientWidth - 8);
      bubbleCanvas.width = w;
      bubbleCanvas.height = 440;
      // re-clamp existing bubbles inside the new canvas
      for(const b of bubbles){
        b.x = Math.max(b.r+4, Math.min(w - b.r - 4, b.x));
        b.y = Math.max(b.r+4, Math.min(bubbleCanvas.height - b.r - 4, b.y));
      }
    }
    function findBubbleSpot(r){
      const pad = r + 10;
      for(let attempt=0; attempt<70; attempt++){
        const x = pad + Math.random()*(bubbleCanvas.width - pad*2);
        const y = pad + Math.random()*(bubbleCanvas.height - pad*2);
        const clear = bubbles.every(b => b.popped || Math.hypot(x-b.x, y-b.y) > r + b.r + 12);
        if(clear) return {x, y};
      }
      return {
        x: pad + Math.random()*(bubbleCanvas.width - pad*2),
        y: pad + Math.random()*(bubbleCanvas.height - pad*2)
      };
    }
    function createBubble(word){
      const r = 42 + Math.random()*12;
      const spot = findBubbleSpot(r);
      return {
        x: spot.x,
        y: spot.y,
        vx: (Math.random()-0.5)*0.6,
        vy: (Math.random()-0.5)*0.6,
        phase: Math.random()*Math.PI*2,
        r, word:word.text, tense:word.tense,
        shake:0, popped:false
      };
    }
    function pickWord(tense){
      const pool = WORDS.filter(w => w.tense === tense);
      return pool[(Math.random()*pool.length)|0];
    }
    function initBubbles(){
      bubbles = []; pops = [];
      const target = window.currentTarget;
      const other = target === 'PC' ? 'PP' : 'PC';
      const roundWords = [
        ...Array.from({length:7}, () => pickWord(target)),
        ...Array.from({length:5}, () => pickWord(other))
      ];
      shuffle(roundWords);
      for(const w of roundWords){
        bubbles.push(createBubble(w));
      }
      poppedCount = 0;
      const pc = document.getElementById('poppedCount');
      if(pc) pc.innerText = '0';
      const rn = document.getElementById('bubbleRound');
      if(rn) rn.innerText = roundNo;
    }
    function startNextRound(nextTarget){
      roundNo++;
      setTarget(nextTarget);
      initBubbles();
      flash(`Round ${roundNo} started`, true);
    }
    function step(){
      const W = bubbleCanvas.width, H = bubbleCanvas.height;
      ctx.clearRect(0,0,W,H);
      // bubbles
      for(const b of bubbles){
        if(b.popped) continue;
        b.phase += 0.05;
        b.x += b.vx + Math.sin(b.phase)*0.15;
        b.y += b.vy + Math.cos(b.phase*0.9)*0.15;
        if(b.x < b.r+2 || b.x > W-b.r-2) b.vx *= -1;
        if(b.y < b.r+2 || b.y > H-b.r-2) b.vy *= -1;
        b.x = Math.max(b.r+2, Math.min(W-b.r-2, b.x));
        b.y = Math.max(b.r+2, Math.min(H-b.r-2, b.y));
      }
      for(let i=0; i<bubbles.length; i++){
        const a = bubbles[i];
        if(a.popped) continue;
        for(let j=i+1; j<bubbles.length; j++){
          const b = bubbles[j];
          if(b.popped) continue;
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.max(1, Math.hypot(dx, dy));
          const minDist = a.r + b.r + 10;
          if(dist < minDist){
            const push = (minDist - dist) / 2;
            const nx = dx / dist;
            const ny = dy / dist;
            a.x = Math.max(a.r+2, Math.min(W-a.r-2, a.x - nx*push));
            a.y = Math.max(a.r+2, Math.min(H-a.r-2, a.y - ny*push));
            b.x = Math.max(b.r+2, Math.min(W-b.r-2, b.x + nx*push));
            b.y = Math.max(b.r+2, Math.min(H-b.r-2, b.y + ny*push));
            a.vx -= nx*0.03; a.vy -= ny*0.03;
            b.vx += nx*0.03; b.vy += ny*0.03;
          }
        }
      }
      for(const b of bubbles){
        if(b.popped) continue;
        const dx = b.shake>0 ? Math.sin(b.shake*1.7)*4 : 0;
        if(b.shake>0) b.shake--;
        const cx = b.x + dx, cy = b.y;
        const isTarget = (b.tense === window.currentTarget);
        const grad = ctx.createRadialGradient(cx-b.r*0.35, cy-b.r*0.35, 4, cx, cy, b.r);
        if(isTarget){
          grad.addColorStop(0,'#fff5b8'); grad.addColorStop(1,'#f7b05e');
        } else {
          grad.addColorStop(0,'#dbe9f5'); grad.addColorStop(1,'#9ab8cf');
        }
        ctx.beginPath(); ctx.arc(cx,cy,b.r,0,Math.PI*2); ctx.fillStyle=grad; ctx.fill();
        ctx.strokeStyle = b.shake>0 ? '#cd5c5c' : (isTarget?'#e89a3c':'#5e7e96');
        ctx.lineWidth = 2; ctx.stroke();
        // shine
        ctx.beginPath(); ctx.arc(cx-b.r*0.35, cy-b.r*0.35, b.r*0.22, 0, Math.PI*2);
        ctx.fillStyle='rgba(255,255,255,0.55)'; ctx.fill();
        // word
        ctx.fillStyle='#1a2c3e';
        ctx.font = `700 ${Math.max(10, Math.min(12, (b.r*0.24)|0))}px "JetBrains Mono", Consolas, monospace`;
        ctx.textAlign='center'; ctx.textBaseline='middle';
        const parts = b.word.split(' ');
        const lines = parts.length > 2 ? [parts.slice(0,2).join(' '), parts.slice(2).join(' ')] : [b.word];
        lines.forEach((line, idx) => ctx.fillText(line, cx, cy + (idx - (lines.length-1)/2) * 14));
      }
      // pop particles
      for(let i=pops.length-1; i>=0; i--){
        const p = pops[i];
        p.x += p.vx; p.y += p.vy; p.vy += 0.12; p.life -= 0.025;
        if(p.life<=0){ pops.splice(i,1); continue; }
        ctx.globalAlpha = Math.max(0, p.life);
        ctx.fillStyle = p.color;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI*2); ctx.fill();
        ctx.globalAlpha = 1;
      }
      requestAnimationFrame(step);
    }
    function spawnBurst(x,y,ok){
      const palette = ok ? ['#f7b05e','#ffd166','#fff5b8','#e89a3c'] : ['#cd5c5c','#e8b4b4','#a13838'];
      for(let i=0;i<14;i++){
        pops.push({
          x,y,
          vx:(Math.random()-0.5)*5,
          vy:(Math.random()-0.5)*5 - 1,
          life:1, size:2+Math.random()*3,
          color: palette[(Math.random()*palette.length)|0]
        });
      }
    }
    function locate(e){
      const rect = bubbleCanvas.getBoundingClientRect();
      const sx = bubbleCanvas.width  / rect.width;
      const sy = bubbleCanvas.height / rect.height;
      const cx = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
      const cy = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
      return { x: cx*sx, y: cy*sy, clientX: cx+rect.left, clientY: cy+rect.top };
    }
    function onClick(e){
      const p = locate(e);
      for(let i=bubbles.length-1; i>=0; i--){
        const b = bubbles[i];
        if(b.popped) continue;
        if(Math.hypot(p.x-b.x, p.y-b.y) <= b.r+2){
          const correct = (b.tense === window.currentTarget);
          if(correct){
            b.popped = true;
            poppedCount++;
            spawnBurst(b.x, b.y, true);
            const pc = document.getElementById('poppedCount');
            if(pc) pc.innerText = poppedCount;
            addScore(10, p.clientX, p.clientY);
            flash('+10 correct', true);
            if(poppedCount >= BUBBLE_TARGET){
              addScore(50);
              flash('Round done! +50', true);
              const next = (window.currentTarget==='PC') ? 'PP' : 'PC';
              setTimeout(()=>{ startNextRound(next); }, 700);
              if(!activityCompleted[1]) completeActivity(1);
            } else {
              // Keep enough target bubbles on the field so the next round feels reachable.
              setTimeout(()=>{
                const visibleTargets = bubbles.filter(item => !item.popped && item.tense === window.currentTarget).length;
                const w = visibleTargets < 3 ? pickWord(window.currentTarget) : WORDS[(Math.random()*WORDS.length)|0];
                bubbles.push(createBubble(w));
              }, 300);
            }
          } else {
            // wrong — don't remove, just shake red
            b.shake = 20;
            spawnBurst(b.x, b.y, false);
            globalScore = Math.max(0, globalScore - 2);
            document.getElementById('globalScore').innerText = globalScore;
            const tName = window.currentTarget==='PC' ? 'Continuous' : 'Perfect';
            flash(`Need ${tName} (-2)`, false);
          }
          break;
        }
      }
    }
    bubbleCanvas.addEventListener('click', onClick);
    bubbleCanvas.addEventListener('touchstart', (e)=>{ e.preventDefault(); onClick(e); }, {passive:false});
    window.addEventListener('resize', resize);
    resize(); setTarget('PC'); initBubbles(); step();
    document.getElementById('resetBubblesBtn').addEventListener('click', ()=>{
      const next = (window.currentTarget==='PC') ? 'PP' : 'PC';
      startNextRound(next);
    });
  })();
  
  // ----- 2) SENTENCE TRAIL
  const sentences = [{ words: ["I","am","checking","my","schedule","now"], correct: "I am checking my schedule now", hint:"Present Continuous" },{ words: ["She","has","never","worn","formal","suits"], correct: "She has never worn formal suits", hint:"Present Perfect" },{ words: ["We","are","improving","the","system","this","week"], correct: "We are improving the system this week", hint:"temporary action" },{ words: ["They","have","just","finished","the","report"], correct: "They have just finished the report", hint:"recent action" }];
  let sentIdx=0, trailBank=[], trailBuilt=[];
  function loadSentence(idx){ let s=sentences[idx]; document.getElementById('trailQuestion').innerHTML=`${s.hint}<br>Rearrange the sentence:`; trailBank=[...s.words]; trailBuilt=[]; shuffle(trailBank); renderTrail(); }
  function shuffle(arr){ for(let i=arr.length-1;i>0;i--){ let j=Math.floor(Math.random()*(i+1)); [arr[i],arr[j]]=[arr[j],arr[i]]; } }
  function renderTrail(){ let bankDiv=document.getElementById('trailWordBank'), sentDiv=document.getElementById('trailSentenceArea'); bankDiv.innerHTML=''; sentDiv.innerHTML=''; trailBank.forEach(w=>{ let chip=document.createElement('div'); chip.className='word-chip'; chip.innerText=w; chip.onclick=()=>{ let idx=trailBank.indexOf(w); if(idx!==-1){ trailBank.splice(idx,1); trailBuilt.push(w); renderTrail(); } }; bankDiv.appendChild(chip); }); trailBuilt.forEach(w=>{ let span=document.createElement('div'); span.className='trail-word'; span.innerText=w; span.onclick=()=>{ let idx=trailBuilt.indexOf(w); if(idx!==-1){ trailBuilt.splice(idx,1); trailBank.push(w); renderTrail(); } }; sentDiv.appendChild(span); }); }
  document.getElementById('checkTrailBtn').addEventListener('click',()=>{ let cur=sentences[sentIdx]; let user=trailBuilt.join(' '); if(user===cur.correct){ document.getElementById('trailFeedback').innerHTML='Perfect! +25 points'; addScore(25); sentIdx=(sentIdx+1)%sentences.length; loadSentence(sentIdx); setTimeout(()=>document.getElementById('trailFeedback').innerHTML='',1500); if(sentIdx===0 && !activityCompleted[2]) completeActivity(2); } else { document.getElementById('trailFeedback').innerHTML=`Expected: "${cur.correct}". Try again.`; } });
  loadSentence(0);
  
  // ----- 3) Multiple Choice (original)
  // ----- 3) MULTIPLE CHOICE
  const mcqQ = [
    { text: "Right now, I ______ (check) my schedule.", opts: ["check","am checking","have checked"], correct: 1 },
    { text: "She ______ never ______ (wear) formal suits.", opts: ["has/worn","has/wore","is/wearing"], correct: 0 },
    { text: "Look! It ______ (rain) heavily.", opts: ["rains","is raining","has rained"], correct: 1 },
    { text: "We ______ already ______ (finish) the project.", opts: ["have/finished","are/finishing","has/finished"], correct: 0 },
    { text: "He ______ (work) on this report all morning.", opts: ["works","is working","has been working"], correct: 2 }
  ];
  function renderMCQ(){
    const area = document.getElementById('mcqArea'); if(!area) return;
    area.innerHTML = mcqQ.map((q,i)=>
      `<div class="mcq-item"><div class="mcq-text">${i+1}. ${q.text}</div>
        <div class="mcq-options">${q.opts.map((o,j)=>
          `<label class="mcq-opt"><input type="radio" name="mcq${i}" value="${j}"> ${o}</label>`).join('')}</div></div>`
    ).join('');
  }
  function checkMCQ(){
    let correct = 0;
    mcqQ.forEach((q,i)=>{
      const sel = document.querySelector(`input[name="mcq${i}"]:checked`);
      if(sel && parseInt(sel.value,10)===q.correct) correct++;
    });
    const fb = document.getElementById('mcqFeedback');
    if(fb){
      fb.innerHTML = `${correct}/${mcqQ.length} correct → +${correct*15}`;
      fb.style.color = correct===mcqQ.length ? 'var(--ok)' : 'var(--muted)';
    }
    addScore(correct*15);
    if(correct===mcqQ.length && !activityCompleted[3]) completeActivity(3);
  }
  renderMCQ();
  document.getElementById('mcqCheckBtn')?.addEventListener('click', checkMCQ);

  // ----- 4) FILL THE GAPS
  const gapQ = [
    { text: "I ___ (read) this book three times. (PP)",        answer: "have read" },
    { text: "Look at the kids! They ___ (play) in the rain.",   answer: "are playing" },
    { text: "She ___ (just / leave) the office.",                answer: "has just left" },
    { text: "We ___ (work) on this design since Monday.",        answer: "have been working" },
    { text: "Right now my brother ___ (cook) dinner.",           answer: "is cooking" }
  ];
  function renderGap(){
    const area = document.getElementById('gapArea'); if(!area) return;
    area.innerHTML = gapQ.map((q,i)=>
      `<div class="gap-item"><div>${i+1}. ${q.text}</div>
        <input type="text" id="gap${i}" class="gap-input" placeholder="type the form" autocomplete="off"></div>`
    ).join('');
  }
  function checkGap(){
