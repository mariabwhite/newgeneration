  box-shadow:0 4px 18px rgba(44,125,160,.05);
  display:flex;flex-direction:column;align-items:center;gap:10px;}
.rules-table-img{display:block;width:100%;max-width:780px;height:auto;border-radius:12px;}
.rules-table-cap{
  font-family:var(--mono);font-size:10px;font-weight:700;letter-spacing:.16em;
  text-transform:uppercase;color:var(--faint);text-align:center;}

