    return String(text).replace(/[&<>"']/g, function(ch){
      return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[ch];
    });
  }
  function loadState(){
    try{
      var raw = localStorage.getItem(STORAGE_KEY);
      if(raw){
        var parsed = JSON.parse(raw);
        if(parsed && typeof parsed === "object") return {done: parsed.done || {}, version: 1};
      }
    }catch(e){}
    return { done: {}, version: 1 };
  }
  function saveState(){ try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }catch(e){} }
  function countDone(){
    return allPages.reduce(function(total, page){ return total + (state.done[page] ? 1 : 0); }, 0);
  }
  function chapterDone(key){
    var pages = CHAPTER_PAGES[key] || [];
    return pages.length && pages.every(function(page){ return state.done[page]; });
  }
  function setDone(pageId){
    if(!pageId || state.done[pageId]) return;
    state.done[pageId] = true;
    saveState();
    renderProgress();
    refreshCards();
  }
  function unsetDone(pageId){
    delete state.done[pageId];
    saveState();
    renderProgress();
    refreshCards();
  }
  function renderProgress(){
    var done = countDone();
    var fill = byId("wl-progress-fill");
    var rail = fill && fill.parentElement;
    var pct = TOTAL_PAGES ? Math.round((done / TOTAL_PAGES) * 100) : 0;
    if(fill) fill.style.width = pct + "%";
    if(rail) rail.setAttribute("aria-valuenow", String(done));
    if(byId("wl-count-done")) byId("wl-count-done").textContent = String(done);
    if(byId("wl-count-total")) byId("wl-count-total").textContent = String(TOTAL_PAGES);
    document.querySelectorAll(".wl-star").forEach(function(star){
      star.classList.toggle("is-done", chapterDone(star.getAttribute("data-star")));
    });
    var door = byId("wl-door");
    if(door){
      var open = chapterDone("c3");
      door.classList.toggle("is-open", open);
      door.textContent = open ? "The Conditional Door opens." : "The door is listening.";
    }
  }
  function refreshCards(){
    document.querySelectorAll("[data-page-id]").forEach(function(card){
      card.classList.toggle("is-done", !!state.done[card.getAttribute("data-page-id")]);
    });
  }

  window.WL = {
    markPage: setDone,
    unmarkPage: unsetDone,
    isPageDone: function(pageId){ return !!state.done[pageId]; },
    state: function(){ return JSON.parse(JSON.stringify(state)); },
