    {id:"c2:types", title:"Shelf 1: The Types", intro:"Fiction tells invented stories; non-fiction explains real people, facts, and ideas.", cards:[["fiction","stories invented by an author"],["non-fiction","writing about real facts"],["biography","a life story of a real person"]]},
    {id:"c2:formats", title:"Shelf 2: The Writers", intro:"The library sorts people by what they create.", cards:[["author","the person who writes a book"],["biographer","a writer of life stories"],["ghost-writer","a hidden writer for another person"]]},
    {id:"c2:genres", title:"Shelf 3: Describe Who You Find", intro:"Describe the writer before you trust the book.", cards:[["imaginative","full of original ideas"],["controversial","causing disagreement"],["influential","changing how people think"]]},
    {id:"c2:parts", title:"Shelf 4: Anatomy of a Book", intro:"Every volume has a body.", cards:[["chapter","one main part of a book"],["foreword","introductory words before the main text"],["glossary","a list of explained words"]]},
    {id:"c2:authors", title:"Shelf 5: The Library's Judgment", intro:"Judge the reading experience carefully.", cards:[["gripping","so interesting you cannot stop"],["predictable","too easy to guess"],["thought-provoking","making you think deeply"]]},
    {id:"c2:describe", title:"Shelf 6: The Forms They Take", intro:"The same book may wear different forms.", cards:[["hardback","a book with a hard cover"],["paperback","a book with a soft cover"],["e-book","a digital book"]]},
    {id:"c2:reading-verbs", title:"Shelf 7: Hidden Features", intro:"Look at what the book offers the reader.", cards:[["plot twist","a surprising change in the story"],["setting","where and when a story happens"],["narrator","the voice telling the story"]]},
    {id:"c2:adjectives", title:"Shelf 8: Whispered Titles", intro:"A title can promise a mood.", cards:[["mysterious","hard to explain or understand"],["timeless","still meaningful after many years"],["haunting","staying in your mind"]]},
    {id:"c2:shelf-final", title:"Shelf 9: The Pantheon", intro:"The missing book is a mysterious, timeless story with a narrator who changes fate.", final:true}
  ];

  var runes = [
    {id:"c3:flip-1st", title:"Rune 1: Zero Conditional", intro:"General truths: if + present, present.", cards:[["If paper gets wet,","it becomes fragile."],["If a candle burns low,","the room grows darker."],["If a book has no title,","readers feel curious."]]},
    {id:"c3:flip-2nd", title:"Rune 2: First Conditional", intro:"Real future: if + present, will + verb.", cards:[["If Julia opens the cover,","the shelf will move."],["If you find the clue,","the library will answer."],["If the page returns,","the map will glow."]]},
    {id:"c3:flip-3rd", title:"Rune 3: Second Conditional", intro:"Hypothetical now: if + past, would + verb.", cards:[["If I knew the title,","I would follow the right shelf."],["If Julia were braver,","she would speak to the mirror."],["If the book trusted us,","it would stop whispering."]]},
    {id:"c3:flip-mix", title:"Rune 4: Third Conditional", intro:"Past hypothetical: if + past perfect, would have + past participle.", cards:[["If Julia had listened,","she would have heard the warning."],["If the book had stayed closed,","history would not have changed."],["If they had found the key,","the door would have opened."]]},
    {id:"c3:flip-bonus", title:"Rune 5: Mixed Conditional", intro:"Past cause, present result.", cards:[["If she had taken notes,","she would know the spell now."],["If the author had hidden less,","we would be less confused."],["If I had read the foreword,","I would understand the curse."]]}
  ];

  var spellGroups = [
    {id:"c3:drag-a", title:"Spell Fragments A", items:[["If I __ the title, I would tell you.","knew",["know","knew","had known"]],["If the shelf moves, Julia __ the key.","will find",["would find","will find","found"]]]},
    {id:"c3:drag-b", title:"Spell Fragments B", items:[["If I __ earlier, I would have warned her.","had arrived",["arrived","had arrived","would arrive"]],["If the book __ open, the room gets colder.","stays",["stays","stayed","had stayed"]]]},
    {id:"c3:drag-c", title:"Spell Fragments C", items:[["If Julia were here, she __ the spine.","would touch",["will touch","would touch","touched"]],["If they had listened, the curse __ begun.","would not have",["will not","would not have","does not"]]]},
    {id:"c3:drag-d", title:"Spell Fragments D", items:[["If the candle goes out, the door __.","will close",["would close","closed","will close"]],["If I had read the glossary, I __ lost now.","would not be",["will not be","would not be","am not"]]]},
