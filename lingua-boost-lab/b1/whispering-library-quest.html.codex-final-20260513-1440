    {id:"c1:mixed-c", title:"The Final Memory", page:"Full story", prompt:"Choose the best final memory sentence.", mode:"single", answer:"Julia found a strange book and heard it whisper.", choices:["Julia finds a strange book every day.","Julia found a strange book and heard it whisper.","Julia will find a book tomorrow."], feedback:"Chapter I closes: the first pages return."}
