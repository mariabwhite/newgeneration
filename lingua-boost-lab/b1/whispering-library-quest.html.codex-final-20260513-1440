          return '<button type="button" class="wl-choice" data-choice="' + esc(choice) + '">' + esc(choice) + '</button>';
        }).join("") + '</div>';
      }else if(item.mode === "text"){
        body = '<input class="wl-input canon-l-input" data-text-answer autocomplete="off" placeholder="Write your answer here">';
      }else if(item.mode === "select"){
        body = item.blanks.map(function(options, index){
          return '<label class="wl-mini-label">Blank ' + (index + 1) + '</label><select class="wl-select canon-l-input" data-select-answer><option value="">Choose...</option>' + options.map(function(option){ return '<option>' + esc(option) + '</option>'; }).join("") + '</select>';
        }).join("");
