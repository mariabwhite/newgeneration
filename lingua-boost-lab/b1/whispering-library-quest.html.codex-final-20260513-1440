    {id:"c1:places", title:"Where You Walked", page:"Path places", prompt:"Choose the three places Julia passed before the library.", mode:"choices", answers:["hairdresser","old square","bookshop"], choices:["airport","hairdresser","old square","bookshop","beach"], feedback:"The path appears on the library floor."},
    {id:"c1:feel", title:"The Whisper Asks", page:"Feelings", prompt:"Type two feelings Julia had, separated by a comma.", mode:"text", keywords:["curious","nervous","excited","tired","confused","afraid"], feedback:"The shelves can hear emotion now."},
    {id:"c1:phrases", title:"The Library's Language", page:"Useful phrases", prompt:"Choose phrases that help tell a past story.", mode:"choices", answers:["Yesterday, I...","First, I...","Then I..."], choices:["Tomorrow, I will...","Yesterday, I...","First, I...","Then I...","Every Monday I..."], feedback:"The story phrases are in the right order."},
