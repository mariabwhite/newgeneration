<style>
/* ===== WHISPERING LIBRARY · LESSON PALETTE & LOCAL STYLES ===== */
:root{
  --wl-violet-deep:#1a0e2a;
  --wl-violet-mid:#2a1b3d;
  --wl-violet-glow:#5d3a8a;
  --wl-wood:#7a4f2a;
  --wl-wood-dark:#4a2e16;
  --wl-gold:#d4a843;
  --wl-gold-soft:#e8c168;
  --wl-parchment:#f3e9d2;
  --wl-parchment-dim:rgba(243,233,210,.72);
  --wl-emerald:#2d5d4a;
  --wl-emerald-glow:#4a9b7a;
  --wl-ink:#0d0716;
  --wl-radius:18px;
  --wl-radius-sm:10px;
  --wl-shadow:0 10px 30px rgba(13,7,22,.50);
  --wl-shadow-glow:0 0 32px rgba(212,168,67,.22);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:radial-gradient(ellipse at 50% -10%, var(--wl-violet-glow) 0%, var(--wl-violet-mid) 35%, var(--wl-violet-deep) 100%) fixed;
  color:var(--wl-parchment);
  font-family:"Manrope",system-ui,-apple-system,sans-serif;
  font-weight:400;
  line-height:1.55;
  min-height:100vh;
  overflow-x:hidden;
}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:
    radial-gradient(1px 1px at 14% 22%, rgba(243,233,210,.45) 0%, transparent 100%),
    radial-gradient(1px 1px at 76% 18%, rgba(243,233,210,.32) 0%, transparent 100%),
    radial-gradient(1px 1px at 38% 64%, rgba(212,168,67,.28) 0%, transparent 100%),
    radial-gradient(1px 1px at 88% 72%, rgba(212,168,67,.22) 0%, transparent 100%),
    radial-gradient(2px 2px at 56% 38%, rgba(243,233,210,.20) 0%, transparent 100%),
    radial-gradient(1px 1px at 22% 86%, rgba(243,233,210,.30) 0%, transparent 100%);
  opacity:.85;
}
.wl-wrap{position:relative;z-index:1;max-width:1240px;margin:0 auto;padding:24px clamp(14px,3vw,28px) 64px}

/* ===== HERO ===== */
.canon-l-hero.wl-hero{
  position:relative;
  margin:24px auto 16px;
  padding:clamp(24px,4vw,40px) clamp(20px,4vw,40px);
  border-radius:var(--wl-radius);
  background:linear-gradient(140deg, rgba(93,58,138,.36) 0%, rgba(74,46,22,.32) 60%, rgba(26,14,42,.40) 100%);
  border:1px solid rgba(212,168,67,.22);
  box-shadow:var(--wl-shadow), inset 0 0 80px rgba(212,168,67,.08);
  overflow:hidden;
}
.wl-hero-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(20px,4vw,40px);align-items:center}
@media (max-width:780px){.wl-hero-grid{grid-template-columns:1fr;gap:24px}}
.wl-hero-eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-family:"JetBrains Mono",ui-monospace,monospace;font-weight:700;font-size:11px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--wl-gold);
  padding:6px 14px;border-radius:999px;
  background:rgba(212,168,67,.10);border:1px solid rgba(212,168,67,.28);
}
.wl-hero-title{
  font-family:"Unbounded","Manrope",system-ui,sans-serif;
  font-weight:800;font-size:clamp(2rem,5.5vw,3.4rem);
  line-height:1.05;letter-spacing:-.01em;
  margin:14px 0 12px;
  color:var(--wl-parchment);
  text-shadow:0 0 38px rgba(212,168,67,.28), 0 2px 0 rgba(13,7,22,.45);
}
.wl-hero-title em{font-style:normal;color:var(--wl-gold);font-weight:900}
.wl-hero-lead{
  font-size:clamp(.96rem,1.4vw,1.08rem);line-height:1.6;
  color:var(--wl-parchment-dim);
  max-width:52ch;margin:0 0 18px;
}
.wl-hero-pills{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:14px}
.wl-pill{
  display:inline-flex;align-items:center;gap:6px;
  padding:.3rem .8rem;border-radius:999px;
  font-family:"JetBrains Mono",ui-monospace,monospace;
  font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
  background:rgba(212,168,67,.08);color:var(--wl-gold);
  border:1px solid rgba(212,168,67,.30);
}
.wl-pill.is-violet{background:rgba(93,58,138,.22);color:#dbc3ff;border-color:rgba(93,58,138,.45)}
.wl-pill.is-emerald{background:rgba(74,155,122,.16);color:var(--wl-emerald-glow);border-color:rgba(74,155,122,.40)}
.wl-pill.is-wood{background:rgba(122,79,42,.22);color:#e0b888;border-color:rgba(122,79,42,.45)}

/* Hero art frame */
.wl-hero-art{
  position:relative;aspect-ratio:5/4;
  border-radius:14px;overflow:hidden;
  background:linear-gradient(170deg,#1a0e2a 0%,#4a2e16 100%);
  box-shadow:inset 0 0 60px rgba(0,0,0,.5);
  border:1px solid rgba(212,168,67,.20);
}
.wl-hero-art svg{display:block;width:100%;height:100%}

/* ===== TRUST BLOCK (4 pillars) ===== */
.wl-why{
  margin:18px auto;border-radius:var(--wl-radius);
  background:linear-gradient(160deg,rgba(74,46,22,.28),rgba(26,14,42,.28));
  border:1px solid rgba(212,168,67,.22);
  overflow:hidden;
}
.wl-why-summary{
  list-style:none;cursor:pointer;
  padding:14px 22px;display:flex;align-items:center;gap:12px;
  font-family:"Unbounded","Manrope",system-ui,sans-serif;font-weight:700;font-size:.95rem;
  color:var(--wl-gold);letter-spacing:.01em;
}
.wl-why-summary::-webkit-details-marker{display:none}
.wl-why-summary::before{content:"";width:7px;height:7px;border-right:2px solid var(--wl-gold);border-bottom:2px solid var(--wl-gold);transform:rotate(-45deg);transition:transform .25s ease;display:inline-block}
.wl-why[open] .wl-why-summary::before{transform:rotate(45deg)}
.wl-why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;padding:6px 22px 22px}
@media (max-width:880px){.wl-why-grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:520px){.wl-why-grid{grid-template-columns:1fr}}
.wl-why-cell{
  padding:14px;border-radius:var(--wl-radius-sm);
  background:rgba(243,233,210,.04);
  border:1px solid rgba(212,168,67,.15);
}
.wl-why-cell h3{
  font-family:"Unbounded","Manrope",system-ui,sans-serif;font-weight:800;
  font-size:.84rem;letter-spacing:.04em;text-transform:uppercase;
  color:var(--wl-gold-soft);margin:0 0 6px;
}
.wl-why-cell p{margin:0;font-size:.88rem;line-height:1.5;color:var(--wl-parchment-dim)}
.wl-why-cell strong{color:var(--wl-parchment);font-weight:700}

/* ===== TRACKER ===== */
.wl-tracker{
  margin:18px auto;border-radius:var(--wl-radius);
  padding:18px 22px;
  background:linear-gradient(160deg,rgba(74,46,22,.32),rgba(26,14,42,.32));
  border:1px solid rgba(212,168,67,.22);
  box-shadow:var(--wl-shadow);
}
.wl-tracker-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:12px}
.wl-tracker-title{
  font-family:"Unbounded","Manrope",system-ui,sans-serif;font-weight:800;font-size:1.02rem;
  color:var(--wl-gold);letter-spacing:.01em;margin:0;
}
.wl-tracker-count{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:.82rem;color:var(--wl-parchment-dim)}
.wl-tracker-count b{color:var(--wl-gold-soft);font-weight:700}
.wl-progress-rail{
  height:10px;border-radius:999px;
  background:rgba(13,7,22,.55);
  overflow:hidden;border:1px solid rgba(212,168,67,.18);
}
.wl-progress-fill{
  height:100%;width:0%;
  background:linear-gradient(90deg,var(--wl-emerald-glow) 0%,var(--wl-gold) 60%,var(--wl-gold-soft) 100%);
  border-radius:999px;transition:width .4s cubic-bezier(.2,.8,.2,1);
}
.wl-tracker-stars{display:flex;gap:18px;flex-wrap:wrap;margin-top:14px;justify-content:center}
.wl-star{
  display:flex;flex-direction:column;align-items:center;gap:4px;
  opacity:.32;transition:opacity .4s, transform .4s;
  font-family:"JetBrains Mono",ui-monospace,monospace;font-size:.66rem;letter-spacing:.10em;text-transform:uppercase;color:var(--wl-parchment-dim);
}
.wl-star-icon{font-size:1.6rem;line-height:1;filter:grayscale(80%)}
.wl-star.is-done{opacity:1;transform:scale(1.05);color:#5b8b62}
.wl-star.is-done .wl-star-icon{filter:drop-shadow(0 0 10px rgba(91,139,98,.55))}
.wl-tracker-controls{display:flex;justify-content:flex-end;margin-top:10px}
.wl-btn{
  cursor:pointer;font-family:"Manrope",sans-serif;font-weight:700;
  padding:.42rem 1rem;border-radius:999px;
  background:transparent;color:var(--wl-parchment-dim);
  border:1px solid rgba(212,168,67,.30);
  font-size:.78rem;letter-spacing:.04em;
  transition:all .2s ease;
}
.wl-btn:hover{color:var(--wl-gold);border-color:var(--wl-gold);background:rgba(212,168,67,.06)}
.wl-btn:focus-visible{outline:2px solid var(--wl-gold);outline-offset:2px}

/* ===== CHAPTER CARDS ===== */
.wl-chapter{
  position:relative;
  margin:28px auto;padding:0;
  border-radius:var(--wl-radius);
  background:linear-gradient(165deg,rgba(243,233,210,.05) 0%,rgba(74,46,22,.22) 100%);
  border:1px solid rgba(212,168,67,.22);
  box-shadow:var(--wl-shadow);
  overflow:hidden;
}
.wl-chapter.is-violet{background:linear-gradient(165deg,rgba(93,58,138,.18) 0%,rgba(26,14,42,.32) 100%);border-color:rgba(93,58,138,.32)}
.wl-chapter.is-emerald{background:linear-gradient(165deg,rgba(74,155,122,.14) 0%,rgba(26,14,42,.30) 100%);border-color:rgba(74,155,122,.32)}
.wl-chapter-head{
  padding:22px clamp(20px,3vw,28px) 18px;
  border-bottom:1px dashed rgba(212,168,67,.18);
}
.wl-chapter-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-family:"JetBrains Mono",ui-monospace,monospace;
  font-size:.7rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;
  color:var(--wl-gold);
  padding:4px 10px;border-radius:999px;
  background:rgba(212,168,67,.08);border:1px solid rgba(212,168,67,.30);
  margin-bottom:8px;
}
.wl-chapter.is-violet .wl-chapter-eyebrow{color:#dbc3ff;background:rgba(93,58,138,.22);border-color:rgba(93,58,138,.45)}
.wl-chapter.is-emerald .wl-chapter-eyebrow{color:var(--wl-emerald-glow);background:rgba(74,155,122,.18);border-color:rgba(74,155,122,.45)}
.wl-chapter-title{
  font-family:"Unbounded","Manrope",system-ui,sans-serif;font-weight:800;
  font-size:clamp(1.4rem,3vw,1.85rem);line-height:1.15;letter-spacing:-.005em;
  color:var(--wl-parchment);margin:6px 0 6px;
}
.wl-chapter-title em{color:var(--wl-gold);font-style:normal}
.wl-chapter.is-violet .wl-chapter-title em{color:#c8a8ff}
.wl-chapter.is-emerald .wl-chapter-title em{color:var(--wl-emerald-glow)}
.wl-chapter-lead{
  font-size:.96rem;line-height:1.55;color:var(--wl-parchment-dim);max-width:60ch;margin:0;
}
.wl-chapter-body{padding:20px clamp(20px,3vw,28px) 26px;min-height:140px}


/* ===== WHISPERING LIBRARY · INTERACTIVE CONTENT ===== */
.wl-activity-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.wl-activity-card,.wl-shelf-card,.wl-rune-card,.wl-spell-panel,.wl-finale-panel{
  border:1px solid rgba(212,168,67,.22);
  border-radius:12px;
  background:rgba(13,7,22,.28);
  padding:16px;
  box-shadow:inset 0 0 36px rgba(212,168,67,.035);
}
.wl-activity-card.is-done,.wl-shelf-card.is-done,.wl-rune-card.is-done,.wl-spell-panel.is-done,.wl-finale-panel.is-done{
  border-color:rgba(74,155,122,.58);
  box-shadow:0 0 22px rgba(74,155,122,.14), inset 0 0 36px rgba(74,155,122,.05);
}
.wl-activity-card h3,.wl-shelf-card h3,.wl-rune-card h3,.wl-spell-panel h3,.wl-finale-panel h3{
  margin:0 0 8px;
  color:var(--wl-gold-soft);
  font-family:"Unbounded","Manrope",system-ui,sans-serif;
  font-size:.92rem;
  line-height:1.25;
}
.wl-activity-card p,.wl-shelf-card p,.wl-rune-card p,.wl-spell-panel p,.wl-finale-panel p{
  margin:.3rem 0 .75rem;
  color:var(--wl-parchment-dim);
  font-size:.9rem;
}
.wl-mini-label{display:block;margin:.65rem 0 .25rem;color:var(--wl-gold);font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
.wl-check-row{display:flex;flex-wrap:wrap;gap:8px;margin:.7rem 0}
.wl-choice{
  border:1px solid rgba(212,168,67,.24);
  background:rgba(243,233,210,.045);
  color:var(--wl-parchment);
  border-radius:999px;
  padding:.44rem .78rem;
  font-weight:700;
  font-size:.8rem;
}
.wl-choice:hover,.wl-choice:focus-visible{border-color:var(--wl-gold);color:var(--wl-gold);outline:none}
.wl-choice.is-selected{background:rgba(212,168,67,.16);border-color:var(--wl-gold);color:var(--wl-gold-soft)}
.wl-choice.is-right{background:rgba(74,155,122,.20);border-color:var(--wl-emerald-glow);color:#baf0d5}
.wl-choice.is-wrong{background:rgba(160,64,64,.18);border-color:rgba(230,120,120,.55);color:#ffd0d0}
.wl-input,.wl-textarea,.wl-select{
  width:100%;
  border:1px solid rgba(212,168,67,.28);
  border-radius:10px;
  background:rgba(13,7,22,.50);
  color:var(--wl-parchment);
  padding:.72rem .82rem;
  font:inherit;
}
.wl-textarea{min-height:150px;resize:vertical;line-height:1.55}
.wl-input:focus,.wl-textarea:focus,.wl-select:focus{outline:2px solid rgba(212,168,67,.55);outline-offset:2px}
.wl-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:.8rem}
.wl-feedback{min-height:1.3em;color:var(--wl-parchment-dim);font-size:.84rem}
.wl-feedback.ok{color:#baf0d5}.wl-feedback.err{color:#ffd0d0}
.wl-small-list{margin:.55rem 0 0;padding-left:1.1rem;color:var(--wl-parchment-dim);font-size:.86rem}
.wl-small-list li{margin:.2rem 0}
.wl-flip-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:12px}
.wl-flip{
  min-height:118px;
  text-align:left;
  border:1px solid rgba(212,168,67,.24);
  border-radius:10px;
  background:linear-gradient(150deg,rgba(243,233,210,.07),rgba(13,7,22,.32));
  color:var(--wl-parchment);
  padding:12px;
  cursor:pointer;
}
.wl-flip strong{display:block;color:var(--wl-gold-soft);margin-bottom:6px}
.wl-flip span{display:block;color:var(--wl-parchment-dim);font-size:.83rem}
.wl-flip.is-flipped{border-color:var(--wl-gold);background:rgba(212,168,67,.12)}
.wl-shelf-tools{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:12px}
.wl-shelf-index,.wl-page-badge{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:.72rem;color:var(--wl-gold);letter-spacing:.06em;text-transform:uppercase}
.wl-spell-list{display:grid;gap:10px;margin-top:12px}
.wl-spell-item{
  display:grid;
  grid-template-columns:1fr minmax(150px,220px);
  gap:10px;
  align-items:center;
  padding:10px;
  border-radius:10px;
  background:rgba(243,233,210,.04);
  border:1px solid rgba(74,155,122,.20);
}
.wl-spell-item.is-right{border-color:rgba(74,155,122,.58);background:rgba(74,155,122,.11)}
.wl-door{
  margin-top:16px;
  border:1px solid rgba(74,155,122,.34);
  border-radius:12px;
  min-height:110px;
  display:grid;
  place-items:center;
  background:linear-gradient(90deg,rgba(13,7,22,.75) 0 48%,rgba(45,93,74,.45) 48% 52%,rgba(13,7,22,.75) 52% 100%);
  color:var(--wl-emerald-glow);
  font-family:"Unbounded","Manrope",system-ui,sans-serif;
  font-weight:800;
  transition:all .5s ease;
}
.wl-door.is-open{background:radial-gradient(circle at 50% 50%,rgba(212,168,67,.38),rgba(74,155,122,.34) 38%,rgba(13,7,22,.72) 78%);color:var(--wl-gold-soft)}
.wl-finale-layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:16px;text-align:left;margin-top:18px}
.wl-rubric{display:grid;gap:8px;margin:12px 0}
.wl-rubric label{
  display:flex;align-items:flex-start;gap:8px;
  padding:10px;border-radius:10px;
  border:1px solid rgba(212,168,67,.20);
  background:rgba(243,233,210,.045);
  color:var(--wl-parchment-dim);
  font-size:.88rem;
}
.wl-rubric input{margin-top:3px;accent-color:var(--wl-emerald-glow)}
.wl-timer{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:12px;border-radius:12px;
  border:1px solid rgba(212,168,67,.24);
  background:rgba(13,7,22,.32);
}
.wl-timer-count{font-family:"JetBrains Mono",ui-monospace,monospace;color:var(--wl-gold-soft);font-weight:800;font-size:1.3rem}
.wl-book-returned{
  display:none;margin-top:14px;padding:14px;border-radius:12px;
  background:rgba(212,168,67,.12);border:1px solid rgba(212,168,67,.36);
  color:var(--wl-gold-soft);font-weight:800;text-align:center;
}
.wl-book-returned.show{display:block}
.wl-confetti{position:fixed;inset:0;pointer-events:none;z-index:9999}
@media (max-width:900px){.wl-activity-grid,.wl-finale-layout{grid-template-columns:1fr}.wl-flip-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:560px){.wl-flip-grid,.wl-spell-item{grid-template-columns:1fr}.wl-activity-card,.wl-shelf-card,.wl-rune-card,.wl-spell-panel,.wl-finale-panel{padding:14px}}

/* Finale */
.wl-finale{
  position:relative;margin:32px auto;padding:32px clamp(20px,3vw,32px);
  border-radius:var(--wl-radius);
  background:radial-gradient(ellipse at 50% 0%,rgba(93,58,138,.30) 0%,rgba(26,14,42,.60) 70%);
  border:1px solid rgba(212,168,67,.30);
  text-align:center;
  box-shadow:var(--wl-shadow),0 0 60px rgba(93,58,138,.20);
}
.wl-finale-eyebrow{
  font-family:"JetBrains Mono",ui-monospace,monospace;font-size:.72rem;letter-spacing:.20em;text-transform:uppercase;
  color:var(--wl-gold);
}
.wl-finale-title{
  font-family:"Unbounded","Manrope",system-ui,sans-serif;font-weight:900;
  font-size:clamp(1.6rem,4vw,2.4rem);color:var(--wl-parchment);
  margin:10px 0 12px;text-shadow:0 0 30px rgba(212,168,67,.32);
}
.wl-finale-lead{color:var(--wl-parchment-dim);max-width:54ch;margin:0 auto;font-size:1rem;line-height:1.55}

/* Skip-link override (English) */
.canon-l-skip-link{
  position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;
}
.canon-l-skip-link:focus{
  position:fixed;left:16px;top:16px;width:auto;height:auto;
  padding:10px 18px;background:var(--wl-gold);color:var(--wl-ink);
