  function checkC1(id){
    var item = c1Activities.find(function(row){ return row.id === id; });
    var card = document.querySelector('[data-page-id="' + id + '"]');
    if(!item || !card) return;
    var ok = false;
    if(item.mode === "choices"){
      var selected = Array.from(card.querySelectorAll(".wl-choice.is-selected")).map(function(btn){ return btn.getAttribute("data-choice"); });
      ok = item.answers.every(function(answer){ return selected.indexOf(answer) >= 0; }) && selected.every(function(answer){ return item.answers.indexOf(answer) >= 0; });
      card.querySelectorAll(".wl-choice").forEach(function(btn){ btn.classList.toggle("is-right", item.answers.indexOf(btn.getAttribute("data-choice")) >= 0 && selected.indexOf(btn.getAttribute("data-choice")) >= 0); });
    }else if(item.mode === "single"){
      var chosen = card.querySelector(".wl-choice.is-selected");
      ok = !!chosen && chosen.getAttribute("data-choice") === item.answer;
      card.querySelectorAll(".wl-choice").forEach(function(btn){
        var chosenThis = btn.classList.contains("is-selected");
        btn.classList.toggle("is-right", chosenThis && btn.getAttribute("data-choice") === item.answer);
        btn.classList.toggle("is-wrong", chosenThis && btn.getAttribute("data-choice") !== item.answer);
      });
    }else if(item.mode === "text"){
      var text = (card.querySelector("[data-text-answer]").value || "").toLowerCase();
      ok = item.keywords.some(function(word){ return text.indexOf(word) >= 0; }) && text.trim().split(/\s+/).length >= 4;
    }else if(item.mode === "select"){
      var values = Array.from(card.querySelectorAll("[data-select-answer]")).map(function(sel){ return sel.value; });
      ok = item.answers.every(function(answer, i){ return values[i] === answer; });
    }
    setFeedback(card, ok ? item.feedback : "The shelf waits for a more exact answer.", ok);
    if(ok) setDone(id);
  }

  function renderChapterTwo(){
    var mount = byId("wl-chapter2-mount");
    if(!mount) return;
    mount.innerHTML = shelves.map(function(shelf, index){
      var cards = shelf.final ? renderFinalShelf() : '<div class="wl-flip-grid">' + shelf.cards.map(function(card){
        return '<button type="button" class="wl-flip"><strong>' + esc(card[0]) + '</strong><span data-front="true">Tap to reveal meaning</span><span data-back="true" hidden>' + esc(card[1]) + '</span></button>';
      }).join("") + '</div>';
      return '<article class="wl-shelf-card canon-l-card" data-page-id="' + esc(shelf.id) + '">' +
        '<div class="wl-shelf-tools"><span class="wl-shelf-index">Shelf ' + (index + 1) + ' / 9</span><span class="wl-page-badge">' + esc(shelf.id.replace("c2:","")) + '</span></div>' +
        '<h3>' + esc(shelf.title) + '</h3><p>' + esc(shelf.intro) + '</p>' + cards +
        '<div class="wl-actions"><button type="button" class="wl-btn canon-l-btn" data-check-c2="' + esc(shelf.id) + '">Seal shelf</button><span class="wl-feedback canon-l-feedback"></span></div></article>';
    }).join("");
    mount.querySelectorAll(".wl-flip").forEach(function(btn){
      btn.addEventListener("click", function(){
        var flipped = btn.classList.toggle("is-flipped");
        btn.querySelector("[data-front]").hidden = flipped;
        btn.querySelector("[data-back]").hidden = !flipped;
      });
    });
    mount.querySelectorAll("[data-check-c2]").forEach(function(btn){
      btn.addEventListener("click", function(){ checkC2(btn.getAttribute("data-check-c2")); });
    });
    mount.querySelectorAll('[name="missing-book"]').forEach(function(radio){
      radio.addEventListener("change", function(){ checkC2("c2:shelf-final"); });
    });
  }

  function renderFinalShelf(){
    var options = ["The Atlas of Ordinary Roads","The Whispering Library","A Paperback Guide to Weather","The Biography of a Silent King"];
    return '<p><strong>Choose the missing book:</strong></p><div class="wl-check-row">' + options.map(function(option){
      return '<label class="wl-choice"><input type="radio" name="missing-book" value="' + esc(option) + '"> ' + esc(option) + '</label>';
    }).join("") + '</div>';
  }

  function checkC2(id){
    var card = document.querySelector('[data-page-id="' + id + '"]');
    if(!card) return;
    var ok = true;
    if(id === "c2:shelf-final"){
      var chosen = card.querySelector('[name="missing-book"]:checked');
      ok = !!chosen && chosen.value === "The Whispering Library";
    }else{
      ok = Array.from(card.querySelectorAll(".wl-flip")).every(function(btn){ return btn.classList.contains("is-flipped"); });
    }
    setFeedback(card, ok ? "Shelf sealed. A page slides back into the book." : "Reveal every card before sealing this shelf.", ok);
    if(ok) setDone(id);
  }

  function renderChapterThree(){
    var mount = byId("wl-chapter3-mount");
    if(!mount) return;
    var runeHtml = runes.map(function(rune){
      return '<article class="wl-rune-card canon-l-card" data-page-id="' + esc(rune.id) + '"><span class="wl-page-badge">Conditional rune</span><h3>' + esc(rune.title) + '</h3><p>' + esc(rune.intro) + '</p><div class="wl-flip-grid">' +
      rune.cards.map(function(card){ return '<button type="button" class="wl-flip"><strong>' + esc(card[0]) + '</strong><span data-front="true">Tap for result</span><span data-back="true" hidden>' + esc(card[1]) + '</span></button>'; }).join("") +
      '</div><div class="wl-actions"><button type="button" class="wl-btn canon-l-btn" data-check-rune="' + esc(rune.id) + '">Collect rune</button><span class="wl-feedback canon-l-feedback"></span></div></article>';
    }).join("");
    var spellHtml = spellGroups.map(function(group){
      return '<article class="wl-spell-panel canon-l-card" data-page-id="' + esc(group.id) + '"><span class="wl-page-badge">Spell fragments</span><h3>' + esc(group.title) + '</h3><div class="wl-spell-list">' +
      group.items.map(function(item, idx){
        return '<div class="wl-spell-item" data-answer="' + esc(item[1]) + '"><span>' + esc(item[0]) + '</span><select class="wl-select canon-l-input"><option value="">Choose spell</option>' + item[2].map(function(option){ return '<option>' + esc(option) + '</option>'; }).join("") + '</select></div>';
      }).join("") +
      '</div><div class="wl-actions"><button type="button" class="wl-btn canon-l-btn" data-check-spell="' + esc(group.id) + '">Cast spell</button><span class="wl-feedback canon-l-feedback"></span></div></article>';
    }).join("");
    mount.innerHTML = runeHtml + spellHtml;
    mount.querySelectorAll(".wl-flip").forEach(function(btn){
      btn.addEventListener("click", function(){
        var flipped = btn.classList.toggle("is-flipped");
        btn.querySelector("[data-front]").hidden = flipped;
        btn.querySelector("[data-back]").hidden = !flipped;
      });
    });
    mount.querySelectorAll("[data-check-rune]").forEach(function(btn){
      btn.addEventListener("click", function(){
        var id = btn.getAttribute("data-check-rune");
        var card = document.querySelector('[data-page-id="' + id + '"]');
        var ok = Array.from(card.querySelectorAll(".wl-flip")).every(function(flip){ return flip.classList.contains("is-flipped"); });
        setFeedback(card, ok ? "Rune collected." : "Turn all three cards to collect the rune.", ok);
        if(ok) setDone(id);
      });
    });
    mount.querySelectorAll("[data-check-spell]").forEach(function(btn){
      btn.addEventListener("click", function(){ checkSpell(btn.getAttribute("data-check-spell")); });
    });
  }

  function checkSpell(id){
    var panel = document.querySelector('[data-page-id="' + id + '"]');
    if(!panel) return;
    var items = Array.from(panel.querySelectorAll(".wl-spell-item"));
    var ok = items.every(function(item){
      var right = item.querySelector("select").value === item.getAttribute("data-answer");
      item.classList.toggle("is-right", right);
      return right;
    });
    setFeedback(panel, ok ? "The spell holds." : "One fragment is still unstable.", ok);
    if(ok) setDone(id);
  }

  function setFeedback(scope, message, ok){
    var fb = scope.querySelector(".wl-feedback");
    if(!fb) return;
    fb.textContent = message;
    fb.classList.toggle("ok", !!ok);
    fb.classList.toggle("err", !ok);
  }

  function countSentences(text){
    var matches = (text.trim().match(/[^.!?]+[.!?]+|[^.!?]+$/g) || []).map(function(s){ return s.trim(); }).filter(Boolean);
    return matches.length;
  }
  function updateFinaleRubric(){
    var text = (byId("wl-letter")?.value || "").toLowerCase();
    var sentenceCount = countSentences(text);
    if(byId("wl-sentence-count")) byId("wl-sentence-count").textContent = String(sentenceCount);
    var hasPast = /\b(went|found|felt|saw|walked|visited|heard|wore|was|were|came|changed|opened|read)\b/.test(text);
    var hasBook = /\b(book|library|shelf|chapter|author|title|plot|narrator|fiction|glossary|foreword|paperback|hardback)\b/.test(text);
    var hasConditional = /\bif\b.+\b(would|will|could|might|had|were)\b|\bwould\b.+\bif\b/.test(text);
    var checks = {past:hasPast, book:hasBook, conditional:hasConditional};
    Object.keys(checks).forEach(function(key){
      var input = document.querySelector('[data-rubric="' + key + '"]');
      if(input) input.checked = checks[key];
    });
    if(sentenceCount >= 3 && sentenceCount <= 5 && text.trim().length > 30) setDone("finale:letter");
    if(hasPast && hasBook && hasConditional) setDone("finale:rubric");
    return sentenceCount >= 3 && sentenceCount <= 5 && hasPast && hasBook && hasConditional;
  }
  function initFinale(){
    var letter = byId("wl-letter");
    if(letter) letter.addEventListener("input", updateFinaleRubric);
    var submit = byId("wl-submit-letter");
    if(submit) submit.addEventListener("click", function(){
      var ok = updateFinaleRubric();
      var fb = byId("wl-letter-feedback");
      if(ok){
        setDone("finale:celebration");
        if(fb){ fb.textContent = "The library accepts the letter."; fb.className = "wl-feedback canon-l-feedback ok"; }
        byId("wl-book-returned")?.classList.add("show");
        launchConfetti();
      }else if(fb){
        fb.textContent = "Use 3-5 sentences, one Past Simple memory, one book word, and one conditional.";
        fb.className = "wl-feedback canon-l-feedback err";
      }
    });
    initTimer();
  }
  function initTimer(){
    var btn = byId("wl-timer-btn");
    var count = byId("wl-timer-count");
    if(!btn || !count) return;
    var timer = null;
    btn.addEventListener("click", function(){
      if(timer) return;
      var left = 60;
      btn.disabled = true;
      timer = setInterval(function(){
        left -= 1;
        count.textContent = "00:" + String(left).padStart(2,"0");
        if(left <= 0){
          clearInterval(timer);
          timer = null;
          btn.disabled = false;
          btn.textContent = "Restart";
          count.textContent = "01:00";
          setDone("finale:speak");
        }
      }, 1000);
    });
  }
  function launchConfetti(){
    if(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var canvas = document.createElement("canvas");
    canvas.className = "wl-confetti";
    document.body.appendChild(canvas);
    var ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    var colors = ["#d4a843","#e8c168","#4a9b7a","#c8a8ff","#f3e9d2"];
    var pieces = Array.from({length:90}, function(){
      return {x:Math.random()*canvas.width,y:-20-Math.random()*canvas.height,r:Math.random()*7+3,c:colors[Math.floor(Math.random()*colors.length)],s:Math.random()*3+1,a:Math.random()*6,spin:Math.random()*.2-.1};
    });
    var frame = 0;
    function draw(){
      ctx.clearRect(0,0,canvas.width,canvas.height);
      pieces.forEach(function(p){
        ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.a); ctx.fillStyle = p.c; ctx.fillRect(-p.r,-p.r/2,p.r*2,p.r); ctx.restore();
        p.y += p.s; p.x += Math.sin(frame/18+p.r)*1.2; p.a += p.spin;
      });
      frame += 1;
      if(frame < 210) requestAnimationFrame(draw); else canvas.remove();
    }
    draw();
  }

  function addBilingualLabels(){
    var pairs = [
      [".canon-l-name","LinguaBoost Lab","LinguaBoost Lab"],
      [".canon-l-tag","The Whispering Library · B1","The Whispering Library · B1"],
      [".canon-l-crumbs-link","Lab","Lab"],
      [".canon-l-crumbs-here","The Whispering Library","The Whispering Library"],
      [".wl-tracker-title","Pages found","Pages found"],
      ["#wl-btn-reset","Reset progress","Reset progress"]
    ];
    pairs.forEach(function(row){
      var el = document.querySelector(row[0]);
      if(el){ el.setAttribute("data-ru", row[1]); el.setAttribute("data-en", row[2]); }
    });
    document.querySelectorAll(".wl-pill,.wl-chapter-eyebrow,.wl-finale-eyebrow,.lesson-foot a,.canon-l-footer-nav a").forEach(function(el){
      if(!el.hasAttribute("data-ru")){ el.setAttribute("data-ru", el.textContent.trim()); el.setAttribute("data-en", el.textContent.trim()); }
    });
  }

  var resetBtn = byId("wl-btn-reset");
  if(resetBtn){
    resetBtn.addEventListener("click", function(){
      if(window.confirm("Reset all chapter progress? This cannot be undone.")) window.WL.reset();
    });
  }
  renderChapterOne();
  renderChapterTwo();
  renderChapterThree();
  initFinale();
  addBilingualLabels();
  renderProgress();
  refreshCards();
  updateFinaleRubric();
})();
</script>

