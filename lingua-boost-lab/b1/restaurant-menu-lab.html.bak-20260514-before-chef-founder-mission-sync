  function showDropToast(text, kind, zoneEl) {
    if (zoneEl) {
      const flashClass = kind === 'ok' ? 'flash-ok' : 'flash-err';
      zoneEl.classList.remove('flash-err', 'flash-ok');
      void zoneEl.offsetWidth;
      zoneEl.classList.add(flashClass);
      setTimeout(() => zoneEl && zoneEl.classList.remove(flashClass), 700);
    }
    let toast = document.querySelector('.drop-toast');
    if (toast) toast.remove();
    toast = document.createElement('div');
    toast.className = 'drop-toast' + (kind ? ' ' + kind : '');
    toast.textContent = text;
    document.body.appendChild(toast);
    setTimeout(() => toast && toast.parentNode && toast.remove(), 2200);
  }

  function renderDropzones() {
    for (let cat of Object.keys(menuState)) {
      const container = document.getElementById(`drop-${cat}`);
      const counter   = document.getElementById(`count-${cat}`);
      if (!container) continue;
      const items = menuState[cat];
      container.innerHTML = "";
      // Empty placeholder is rendered via CSS :empty::before / ::after now
      items.forEach(item => {
        const dishDiv = document.createElement("div");
        dishDiv.className = "menu-item";
        dishDiv.innerHTML = `<span>${item}</span><button class="remove-btn" data-cat="${cat}" data-item="${item}">✖</button>`;
        container.appendChild(dishDiv);
      });
      if (counter) counter.textContent = items.length;
    }
    attachRemoveEvents();
    updateSpeakingPreview();
  }

  function attachRemoveEvents() {
    document.querySelectorAll('.remove-btn').forEach(btn => {
      btn.removeEventListener('click', handleRemove);
      btn.addEventListener('click', handleRemove);
    });
  }

  function handleRemove(e) {
    const btn = e.currentTarget;
    const cat = btn.getAttribute('data-cat');
    const itemName = btn.getAttribute('data-item');
    if (cat && menuState[cat]) {
      menuState[cat] = menuState[cat].filter(i => i !== itemName);
      renderDropzones();
      saveProgress();
    }
  }

  function buildDraggablePool() {
    const pool = document.getElementById('draggableContainer');
    pool.innerHTML = '';
    for (let [type, dishes] of Object.entries(extensiveMenu)) {
      dishes.forEach(dish => {
        const dragEl = document.createElement('div');
        dragEl.className = 'drag-item';
        dragEl.setAttribute('data-type', type);
        dragEl.innerText = dish;
        dragEl.setAttribute('draggable', 'true');
        dragEl.addEventListener('dragstart', (e) => {
          e.dataTransfer.setData('text/plain', JSON.stringify({ name: dish, type: type }));
          dragEl.style.opacity = '0.45';
        });
        dragEl.addEventListener('dragend', () => { dragEl.style.opacity = ''; });
        pool.appendChild(dragEl);
      });
    }
  }

  function attachDropZones() {
    document.querySelectorAll('.dropzone').forEach(zone => {
      zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('drag-over'); });
      zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
      zone.addEventListener('drop', (e) => {
        e.preventDefault();
        zone.classList.remove('drag-over');
        let raw;
        try { raw = e.dataTransfer.getData('text/plain'); } catch (err) { raw = ''; }
        if (!raw) return;
        let data;
        try { data = JSON.parse(raw); } catch (err) { return; }
        const expected = zone.id.replace('drop-', '');
        if (data.type !== expected) {
          showDropToast(`This is a ${data.type}, drop into ${data.type.toUpperCase()} instead.`, 'err', zone);
          return;
        }
        if (!menuState[expected].includes(data.name)) {
          menuState[expected].push(data.name);
          renderDropzones();
          saveProgress();
          showDropToast(`Added: ${data.name}`, 'ok', zone);
        } else {
          showDropToast(`${data.name} is already on the menu.`, 'err', zone);
        }
      });
    });
  }

  function updateSpeakingPreview() {
    const node = document.getElementById('liveExampleText');
    if (!node) return;
    const cuisine = (document.getElementById('cuisineInput') || {}).value || 'Mediterranean';
    const pick = (arr) => arr.length ? arr[0] : null;
    const app = pick(menuState.appetizer);
    const soup = pick(menuState.soup);
    const main = pick(menuState.main);
    const side = pick(menuState.side);
    const dessert = pick(menuState.dessert);
    if (!app && !main && !dessert) {
      node.innerHTML = `<em>Drop at least a few dishes into the categories above to generate your example pitch.</em>`;
      return;
    }
    const parts = [];
    parts.push(`Our restaurant focuses on <mark>${cuisine}</mark> cuisine.`);
    if (main) parts.push(`Our signature dish is <mark>${main}</mark> because it shows our style and is memorable to guests.`);
    if (app) parts.push(`As a starter, we serve <mark>${app}</mark>${soup ? `, often paired with <mark>${soup}</mark>` : ''}.`);
    if (main) parts.push(`The main course <mark>${main}</mark> is prepared using high-quality, seasonal ingredients.`);
    parts.push(`We cook it by <mark>slow roasting and careful seasoning</mark>.`);
    parts.push(`It contains ingredients such as <mark>fresh herbs, olive oil and a house sauce</mark>.`);
    if (side) parts.push(`On the side, we offer <mark>${side}</mark> to balance the plate.`);
    if (dessert) parts.push(`To finish, we recommend <mark>${dessert}</mark>.`);
    parts.push(`Thank you for listening.`);
    node.innerHTML = parts.join(' ');
  }

  function attachSpeechChips() {
    document.querySelectorAll('.speech-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const ta = document.getElementById('speechDraft');
        if (!ta) return;
        const text = chip.getAttribute('data-starter') || chip.textContent;
        ta.value = (ta.value ? ta.value.trimEnd() + ' ' : '') + text + ' ';
        ta.focus();
      });
    });
  }

  function attachCuisinePills() {
    document.querySelectorAll('.cuisine-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        document.querySelectorAll('.cuisine-pill').forEach(p => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        const c = pill.getAttribute('data-cuisine');
        const inp = document.getElementById('cuisineInput');
        if (inp) inp.value = c;
        updateSpeakingPreview();
      });
    });
    const refresh = document.getElementById('updateMenuPreview');
    if (refresh) refresh.addEventListener('click', updateSpeakingPreview);
    const copyBtn = document.getElementById('copyExampleBtn');
    if (copyBtn) copyBtn.addEventListener('click', () => {
      const ex = document.getElementById('liveExampleText');
      const ta = document.getElementById('speechDraft');
      if (ex && ta) ta.value = ex.innerText;
    });
  }

  // Speaking timer (counts down 2 minutes)
  let timerInterval = null, timerSeconds = 120;
  function fmtTime(s){ const m = Math.floor(s/60).toString().padStart(2,'0'); const sec=(s%60).toString().padStart(2,'0'); return `${m}:${sec}`; }
  function attachSpeakingTimer() {
    const display = document.getElementById('speakingTimer');
    const start = document.getElementById('startTimerBtn');
    const reset = document.getElementById('resetTimerBtn');
    if (!display || !start || !reset) return;
    timerSeconds = 120;
    display.textContent = fmtTime(timerSeconds);
    start.addEventListener('click', () => {
      if (timerInterval) return;
      timerInterval = setInterval(() => {
        timerSeconds--;
        display.textContent = fmtTime(Math.max(0, timerSeconds));
        if (timerSeconds <= 0) { clearInterval(timerInterval); timerInterval = null; display.textContent = '00:00'; }
      }, 1000);
    });
    reset.addEventListener('click', () => {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = null;
      timerSeconds = 120;
      display.textContent = fmtTime(timerSeconds);
    });
  }

  // Rubric scoring
  function attachRubric() {
    const calc = document.getElementById('calcRubricBtn');
    const reset = document.getElementById('resetRubricBtn');
    const display = document.getElementById('totalScoreRubricDisplay');
    const note = document.getElementById('rubricLiveNote');
    if (!calc || !display) return;
    function computeTotal() {
      let total = 0;
      const groups = ['taskComp1','taskComp2','taskComp3','taskComp4','startersScore','grammarScore','fluencyScore'];
      groups.forEach(g => {
        const sel = document.querySelector(`input[name="${g}"]:checked`);
        if (sel) total += parseInt(sel.value, 10) || 0;
      });
      return total;
    }
    function updateRubricFeedback() {
      const total = computeTotal();
      display.textContent = `Total: ${total} / 20`;
      document.querySelectorAll('.rubric-section input[type="radio"]').forEach(input => {
        const row = input.closest('tr');
        if (!row) return;
        const selected = row.querySelector('input[type="radio"]:checked');
        row.classList.toggle('is-scored', !!selected && Number(selected.value) > 0);
        row.classList.toggle('is-missing', !!selected && Number(selected.value) === 0);
      });
      if (note) {
        note.textContent = total >= 15
          ? 'Strong pitch range. Keep the structure and add one concrete reason for the signature dish.'
          : total >= 9
            ? 'Good draft range. Check the missing starters and add clearer menu reasons.'
            : 'Build the pitch step by step: cuisine, signature dish, starter, main, side, dessert, closing.';
      }
    }
    document.querySelectorAll('.rubric-section input[type="radio"]').forEach(input => {
      input.addEventListener('change', updateRubricFeedback);
    });
    calc.addEventListener('click', () => {
      updateRubricFeedback();
      display.classList.remove('flash'); void display.offsetWidth; display.classList.add('flash');
    });
    if (reset) reset.addEventListener('click', () => {
      document.querySelectorAll('.rubric-section input[type="radio"]').forEach(r => { r.checked = false; });
      document.querySelectorAll('.rubric-section tr').forEach(row => row.classList.remove('is-scored', 'is-missing'));
      const sn = document.getElementById('studentNameRubric'); if (sn) sn.value = '';
      const s1 = document.getElementById('strengthsField'); if (s1) s1.value = '';
      const s2 = document.getElementById('improveField'); if (s2) s2.value = '';
      display.textContent = 'Total: — / 20';
      if (note) note.textContent = 'Select rubric points to see live row feedback.';
    });
  }

  function initRestaurantInteractions() {
    buildDraggablePool();
    attachDropZones();
    renderDropzones();
    attachSpeechChips();
    attachCuisinePills();
    attachSpeakingTimer();
    attachRubric();
    const resetBtn = document.getElementById('resetMenuBtn');
    if (resetBtn) resetBtn.addEventListener('click', () => {
      menuState = { appetizer: [], soup: [], main: [], side: [], dessert: [] };
      renderDropzones();
      updateSpeakingPreview();
      saveProgress();
    });
    const cuisineInp = document.getElementById('cuisineInput');
    if (cuisineInp) cuisineInp.addEventListener('input', updateSpeakingPreview);
    const resetAll = document.getElementById('resetAllBtn');
    if (resetAll) resetAll.addEventListener('click', () => {
      if (!confirm('Reset all progress?')) return;
      localStorage.removeItem('restaurantMenuProgress_RoseGold');
      activityCompleted = false;
      menuState = { appetizer: [], soup: [], main: [], side: [], dessert: [] };
      renderRestaurantBlock(document.getElementById('activities-container'));
      updateProgress();
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadProgress();
    const container = document.getElementById('activities-container');
    if (container) renderRestaurantBlock(container);
    updateProgress();
  });
</script>
