<script>
  // ========== RESTAURANT CONTENT (exactly from original) ==========
  const extensiveMenu = {
    appetizer: ["Bruschetta", "Spring Rolls", "Stuffed Mushrooms", "Fried Calamari", "Hummus & Pita", "Caprese Salad", "Shrimp Cocktail", "Spinach Artichoke Dip", "Carpaccio", "Nachos", "Summer Rolls", "Fried Zucchini", "Deviled Eggs", "Prawn Toast", "Meatballs Marinara"],
    soup: ["Tomato Basil Soup", "French Onion Soup", "Miso Soup", "Pumpkin Cream", "Lentil Soup", "Minestrone", "Chicken Noodle Soup", "Tom Yum", "Corn Chowder", "Borscht", "Gazpacho", "Cream of Mushroom", "Clam Chowder", "Thai Coconut Soup", "Wonton Soup"],
    main: ["Grilled Salmon", "Beef Lasagna", "Chicken Tikka Masala", "Mushroom Risotto", "Eggplant Parmigiana", "Lamb Chops", "Steak Frites", "Pad Thai", "Duck Confit", "Seafood Paella", "Vegetable Curry", "Pork Belly", "Margherita Pizza", "BBQ Ribs", "Stuffed Bell Peppers", "Fish & Chips", "Beef Bourguignon"],
    side: ["Garlic Bread", "Roasted Vegetables", "French Fries", "Quinoa Salad", "Coleslaw", "Steamed Broccoli", "Mashed Potatoes", "Rice Pilaf", "Grilled Asparagus", "Onion Rings", "Sweet Potato Wedges", "Cucumber Salad", "Baked Beans", "Polenta", "Sautéed Spinach", "Fruit Salsa"],
    dessert: ["Tiramisu", "Cheesecake", "Chocolate Lava Cake", "Gelato", "Apple Pie", "Crème Brûlée", "Panna Cotta", "Brownie Sundae", "Mango Sticky Rice", "Lemon Tart", "Fruit Sorbet", "Baklava", "Churros", "Molten Chocolate Cake", "Berry Pavlova", "Affogato"]
  };

  let menuState = { appetizer: [], soup: [], main: [], side: [], dessert: [] };
  let activityCompleted = false;

  function updateProgress() {
    const fill = document.getElementById('progressFill');
    if (fill) fill.style.width = activityCompleted ? '100%' : '0%';
    const text = document.getElementById('progressText');
    if (text) text.innerHTML = activityCompleted ? '1 / 1 block' : '0 / 1 block';
  }

  function saveProgress() {
    localStorage.setItem('restaurantMenuProgress_RoseGold', JSON.stringify({ completed: activityCompleted, menu: menuState }));
  }

  function loadProgress() {
    const saved = localStorage.getItem('restaurantMenuProgress_RoseGold');
    if (saved) {
      const data = JSON.parse(saved);
      activityCompleted = data.completed || false;
      if (data.menu) menuState = data.menu;
      updateProgress();
    }
  }

  function renderRestaurantBlock(container) {
    container.innerHTML = `
      <section id="menuWorkshop" class="round-card${activityCompleted ? ' is-done' : ''}" aria-labelledby="menu-workshop-title">
        <div class="round-header"><span class="round-title" id="menu-workshop-title">Restaurant Menu Workshop</span><span class="round-badge${activityCompleted ? ' is-done' : ''}">${activityCompleted ? '✓ Completed' : 'Pending'}</span><span class="round-score">${activityCompleted ? '★' : '○'}</span></div>
        <div class="round-body">
          <div class="menu-workshop">
            <div class="workshop-title">FLAVOR LIBRARY · 45+ ITEMS <span class="badge">drag into any category</span></div>
            <div id="draggableContainer" class="ingredient-pool"></div>
            <div class="menu-grid">
              <div class="menu-category" data-category="appetizer">
                <div class="cat-thumb"><img src="../../assets/%D0%94%D0%BB%D1%8F%20%D1%83%D1%80%D0%BE%D0%BA%D0%BE%D0%B2/Menu/plate.png" alt="Appetizer"></div>
                <h3>APPETIZER <span class="h-count" id="count-appetizer">0</span></h3>
                <div class="dropzone" id="drop-appetizer"></div>
              </div>
              <div class="menu-category" data-category="soup">
                <div class="cat-thumb"><img src="../../assets/%D0%94%D0%BB%D1%8F%20%D1%83%D1%80%D0%BE%D0%BA%D0%BE%D0%B2/Menu/%D1%81%D1%83%D0%BF.png" alt="Soup"></div>
                <h3>SOUP <span class="h-count" id="count-soup">0</span></h3>
                <div class="dropzone" id="drop-soup"></div>
              </div>
              <div class="menu-category" data-category="main">
                <div class="cat-thumb"><img src="../../assets/%D0%94%D0%BB%D1%8F%20%D1%83%D1%80%D0%BE%D0%BA%D0%BE%D0%B2/Menu/%D0%B0%D0%B0%D0%BF%D0%B0%D0%BF.png" alt="Main course"></div>
                <h3>MAIN COURSE <span class="h-count" id="count-main">0</span></h3>
                <div class="dropzone" id="drop-main"></div>
              </div>
              <div class="menu-category" data-category="side">
                <div class="cat-thumb"><img src="../../assets/%D0%94%D0%BB%D1%8F%20%D1%83%D1%80%D0%BE%D0%BA%D0%BE%D0%B2/Menu/gdgdg.png" alt="Side dish"></div>
                <h3>SIDE DISH <span class="h-count" id="count-side">0</span></h3>
                <div class="dropzone" id="drop-side"></div>
              </div>
              <div class="menu-category" data-category="dessert">
                <div class="cat-thumb"><img src="../../assets/%D0%94%D0%BB%D1%8F%20%D1%83%D1%80%D0%BE%D0%BA%D0%BE%D0%B2/Menu/%D0%BF%D1%80%D0%BE%D1%80%D0%BF%D0%BE.png" alt="Cheesecake dessert"></div>
                <h3>DESSERT <span class="h-count" id="count-dessert">0</span></h3>
                <div class="dropzone" id="drop-dessert"></div>
              </div>
              <div class="chef-tip" role="note">
                <img src="../../assets/%D0%94%D0%BB%D1%8F%20%D1%83%D1%80%D0%BE%D0%BA%D0%BE%D0%B2/Menu/9241a7cc-12a5-4041-8f74-6ab0e63cc275.png"
                     alt="Chef tip — balance flavors, colors and textures"
                     class="chef-tip-img">
              </div>
            </div>
            <button id="resetMenuBtn" class="reset-menu-btn">Reset menu</button>
            <div style="font-size:0.75rem; margin-top:16px;">You can add multiple dishes per category. Click ✖ to remove.</div>
          </div>

          <section class="speaking-card" style="margin-top:36px;" aria-labelledby="menu-pitch-title">
            <h2 class="canon-l-section-title" id="menu-pitch-title"><span class="canon-l-section-num">02</span><span class="canon-l-section-name">Chef's Presentation · Menu Pitch</span></h2>

            <div class="mission-card">
              <h3>Your Mission</h3>
              <p><strong>You are the chef-founder of a new restaurant.</strong> You are presenting your menu to a potential business partner. Your goal is to sound clear, confident and persuasive.</p>
              <p style="margin-top:8px;">Speak for <strong>1.5–2 minutes</strong>. Use the menu you built above and include all required sentence starters.</p>
            </div>

            <div class="sentence-starters">
              <strong>REQUIRED SENTENCE STARTERS — click a chip to add it to your draft:</strong>
              <div class="speech-chip-grid">
                <button class="speech-chip" data-starter="Our restaurant focuses on Mediterranean cuisine.">Our restaurant focuses on ...</button>
                <button class="speech-chip" data-starter="Our signature dish is chef's special because it is fresh and memorable.">Our signature dish is ... because ...</button>
                <button class="speech-chip" data-starter="As a starter, we serve bruschetta.">As a starter, we serve ...</button>
                <button class="speech-chip" data-starter="The main course is prepared using high-quality ingredients.">The main course is prepared using ...</button>
                <button class="speech-chip" data-starter="We cook it by slow roasting and careful seasoning.">We cook it by ...</button>
                <button class="speech-chip" data-starter="It contains ingredients such as herbs, spices and a house sauce.">It contains ingredients such as ...</button>
              </div>
              <textarea id="speechDraft" class="speech-draft" placeholder="Click sentence starters above, then edit your speech here..."></textarea>
            </div>

            <div style="background: #fef3e8; border-radius: 32px; padding: 16px 22px; margin-bottom: 20px;">
              <strong>Cuisine style:</strong>
