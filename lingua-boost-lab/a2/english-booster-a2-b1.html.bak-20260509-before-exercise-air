<main class="wrap">
  <section class="hero-banner" id="heroBanner">
    <img src="../../assets/%D0%94%D0%BB%D1%8F%20%D1%83%D1%80%D0%BE%D0%BA%D0%BE%D0%B2/Baby/6bf443b3-5d26-4904-a20c-0d9177c5c175.png"
         alt="English Booster A2 to B1 — tenses overview"
         class="hero-banner-img"
         onload="this.parentElement.classList.add('has-img')"
         onerror="this.style.display='none'">
    <div class="hero-banner-overlay">
      <div class="hero-banner-content">
        <div class="hero-eyebrow">Grammar &amp; Vocabulary · 10 Blocks</div>
        <h1 class="hero-title">English Booster<br><em>A2 → B1</em></h1>
