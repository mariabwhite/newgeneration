<script>
// 10 БЛОКОВ – каждый содержит 5–8 заданий + личные вопросы + флеш-карточки.
// banner: путь к иллюстрации, рендерится перед карточкой блока (если задан).
const BABY = "../../assets/%D0%94%D0%BB%D1%8F%20%D1%83%D1%80%D0%BE%D0%BA%D0%BE%D0%B2/Baby";

const blocksData = [
  { // 1 Basic Tenses – 5 заданий
    name: "1. Basic Tenses · Present Simple / Cont / Future",
    tasks: [
      { type: "choice", text: "Too many repetitive tasks ______ me feel tired today.", options: ["are making", "make", "is making"], correct: "are making" },
      { type: "choice", text: "Right now, I ______ my schedule.", options: ["am checking", "check", "will check"], correct: "am checking" },
      { type: "choice", text: "Next month our company ______ a corporate event.", options: ["will organize", "organizes", "is organizing"], correct: "will organize" },
      { type: "gap", text: "This week I ______ on several projects. (use Present Continuous)", correct: "am working" },
      { type: "gap", text: "A clear routine ______ me keep a clear mind. (help / third person)", correct: "helps" }
    ],
    personal: ["What usually helps you stay calm when work gets chaotic?", "Are you working on anything important this week?", "What will you change in your daily routine next month?"],
    flash: [
      { front: "What helps you stay calm at work?", back: "Present Simple · I check my schedule every morning." },
      { front: "What are you doing right now?", back: "Present Continuous · Right now I am working." },
      { front: "What will you do tomorrow?", back: "Future Simple · I will organise my tasks." }
    ]
  },
  { // 2 Perfect Tenses – 6 заданий
    name: "2. Perfect Tenses",
    banner: `${BABY}/2cee24c4-2f0c-4bd0-a5d7-d7bcf12e76ea.png`,
    tasks: [
      { type: "choice", text: "I ______ my daily routine recently.", options: ["have changed", "has changed", "changed"], correct: "have changed" },
      { type: "choice", text: "Our team ______ the quality this month.", options: ["has been improving", "have improved", "is improving"], correct: "has been improving" },
      { type: "choice", text: "Before the meeting started, I ______ my schedule.", options: ["had checked", "have checked", "checked"], correct: "had checked" },
      { type: "gap", text: "I ______ overwhelmed this week. (Present Perfect Continuous)", correct: "have been feeling" },
      { type: "gap", text: "She ______ already ______ her homework. (Present Perfect, do)", correct: "has done" },
      { type: "gap", text: "They ______ (live) in London since 2020.", correct: "have lived" }
    ],
    personal: ["What have you changed in your work routine recently?", "Have you been feeling overwhelmed this week?", "What skill have you improved this month?"],
    flash: [
      { front: "What have you changed recently?", back: "Present Perfect · I have changed my daily routine." },
      { front: "How have you been feeling lately?", back: "Present Perfect Continuous · I have been feeling overwhelmed." },
      { front: "What had you done before the meeting?", back: "Past Perfect · I had checked my schedule." }
    ]
  },
  { // 3 Past Simple/Continuous – 6 заданий
    name: "3. Past Simple / Past Continuous",
    banner: `${BABY}/c51fc7dc-9102-4726-82a1-973dc0e5c5e4.png`,
    tasks: [
      { type: "choice", text: "While I was checking my schedule, my colleague ______ problems.", options: ["solved", "was solving", "solve"], correct: "solved" },
      { type: "choice", text: "Yesterday I ______ tired after work.", options: ["felt", "was feeling", "feel"], correct: "felt" },
      { type: "choice", text: "When the phone rang, we ______ a difficult problem.", options: ["were solving", "solved", "solve"], correct: "were solving" },
      { type: "gap", text: "During the meeting, I ______ on current projects. (past continuous)", correct: "was working" },
      { type: "gap", text: "She ______ (read) a book when I came in.", correct: "was reading" },
      { type: "gap", text: "They ______ (not / see) the accident yesterday.", correct: "did not see" }
    ],
    personal: ["What were you doing when you received important news?", "Did you feel stressed last week? What helped?", "What mistake did you make at work and what did you learn?"],
    flash: [
      { front: "What did you do yesterday?", back: "Past Simple · I felt tired after work." },
      { front: "What were you doing when interrupted?", back: "Past Continuous · I was checking my schedule." }
    ]
  },
  { // 4 Passive Voice – 5 заданий
    name: "4. Passive Voice",
    tasks: [
      { type: "choice", text: "Useful information ______ for clients every day.", options: ["is provided", "provides", "was provided"], correct: "is provided" },
      { type: "choice", text: "New assistants ______ last month.", options: ["were hired", "are hired", "hired"], correct: "were hired" },
      { type: "gap", text: "Stress management ______ in many companies now. (Present Passive)", correct: "is taught" },
      { type: "gap", text: "The report ______ (finish) by 5 pm yesterday.", correct: "was finished" },
      { type: "gap", text: "More attention ______ (should / give) to this issue.", correct: "should be given" }
    ],
