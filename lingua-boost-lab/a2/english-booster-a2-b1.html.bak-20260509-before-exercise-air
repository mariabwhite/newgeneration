<!DOCTYPE html>
<html lang="en" data-theme="salad">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>English Booster · A2 → B1 · LinguaBoost Lab</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;800;900&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
/* ========== САЛАТОВАЯ ДИЗАЙН-СИСТЕМА ========== */
[data-theme="salad"] {
  --bg: #f5fae8;
  --bg-2: #eaf5df;
  --card: #ffffff;
  --card-2: #fafff2;
  --text: #1f2c15;
  --muted: #4d6440;
  --faint: #6f8f58;
  --accent: #6fbf4c;
  --accent-2: #88d162;
  --accent-on: #f7fff0;
  --brand: #55923b;
  --brand-2: #3b6e27;
  --line: rgba(85,146,59,0.12);
  --line-2: rgba(85,146,59,0.20);
  --line-dot: rgba(85,146,59,0.30);
  --soft: rgba(111,191,76,0.06);
  --ok: #2f7d52;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  min-height: 100vh;
  font-family: 'Manrope', system-ui, sans-serif;
  color: var(--text);
  background: var(--bg);
}
h1, h2, h3, h4, p { margin: 0; }
button, input { font: inherit; }
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; }

/* ── TOPBAR (Easter geometry) ──────────────── */
.topbar{
  position: sticky; top: 0; z-index: 100;
  display: flex; align-items: center; gap: 16px;
  padding: 10px clamp(16px, 3vw, 28px);
  background: color-mix(in srgb, var(--bg) 88%, transparent);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  min-height: 56px;
}
.brand{ display: flex; align-items: center; gap: 12px; }
.brand-mark{
  width: 36px; height: 36px;
  border: 1px solid var(--line-2); border-radius: 8px;
  background: var(--soft);
  display: grid; place-items: center;
  position: relative;
  font-family: 'Unbounded', sans-serif;
  font-size: 20px; font-weight: 900;
  line-height: 1;
  color: var(--accent);
  letter-spacing: 0;
}
.brand-mark::after{
  content: ''; position: absolute;
  right: 4px; bottom: 4px;
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--brand);
}
.brand-copy{ display: grid; gap: 2px; }
.brand-name{
  font-family: 'Unbounded', sans-serif;
  font-size: 14px; font-weight: 800; letter-spacing: -0.02em;
  line-height: 1; color: var(--text);
}
.brand-tag{
  font-family: monospace;
  font-size: 9px; font-weight: 700;
  letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--faint);
}
.topbar-nav{
  display: flex; gap: clamp(12px, 2vw, 22px);
  margin-left: 12px; flex-wrap: wrap;
}
.top-link{
  font-family: monospace;
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.18s;
  cursor: pointer;
}
.top-link:hover, .top-link.active{ color: var(--accent); }
.topbar-tools{ margin-left: auto; display: flex; gap: 8px; align-items: center; }
.btn-tool{
  height: 32px; min-width: 38px; padding: 0 12px;
  border: 1px solid var(--line-2); border-radius: 8px;
  background: var(--card); color: var(--muted);
  font: 700 11px/1 monospace; letter-spacing: 0.08em;
  cursor: pointer;
  display: inline-grid; place-items: center;
  transition: all 0.16s;
  text-decoration: none;
}
.btn-tool:hover{ border-color: var(--accent); color: var(--accent); }
.wrap { max-width: 1280px; margin: 0 auto; padding: 32px 32px 80px; }

/* ── HERO BANNER (China + Pink pattern) ─────── */
.hero-banner{
  position: relative;
  border-radius: 32px;
  overflow: hidden;
  margin-bottom: 24px;
  border: 1px solid var(--line);
  background: linear-gradient(135deg, var(--card-2), var(--bg-2));
  min-height: 380px;
}
.hero-banner.has-img{
  aspect-ratio: 1672/941;
  min-height: 420px;
}
.hero-banner-img{
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover; object-position: right center;
  display: block; z-index: 0;
}
.hero-banner-overlay{
  position: relative; z-index: 2;
  padding: clamp(28px, 4vw, 56px);
  display: flex; align-items: center;
  min-height: inherit;
}
.hero-banner.has-img .hero-banner-overlay{
  position: absolute; inset: 0;
  /* Neutral white overlay — image keeps its natural colours */
  background: linear-gradient(to right,
    rgba(255, 255, 255, 0.78) 0%,
    rgba(255, 255, 255, 0.55) 28%,
    rgba(255, 255, 255, 0.20) 48%,
    rgba(255, 255, 255, 0.0) 58%);
}
.hero-banner::after{
  content: "";
  position: absolute;
  right: clamp(24px, 5vw, 80px); top: 50%;
  transform: translateY(-50%);
  font-size: clamp(3rem, 8vw, 6.5rem);
  opacity: 0.55;
  filter: drop-shadow(0 4px 8px rgba(85,146,59,0.18));
  pointer-events: none;
}
.hero-banner.has-img::after{ display: none; }
.hero-banner-content{ max-width: 540px; }

.hero-eyebrow { font-family: monospace; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 20px; }
.hero-title { font-family: 'Unbounded', sans-serif; font-size: clamp(2.2rem, 5vw, 4.2rem); line-height: 0.96; letter-spacing: -0.04em; margin-bottom: 20px; text-shadow: 0 1px 0 rgba(255,255,255,.4); }
.hero-title em { font-style: normal; color: var(--accent); }
.hero-lead { color: var(--muted); font-size: 17px; line-height: 1.6; margin-bottom: 24px; }
.hero-meta{ display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
.hero-actions{ display: flex; flex-wrap: wrap; gap: 10px; }

.meta-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: rgba(255,255,255,.85);
  border: 1px solid var(--line-2);
  border-radius: 40px;
  font-family: monospace;
  font-size: 10px;
  font-weight: 700;
  color: var(--accent);
  backdrop-filter: blur(2px);
}
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 22px;
  border-radius: 12px;
  font-family: monospace;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  cursor: pointer;
  border: none;
  text-decoration: none;
}
.btn.primary { background: var(--accent); color: white; box-shadow: 0 8px 20px rgba(111,191,76,0.25); }
.btn.primary:hover { background: var(--accent-2); transform: translateY(-2px); }
.btn.ghost { background: transparent; border: 1px solid var(--line-2); color: var(--text); }
.btn.ghost:hover { border-color: var(--accent); color: var(--accent); }

@media (max-width: 820px) {
  .hero-banner{ aspect-ratio: auto; min-height: 360px; }
  .hero-banner.has-img{ aspect-ratio: auto; min-height: 360px; }
  .hero-banner.has-img .hero-banner-overlay{
    background: linear-gradient(to bottom,
      rgba(255, 255, 255, 0.92) 0%,
      rgba(255, 255, 255, 0.72) 50%,
      rgba(255, 255, 255, 0.25) 75%,
      rgba(255, 255, 255, 0.0) 95%);
    align-items: flex-start;
  }
}

/* ── LESSON ILLUSTRATION POSTER ─────────────── */
.lesson-illustration{
  width: 100%;
  margin: 0 0 14px;
  border-radius: 24px;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,0.06);
  background: transparent;
  box-shadow: 0 6px 14px rgba(0,0,0,0.08);
}
.lesson-illustration img{
  width: 100%; height: auto; display: block;
}

.step-tracker {
  background: white;
  border-radius: 60px;
  padding: 12px 24px;
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 20px;
  border: 1px solid var(--line);
}
.step-count{ font-family: monospace; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brand-2); }
.step-track { flex: 1; height: 6px; background: #e2ebd6; border-radius: 6px; overflow: hidden; }
.step-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--accent), var(--accent-2)); border-radius: 6px; transition: width 0.3s; }
.step-name{ font-family: monospace; font-size: 11px; font-weight: 700; color: var(--muted); }

.round-card {
  background: white;
  border-radius: 24px;
  margin-bottom: 20px;
  border: 1px solid var(--line);
}
.round-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 24px;
  background: var(--card-2);
  border-bottom: 1px solid var(--line);
  border-radius: 24px 24px 0 0;
}
.round-title { font-family: 'Unbounded', sans-serif; font-size: 18px; font-weight: 800; }
.round-badge { font-family: monospace; font-size: 11px; font-weight: 700; padding: 4px 12px; border-radius: 40px; background: #e2ebd6; }
.round-score { font-family: monospace; font-size: 12px; font-weight: 700; color: var(--accent); }
.round-body { padding: 24px; }
.practice-list { display: grid; gap: 20px; }
.practice-item {
  display: grid;
  grid-template-columns: 36px 1fr auto;
  gap: 16px;
  align-items: start;
  padding: 16px 20px;
  background: var(--card-2);
  border-radius: 20px;
  border: 1px solid var(--line);
}
.practice-num { font-family: monospace; font-size: 13px; font-weight: 800; color: var(--accent); }
.practice-q { font-size: 15px; line-height: 1.5; }
.choice-row { display: flex; gap: 10px; flex-wrap: wrap; }
.choice {
  border: 1px solid var(--line-2);
  border-radius: 40px;
  padding: 8px 18px;
  background: white;
  cursor: pointer;
  font-family: monospace;
  font-size: 11px;
  font-weight: 700;
}
.choice:hover, .choice.is-picked { border-color: var(--accent); color: var(--accent); background: var(--soft); }
.practice-hint {
  border: 1px dashed var(--line-2);
  background: transparent;
  border-radius: 40px;
  padding: 6px 14px;
  font-family: monospace;
  font-size: 10px;
  cursor: pointer;
  width: fit-content;
}
.blank {
  padding: 8px 16px;
  border-radius: 40px;
  border: 1px solid var(--line-2);
  background: white;
  min-width: 180px;
}
.flash-grid { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
.flash-card {
  background: var(--card);
  border: 1px solid var(--accent);
  border-radius: 20px;
  padding: 12px 18px;
  cursor: pointer;
  text-align: center;
  flex: 1 0 160px;
}
.flash-card:hover { background: var(--soft); }
.flash-front, .flash-back { font-family: monospace; font-size: 12px; }
.flash-back { display: none; margin-top: 8px; color: var(--accent); }
.flash-card.flipped .flash-front { display: none; }
.flash-card.flipped .flash-back { display: block; }
.julia-ask {
  background: var(--bg-2);
  border-radius: 28px;
  padding: 16px 20px;
  margin-top: 20px;
}
.julia-name { font-weight: 800; color: var(--accent); margin-bottom: 12px; }
.question-list { padding-left: 20px; margin: 0; }
.question-list li { margin-bottom: 8px; }

/* Inline check feedback in place of alert */
.block-warning{
  margin-top: 12px;
  padding: 10px 16px;
  border-radius: 18px;
  background: #ffe9d8;
  border: 1px solid #f4b88a;
  color: #8a3c1c;
  font-family: monospace; font-size: 12px; font-weight: 700;
  display: none;
}
.block-warning.show{ display: block; }

.lesson-foot{
  display: flex; flex-wrap: wrap; gap: 14px;
  margin-top: 36px;
}
.foot-link{
  flex: 1 1 200px;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: white;
  text-align: center;
  font-family: 'Unbounded', sans-serif; font-weight: 700; font-size: 14px;
  color: var(--brand-2);
  text-decoration: none;
  transition: 0.15s;
}
.foot-link:hover{ background: var(--accent); color: white; border-color: var(--accent); }

.foot-note { text-align: center; margin-top: 24px; font-family: monospace; font-size: 10px; color: var(--faint); letter-spacing: 0.06em; }
@media (max-width: 820px) {
  .practice-item { grid-template-columns: 28px 1fr; }
  .topbar{ padding: 8px 14px; gap: 10px; }
  .topbar-nav{ display: none; }
  .wrap{ padding: 20px 16px 60px; }
}

/* Codex stylefix: Easter typography geometry + thematic pictorial badges */
.brand-mark img,.lab-mark img,.topbar-badge-img{
  width:26px;height:26px;display:block;object-fit:contain;border-radius:6px;
}
.brand-mark,.lab-mark{
  overflow:hidden;flex:0 0 auto;
}
.lab-hero-visual{
  background:linear-gradient(135deg,color-mix(in srgb,var(--accent3,var(--accent)) 32%,#fff),color-mix(in srgb,var(--accent2,var(--accent)) 72%,#fff)) !important;
}
.lab-hero-visual img{
  width:76px;height:76px;object-fit:contain;filter:drop-shadow(0 8px 14px rgba(0,0,0,.16));
}
.topbar-brand.with-badge,.brand.with-badge{
  display:inline-flex;align-items:center;gap:10px;
}
.topbar-brand.with-badge::before,.brand.with-badge::before{
  content:"";width:34px;height:34px;display:inline-block;border-radius:8px;
  background:var(--lesson-badge) center/26px 26px no-repeat,var(--accent2,var(--accent));
  box-shadow:0 2px 8px rgba(0,0,0,.12);flex:0 0 auto;
}
.lesson-hero-title{
  font-family:var(--display,'Nunito',ui-sans-serif,system-ui,sans-serif) !important;
  font-size:clamp(2.05rem,5vw,4.25rem) !important;
  line-height:.96 !important;letter-spacing:0 !important;margin:0 0 18px !important;
}
.lesson-hero-title em{font-style:normal;color:var(--accent2,var(--accent));}
.lesson-hero-lead{max-width:760px;font-size:clamp(15px,1.4vw,17px)!important;line-height:1.7!important;color:var(--muted);}
</style>

