let completedBlocks = new Array(10).fill(false);
let blockScores = new Array(10).fill(0);

function loadProgress() {
  try {
    const saved = localStorage.getItem("englishBoosterA2B1");
    if (saved) {
      const data = JSON.parse(saved);
      if (Array.isArray(data.completed)) completedBlocks = data.completed;
      if (Array.isArray(data.scores))    blockScores    = data.scores;
    }
  } catch(_) {}
}
function saveProgress() {
  try { localStorage.setItem("englishBoosterA2B1", JSON.stringify({ completed: completedBlocks, scores: blockScores })); } catch(_) {}
}
function updateProgress() {
  const done = completedBlocks.filter(v => v === true).length;
  const pf = document.getElementById('progressFill');
  const pt = document.getElementById('progressText');
  if (pf) pf.style.width = `${(done/10)*100}%`;
  if (pt) pt.innerHTML = `${done} / 10 blocks`;
}
function completeBlock(idx) {
  if (!completedBlocks[idx]) {
    completedBlocks[idx] = true;
    saveProgress();
    updateProgress();
    renderBlocks();
  }
}

function renderBlocks() {
  const container = document.getElementById('blocksContainer');
  if (!container) return;
  container.innerHTML = '';
  blocksData.forEach((block, idx) => {
    // Poster (if banner present)
    if (block.banner) {
      const poster = document.createElement('div');
      poster.className = 'lesson-illustration';
      poster.innerHTML = `<img src="${block.banner}" alt="${block.name}" loading="lazy" onerror="this.closest('.lesson-illustration').remove()">`;
      container.appendChild(poster);
    }
    // Block card
    const roundDiv = document.createElement('div');
    roundDiv.className = 'round-card';
    roundDiv.id = `block${idx+1}`;
    roundDiv.innerHTML = `
      <div class="round-header">
        <span class="round-title">${block.name}</span>
        <span class="round-badge">${completedBlocks[idx] ? '✓ Complete' : `${blockScores[idx] || 0}/${block.tasks.length} tasks`}</span>
        <span class="round-score">${completedBlocks[idx] ? '★' : '○'}</span>
      </div>
      <div class="round-body">
        <div class="practice-list" id="tasks-${idx}"></div>
        ${!completedBlocks[idx] ? `<button class="btn ghost check-block" data-block="${idx}" style="margin-top:20px;">✓ Check block</button>` : '<span style="color:var(--ok);">✅ Block completed</span>'}
        <div class="block-warning" id="warn-${idx}"></div>
      </div>
    `;
    container.appendChild(roundDiv);
    renderTasks(idx);
  });
  attachEvents();
}

function renderTasks(blockIdx) {
  const block = blocksData[blockIdx];
  const container = document.getElementById(`tasks-${blockIdx}`);
  if (!container) return;
  container.innerHTML = '';
  block.tasks.forEach((task, tIdx) => {
    const item = document.createElement('div');
    item.className = 'practice-item';
    let inputHtml = '';
    if (task.type === 'choice') {
      inputHtml = `<div class="choice-row">${task.options.map((opt) => `<button class="choice" data-correct="${opt === task.correct ? 'true' : 'false'}" data-task="${blockIdx}-${tIdx}">${opt}</button>`).join('')}</div>`;
    } else if (task.type === 'gap' || task.type === 'match-word') {
      inputHtml = `<input type="text" class="blank" data-gap data-correct="${task.correct}" data-task="${blockIdx}-${tIdx}" placeholder="type answer">`;
    }
    item.innerHTML = `<span class="practice-num">${tIdx+1}</span><span class="practice-q">${task.text}</span><div style="display:flex; flex-direction:column; gap:8px;">${inputHtml}<button class="practice-hint">💡 Hint</button></div>`;
    container.appendChild(item);
  });
  // personal questions
  const personalDiv = document.createElement('div');
  personalDiv.className = 'julia-ask';
  personalDiv.innerHTML = `<div class="julia-name">🌸 Julia asks you:</div><ul class="question-list">${block.personal.map(q => `<li>💬 ${q}</li>`).join('')}</ul>`;
  container.appendChild(personalDiv);
  // flash cards
  const flashDiv = document.createElement('div');
  flashDiv.innerHTML = `<div style="margin-top:20px; font-weight:700;">🃏 Flash cards (click to flip)</div><div class="flash-grid">${block.flash.map(f => `<div class="flash-card"><div class="flash-front">${f.front}</div><div class="flash-back">${f.back}</div></div>`).join('')}</div>`;
  container.appendChild(flashDiv);
  flashDiv.querySelectorAll('.flash-card').forEach(card => {
    card.addEventListener('click', () => card.classList.toggle('flipped'));
  });
}

function attachEvents() {
  document.querySelectorAll('.choice').forEach(btn => {
    btn.removeEventListener('click', choiceHandler);
    btn.addEventListener('click', choiceHandler);
  });
  document.querySelectorAll('.blank[data-gap]').forEach(inp => {
    inp.removeEventListener('change', inputHandler);
    inp.addEventListener('change', inputHandler);
  });
  document.querySelectorAll('.check-block').forEach(btn => {
    btn.removeEventListener('click', checkBlockHandler);
    btn.addEventListener('click', checkBlockHandler);
  });
  document.querySelectorAll('.practice-hint').forEach(h => {
    h.removeEventListener('click', hintHandler);
    h.addEventListener('click', hintHandler);
  });
}

function choiceHandler(e) {
  const btn = e.currentTarget;
  const isCorrect = btn.dataset.correct === 'true';
  const taskId = btn.dataset.task;
  if (!taskId) return;
  const [blockIdx, tIdx] = taskId.split('-').map(Number);
  if (completedBlocks[blockIdx]) return;
  const itemDiv = btn.closest('.practice-item');
  if (itemDiv && itemDiv.dataset.done) return;
  if (isCorrect) {
    itemDiv.dataset.done = 'true';
    blockScores[blockIdx] = (blockScores[blockIdx] || 0) + 1;
    btn.classList.add('is-picked');
    saveProgress();
    renderBlocks();
  } else {
    btn.style.background = '#ffdddd';
    setTimeout(() => btn.style.background = '', 500);
  }
}

function inputHandler(e) {
  const inp = e.currentTarget;
  const taskId = inp.dataset.task;
  if (!taskId) return;
  const [blockIdx, tIdx] = taskId.split('-').map(Number);
  if (completedBlocks[blockIdx]) return;
  const correct = inp.dataset.correct;
  const userVal = inp.value.trim().toLowerCase();
  const isCorrect = userVal === correct.toLowerCase();
  const itemDiv = inp.closest('.practice-item');
  if (itemDiv && itemDiv.dataset.done) return;
  if (isCorrect && !itemDiv.dataset.done) {
    itemDiv.dataset.done = 'true';
    blockScores[blockIdx] = (blockScores[blockIdx] || 0) + 1;
    inp.style.borderColor = 'var(--ok)';
    saveProgress();
    renderBlocks();
  } else if (!isCorrect) {
    inp.style.borderColor = '#ffaaaa';
    setTimeout(() => inp.style.borderColor = '', 800);
  }
}

function checkBlockHandler(e) {
  const blockIdx = parseInt(e.currentTarget.dataset.block, 10);
  const block = blocksData[blockIdx];
  if (completedBlocks[blockIdx]) return;
  if ((blockScores[blockIdx] || 0) >= block.tasks.length) {
    completeBlock(blockIdx);
  } else {
    const warn = document.getElementById(`warn-${blockIdx}`);
    if (warn) {
      warn.textContent = `Complete all ${block.tasks.length} tasks first — ${blockScores[blockIdx] || 0} / ${block.tasks.length} done.`;
      warn.classList.add('show');
      setTimeout(() => warn.classList.remove('show'), 2400);
    }
  }
}

function hintHandler(e) {
  const hintBtn = e.currentTarget;
  const original = '💡 Hint';
  hintBtn.textContent = '💡 Check spelling / grammar carefully';
  setTimeout(() => { if (hintBtn) hintBtn.textContent = original; }, 1500);
}

document.getElementById('resetAllBtn')?.addEventListener('click', () => {
  completedBlocks.fill(false);
  blockScores.fill(0);
  saveProgress();
  renderBlocks();
  updateProgress();
});

loadProgress();
renderBlocks();
updateProgress();
</script>
