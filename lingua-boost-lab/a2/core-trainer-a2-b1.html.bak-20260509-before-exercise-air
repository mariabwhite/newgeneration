<!DOCTYPE html>
<html lang="en" data-theme="core-studio">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Core Trainer A2-B1 - LinguaBoost Lab</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;800;900&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none; /* avoid glitches on drag, but input fields remain editable */
        }
        body {
            background: linear-gradient(145deg, #f5edf8 0%, #eae3f0 100%);
            font-family: 'Manrope', system-ui, sans-serif;
            padding: 16px;
            min-height: 100vh;
        }
        /* purple calm theme */
        :root {
            --bg-light: #f9f0fc;
            --card-bg: #ffffff;
            --soft-lavender: #f3e5f5;
            --accent: #b23c8e;
            --accent-light: #d96c9e;
            --text-dark: #2d1b36;
            --text-muted: #6b4e7c;
            --border-line: #e2d0ec;
            --success: #7cb342;
            --shadow: 0 12px 28px rgba(0,0,0,0.05);
        }
        .app-container { max-width: 1400px; margin: 0 auto; }
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255,255,255,0.85);
            backdrop-filter: blur(12px);
            padding: 12px 24px;
            border-radius: 60px;
            margin-bottom: 24px;
            border: 1px solid var(--border-line);
        }
        .brand { display: flex; align-items: center; gap: 12px; font-weight: 800; font-family: 'Unbounded', sans-serif; }
        .brand-mark { background: linear-gradient(135deg, var(--accent), var(--accent-light)); width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; color: white; }
        .score-panel { background: white; border-radius: 60px; padding: 8px 20px; display: flex; gap: 20px; font-weight: 600; }
        .score-value { color: var(--accent); font-size: 1.6rem; font-weight: 800; }
        .progress-bar { width: 160px; height: 8px; background: #e2d5e8; border-radius: 10px; overflow: hidden; align-self: center; }
        .progress-fill { width: 0%; height: 100%; background: linear-gradient(90deg, var(--accent-light), var(--accent)); transition: width 0.3s; }
        .tab-nav { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; justify-content: center; }
        .tab-btn {
            background: white; border: none; padding: 10px 24px; border-radius: 40px; font-weight: 700; color: var(--text-muted);
            cursor: pointer; transition: 0.2s; box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }
        .tab-btn.active { background: var(--accent); color: white; box-shadow: 0 8px 18px rgba(178,60,142,0.2); }
        .tab-content { display: none; animation: fade 0.2s; }
        .tab-content.active { display: block; }
        @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; } }
        .game-card { background: var(--card-bg); border-radius: 36px; padding: 28px; border: 1px solid var(--border-line); box-shadow: var(--shadow); margin-bottom: 20px; }
        .game-title { font-family: 'Unbounded', sans-serif; font-size: 1.4rem; margin-bottom: 20px; color: var(--accent); }
        button, .answer-option, .drag-word, .bubble, .mole-btn { cursor: pointer; transition: 0.1s; }
        button:active { transform: scale(0.96); }
        .grammar-quiz-item { background: #faf7fc; border-radius: 24px; padding: 16px; margin-bottom: 16px; }
        .timer-badge { font-family: monospace; background: #ece3f5; padding: 4px 12px; border-radius: 40px; }
        .canvas-match { background: #fdf4f9; border-radius: 20px; min-height: 300px; position: relative; touch-action: none; }
        .cube-2048 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; max-width: 400px; margin: 20px auto; }
        .cube { background: #edd9f0; border-radius: 20px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; cursor: pointer; transition: 0.1s; color: #4a2c5e; }
        .cube.correct-match { background: #7cb342; color: white; }
        .bubble-grid { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; margin: 20px 0; }
        .bubble { background: radial-gradient(circle at 30% 30%, #f3d9ff, #d49be0); border-radius: 50%; width: 90px; height: 90px; display: flex; align-items: center; justify-content: center; text-align: center; font-weight: bold; transition: 0.05s linear; box-shadow: 0 8px 16px rgba(0,0,0,0.1); touch-action: manipulation; }
        .bubble-popped { transform: scale(0); opacity: 0; pointer-events: none; transition: 0.1s; }
        .whack-grid { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
        .mole { background: #b87333; border-radius: 50px; padding: 12px 20px; color: white; font-weight: bold; cursor: pointer; }
        .branch-dialogue { background: #f3eaf9; border-radius: 28px; padding: 24px; }
        .choice-btn { background: white; border: 1px solid var(--accent); border-radius: 40px; padding: 10px 18px; margin: 8px; cursor: pointer; }
        @media (max-width: 700px) { .tab-btn { padding: 6px 14px; font-size: 0.7rem; } .game-card { padding: 18px; } .bubble { width: 70px; height: 70px; font-size: 0.8rem; } }
        input, textarea { font-family: inherit; border-radius: 40px; border: 1px solid var(--border-line); padding: 8px 16px; width: 100%; user-select: text; }
        .flex-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }


        /* ===== UPGRADE: soft purple product layer, flow, timers, streak, feedback ===== */
        body {
            background:
              radial-gradient(circle at 12% 8%, rgba(216, 180, 254, .38), transparent 28%),
              radial-gradient(circle at 88% 12%, rgba(244, 114, 182, .18), transparent 26%),
              linear-gradient(145deg, #fbf7ff 0%, #efe7f6 100%);
        }
        .topbar { box-shadow: 0 14px 40px rgba(94, 57, 133, .08); }
        .utility-strip {
            display:flex;
            gap:12px;
            align-items:center;
            justify-content:space-between;
            flex-wrap:wrap;
            background: rgba(255,255,255,.72);
            border: 1px solid var(--border-line);
            border-radius: 32px;
            padding: 12px 16px;
            margin-bottom: 18px;
            box-shadow: var(--shadow);
        }
        .learning-flow { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
        .flow-step {
            padding:8px 14px;
            border-radius: 999px;
            background: #f3e5f5;
            color: var(--text-muted);
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .04em;
        }
        .flow-step.active { background: linear-gradient(135deg, var(--accent), var(--accent-light)); color:white; }
        .sound-toggle, .reset-progress-btn {
            border:1px solid var(--border-line);
            background:white;
            color:var(--text-muted);
            padding: 8px 14px;
            border-radius: 999px;
            font-weight:800;
            font-size: 12px;
            cursor:pointer;
        }
        .hero-mini {
            background:
              linear-gradient(135deg, rgba(255,255,255,.92), rgba(248,239,252,.92)),
              radial-gradient(circle at 82% 20%, rgba(192,132,252,.18), transparent 30%);
            border:1px solid var(--border-line);
            border-radius: 36px;
            padding: 36px 42px;
            margin-bottom: 22px;
            box-shadow: var(--shadow);
            display:grid;
            grid-template-columns: 1.2fr .8fr;
            gap: 24px;
            align-items:center;
        }
        .hero-mini h1 {
            font-family:'Unbounded', sans-serif;
            font-size: clamp(2.2rem, 5vw, 4.6rem);
            line-height:.95;
            letter-spacing:-.045em;
            color:var(--text-dark);
            margin-bottom: 12px;
        }
        .hero-mini h1 span { color: var(--accent); }
        .hero-mini p { color: var(--text-muted); font-size: 1.05rem; line-height: 1.55; max-width: 720px; }
        .mission-panel {
            background: #fbf5ff;
            border:1px dashed #d7bce8;
            border-radius: 28px;
            padding: 18px;
        }
        .mission-panel strong { color: var(--accent); }
        .mission-pill-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
        .mission-pill {
            background:white;
            border:1px solid var(--border-line);
            border-radius: 999px;
            padding:7px 11px;
            color:var(--text-muted);
            font-size: 11px;
            font-weight:800;
        }
        .score-panel { align-items:center; box-shadow: 0 8px 18px rgba(178,60,142,.08); }
        .streak-box {
            background: #fff6fb;
            border: 1px solid var(--border-line);
            border-radius: 999px;
            padding: 8px 14px;
            font-weight: 900;
            color: var(--accent);
        }
        .game-title { display:flex; flex-wrap:wrap; align-items:center; gap:10px; }
        .game-type {
            font-family:'JetBrains Mono', monospace;
            font-size:10px;
            padding:5px 10px;
            border-radius:999px;
            background:#f4e9fb;
            color:var(--accent);
            border:1px solid var(--border-line);
        }
        .game-card { position:relative; overflow:hidden; }
        .game-card::before {
            content:"";
            position:absolute;
            right:-90px;
            top:-90px;
            width:220px;
            height:220px;
            border-radius:50%;
            background: radial-gradient(circle, rgba(192,132,252,.12), transparent 68%);
            pointer-events:none;
        }
        .game-toolbar {
            display:flex;
            gap:10px;
            align-items:center;
            flex-wrap:wrap;
            margin-bottom: 16px;
        }
        .timer-badge.live {
            background: linear-gradient(135deg, #f5edff, #fff);
            border:1px solid var(--border-line);
            color:var(--accent);
            font-weight:900;
        }
        .feedback-box {
            margin-top: 12px;
            padding: 12px 16px;
            border-radius: 20px;
            font-weight: 800;
            border: 1px solid transparent;
        }
        .feedback-box.ok { background:#edf7ee; color:#2e7d32; border-color:#cde8d2; }
        .feedback-box.bad { background:#fff0f4; color:#b23c5c; border-color:#f4c7d4; }
        .feedback-box.info { background:#f5edff; color:var(--accent); border-color:var(--border-line); }
        button, .choice-btn, .tab-btn { box-shadow: 0 6px 14px rgba(98,45,132,.06); }
        button:hover, .choice-btn:hover, .answer-option:hover, .drag-word:hover, .mole:hover { transform: translateY(-1px); }
        .mole { animation: molePop .85s ease-in-out infinite alternate; }
        @keyframes molePop { from { transform: translateY(0); } to { transform: translateY(-7px); } }
        .bubble:active { transform: scale(1.12); }
        .cube.selected { outline: 3px solid var(--accent-light); box-shadow: 0 0 0 6px rgba(192,132,252,.18); }
        .cube.correct-match { background:#7cb342 !important; color:white; box-shadow:0 0 18px rgba(124,179,66,.35); }
        .drop-zone.matched { background:#e6f4df !important; border-color:#7cb342 !important; }
        .branch-dialogue {
            background: linear-gradient(135deg,#f6ebfb,#fff);
            border-left: 6px solid var(--accent);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
        }
        @media (max-width: 800px) {
            .hero-mini { grid-template-columns: 1fr; padding:24px; }
            .topbar { border-radius:28px; flex-wrap:wrap; }
            .score-panel { width:100%; justify-content:space-between; }
        }

    
/* Codex integration: LinguaBoost Lab Core Trainer shell */
:root{
  --core-bg:#f7f3ff;
  --core-card:#ffffff;
  --core-text:#251938;
  --core-muted:#6f5b82;
  --core-faint:#927caf;
  --core-accent:#7c3aed;
  --core-accent-2:#ec4899;
  --core-line:rgba(124,58,237,.16);
  --core-line-2:rgba(124,58,237,.28);
  --display:"Unbounded","Manrope",system-ui,sans-serif;
  --body:"Manrope",system-ui,sans-serif;
  --mono:"JetBrains Mono",Consolas,monospace;
}
*{user-select:auto;}
body{
  margin:0!important;
  padding:0!important;
  color:var(--core-text)!important;
  font-family:var(--body)!important;
  background:
    radial-gradient(circle at 9% 10%,rgba(236,72,153,.14),transparent 28%),
    radial-gradient(circle at 88% 12%,rgba(124,58,237,.16),transparent 30%),
    linear-gradient(145deg,#fffafe 0%,#f3f0ff 100%)!important;
}
.app-container{max-width:none!important;margin:0!important;}
.topbar{
  position:sticky;top:0;z-index:100;
  border-radius:0!important;margin:0!important;min-height:56px;
  padding:10px clamp(16px,3vw,28px)!important;
  background:color-mix(in srgb,#fff 90%,transparent)!important;
  border:0!important;border-bottom:1px solid var(--core-line)!important;
  box-shadow:none!important;backdrop-filter:blur(14px);
}
.brand{gap:12px!important;text-decoration:none;}
.brand-mark{
  width:36px!important;height:36px!important;border-radius:8px!important;
  border:1px solid var(--core-line-2);
  background:linear-gradient(135deg,var(--core-accent),var(--core-accent-2))!important;
  box-shadow:0 2px 8px rgba(124,58,237,.18);font-size:0!important;
}
.brand-mark::before{
  content:"";width:22px;height:22px;display:block;
  background:url("../assets/badges/english-booster.svg") center/contain no-repeat;
}
.brand span{
  font-family:var(--display)!important;font-size:14px!important;font-weight:800!important;
  letter-spacing:0;color:var(--core-text);
}
.brand span span{
  display:block;font-family:var(--mono)!important;font-size:9px!important;
  letter-spacing:.16em;text-transform:uppercase;color:var(--core-faint)!important;margin-top:2px;
}
.score-panel{
  margin-left:auto;background:#fff!important;border:1px solid var(--core-line)!important;
  border-radius:999px!important;box-shadow:none!important;
  font-family:var(--mono);font-size:10px;text-transform:uppercase;color:var(--core-muted);
}
.score-value{color:var(--core-accent)!important;}
.progress-bar{background:#ede7fb!important;}
.progress-fill{background:linear-gradient(90deg,var(--core-accent-2),var(--core-accent))!important;}
.utility-strip{
  width:min(100% - 48px,1240px);max-width:1240px;margin:18px auto 18px!important;
  background:rgba(255,255,255,.82)!important;border-color:var(--core-line)!important;
  border-radius:18px!important;box-shadow:0 8px 22px rgba(75,44,110,.06)!important;
}
.flow-step,.mission-pill,.game-type{
  font-family:var(--mono)!important;font-size:10px!important;letter-spacing:.1em!important;
  text-transform:uppercase;border-color:var(--core-line)!important;
}
.flow-step.active,.tab-btn.active{
  background:linear-gradient(135deg,var(--core-accent),var(--core-accent-2))!important;color:#fff!important;
}
.sound-toggle,.reset-progress-btn,.tab-btn,button{
  border-radius:8px!important;font-family:var(--mono)!important;font-size:11px!important;
  font-weight:800!important;letter-spacing:.08em;
}
.hero-mini{
  width:min(100% - 48px,1240px);max-width:1240px;margin:24px auto 22px!important;
  min-height:500px;border-radius:24px!important;padding:clamp(30px,5vw,62px)!important;
  border:1px solid var(--core-line-2)!important;box-shadow:0 18px 48px rgba(60,35,90,.12)!important;
  overflow:hidden;position:relative;display:grid!important;
  grid-template-columns:minmax(280px,.72fr) minmax(420px,1.28fr)!important;
  align-items:center!important;gap:32px!important;
  background:
    linear-gradient(90deg,rgba(255,255,255,.98) 0%,rgba(255,255,255,.9) 32%,rgba(255,255,255,.35) 52%,rgba(255,255,255,0) 72%),
    url("../../assets/%D0%94%D0%BB%D1%8F%20%D1%83%D1%80%D0%BE%D0%BA%D0%BE%D0%B2/Menu/25425414-2825-4446-b0ef-a4fe13dbda2d.png") center/cover no-repeat!important;
}
.hero-mini::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.12),rgba(255,255,255,.04));}
.hero-mini>div{position:relative;z-index:1;}
.hero-mini h1{
  font-family:var(--display)!important;font-size:clamp(2.45rem,5.4vw,4.85rem)!important;
  line-height:.96!important;letter-spacing:0!important;color:var(--core-text)!important;max-width:560px;
}
.hero-mini h1 span{color:var(--core-accent)!important;}
.hero-mini p{
  color:var(--core-muted)!important;font-size:clamp(15px,1.45vw,17px)!important;
  line-height:1.7!important;max-width:610px!important;
}
.mission-panel{
  justify-self:end;align-self:end;width:min(100%,390px);
  background:rgba(255,255,255,.72)!important;backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.7)!important;border-radius:18px!important;
  box-shadow:0 12px 28px rgba(64,36,92,.12);
}
.mission-panel strong{color:var(--core-accent)!important;}
.tab-nav{width:min(100% - 48px,1240px);margin:0 auto 22px!important;}
.tab-btn{border:1px solid var(--core-line)!important;color:var(--core-muted)!important;box-shadow:none!important;}
.tab-content{width:min(100% - 48px,1240px);margin:0 auto;}
.game-card{border-radius:18px!important;border:1px solid var(--core-line)!important;box-shadow:0 8px 24px rgba(75,44,110,.07)!important;}
.game-title{font-family:var(--display)!important;color:var(--core-accent)!important;letter-spacing:0!important;}
.grammar-quiz-item,.branch-dialogue,.canvas-match{background:#fbf8ff!important;border:1px solid var(--core-line)!important;}
.bubble{background:radial-gradient(circle at 30% 30%,#fff,#d9c4ff)!important;}
.cube{background:#efe7ff!important;color:var(--core-text)!important;}
input,textarea{user-select:text!important;}
.app-container>div:last-of-type{color:var(--core-faint)!important;font-family:var(--mono)!important;letter-spacing:.08em;text-transform:uppercase;}
@media(max-width:900px){
  .hero-mini{
    width:min(100% - 28px,1240px);grid-template-columns:1fr!important;min-height:620px;
    background:
      linear-gradient(180deg,rgba(255,255,255,.98) 0%,rgba(255,255,255,.88) 38%,rgba(255,255,255,.25) 72%,rgba(255,255,255,.05) 100%),
      url("../../assets/%D0%94%D0%BB%D1%8F%20%D1%83%D1%80%D0%BE%D0%BA%D0%BE%D0%B2/Menu/25425414-2825-4446-b0ef-a4fe13dbda2d.png") center bottom/cover no-repeat!important;
  }
  .mission-panel{justify-self:start;align-self:start;}
  .utility-strip,.tab-nav,.tab-content{width:min(100% - 28px,1240px);}
}

/* Codex repair: clean text icons, working trainers, calmer inner UI */
.game-title::before,h4::before,button::before{content:none!important;}
.game-title{font-size:clamp(1.08rem,2vw,1.55rem)!important;line-height:1.2!important;}
button,.choice-btn{
  min-height:40px;
  padding:0 18px!important;
  border:1px solid var(--core-line-2)!important;
  border-radius:10px!important;
  background:#fff!important;
  color:var(--core-muted)!important;
  box-shadow:0 5px 14px rgba(88,55,130,.06)!important;
  text-transform:uppercase;
}
button:hover,.choice-btn:hover{border-color:var(--core-accent)!important;color:var(--core-accent)!important;background:#fbf8ff!important;}
.flex-row{align-items:center!important;gap:10px!important;}
.grammar-quiz-item label{display:inline-flex;align-items:center;gap:6px;margin:8px 14px 0 0;}
.grammar-quiz-item input[type="radio"]{width:auto;accent-color:var(--core-accent);}
.match-board{min-height:320px;}
.match-layout{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:start;}
.match-col{display:grid;gap:10px;}
.match-card{
  border:1px solid var(--core-line);
  background:#fbf8ff;
  border-radius:12px;
  padding:13px 15px;
  font-weight:700;
  color:var(--core-text);
  cursor:pointer;
  transition:.16s;
}
.match-card:hover,.match-card.selected{border-color:var(--core-accent);box-shadow:0 0 0 4px rgba(124,58,237,.1);}
.match-card.matched{border-color:#40a36b;background:#edf8f1;color:#276846;cursor:default;}
.match-card.wrong{border-color:#d94a67;background:#fff1f4;}
.match-heading{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--core-faint);margin:0 0 4px;}
.cube-2048{
  display:grid!important;
  grid-template-columns:repeat(4,minmax(130px,1fr))!important;
  gap:14px!important;
  max-width:760px!important;
  margin:22px auto!important;
}
.cube{
  min-height:118px!important;
  border:1px solid var(--core-line)!important;
  border-radius:14px!important;
  padding:16px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  text-align:center!important;
  font-size:clamp(.9rem,1.35vw,1.05rem)!important;
  line-height:1.32!important;
  font-weight:800!important;
  background:linear-gradient(180deg,#fff,#f5efff)!important;
  color:var(--core-text)!important;
  box-shadow:0 8px 18px rgba(84,52,124,.07);
}
.cube.if-part{border-left:5px solid #7c3aed!important;}
.cube.main-part{border-left:5px solid #ec4899!important;}
.cube.selected{outline:0!important;border-color:var(--core-accent)!important;box-shadow:0 0 0 5px rgba(124,58,237,.14)!important;}
.cube.matched{background:#edf8f1!important;border-color:#40a36b!important;color:#276846!important;}
.trainer-scoreline{font-family:var(--mono);font-size:12px;font-weight:800;color:var(--core-muted);margin-top:12px;}
.vocab-panel{border:1px solid var(--core-line);border-radius:16px;padding:18px;margin:16px 0;background:#fff;}
.vocab-panel h4{font-family:var(--display);font-size:1rem;margin:0 0 14px;color:var(--core-text);}
.flash-grid-clean{display:grid!important;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px!important;margin-bottom:0!important;}
.flip-card.clean-card{width:auto!important;height:112px!important;}
.flip-card.clean-card .flip-front,.flip-card.clean-card .flip-back{
  padding:12px!important;
  border:1px solid var(--core-line)!important;
