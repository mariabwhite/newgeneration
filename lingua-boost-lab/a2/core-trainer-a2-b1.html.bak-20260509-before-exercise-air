    <div style="text-align:center; margin-top:20px; font-size:0.7rem; color:#7a5c8e;">9 interactive mechanics - Core Trainer A2-B1 - Progress saved</div>
</div>

<script>
    // --------------------- GLOBAL STATE & SCORE ---------------------

    let soundEnabled = true;
    let streak = 0;
    let bestStreak = 0;
    const timerState = {};
    function playTone(type='ok') {
        if (!soundEnabled) return;
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain); gain.connect(ctx.destination);
            const freq = type === 'bad' ? 180 : type === 'win' ? 740 : 520;
            osc.frequency.value = freq;
            osc.type = 'sine';
            gain.gain.setValueAtTime(0.001, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.08, ctx.currentTime + 0.01);
            gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.18);
            osc.start(); osc.stop(ctx.currentTime + 0.2);
        } catch(e) {}
    }
    function setStreak(delta) {
        if (delta > 0) streak += delta; else streak = 0;
        bestStreak = Math.max(bestStreak, streak);
        const box = document.getElementById('streakBox');
        if (box) box.innerText = `Streak ${streak} - Best ${bestStreak}`;
        saveProgress();
    }
    function showFeedback(target, text, ok='info') {
        const el = typeof target === 'string' ? document.getElementById(target) : target;
        if (!el) return;
        el.innerHTML = `<div class="feedback-box ${ok}">${text}</div>`;
    }
    function startTimer(id, seconds, displayId, onFinish) {
        if (timerState[id]) clearInterval(timerState[id]);
        let left = seconds;
        const display = document.getElementById(displayId);
        const tick = () => {
            if (display) display.innerText = `${left}s`;
            if (left <= 0) {
                clearInterval(timerState[id]);
                timerState[id] = null;
                if (onFinish) onFinish();
            }
            left--;
        };
        tick();
        timerState[id] = setInterval(tick, 1000);
    }
    function renderTimerToolbar(areaId, timerId, seconds, label='Speed round') {
        const area = document.getElementById(areaId);
        if (!area) return;
        area.insertAdjacentHTML('afterbegin', `<div class="game-toolbar"><span class="timer-badge live" id="${timerId}Display">${seconds}s</span><span class="timer-badge">${label}</span></div>`);
        startTimer(timerId, seconds, `${timerId}Display`, () => { playTone('bad'); showFeedback(area.parentElement.querySelector('[id$="Feedback"]') || null, 'Time is up. Check what you have and try again.', 'bad'); });
    }
    let totalScore = 0;
    let combo = 0;
    let blockCompletedFlags = new Array(9).fill(false);
    function updateUI() { document.getElementById('globalScore').innerText = totalScore; let percent = Math.min(100, (totalScore/1200)*100); document.getElementById('globalProgress').style.width = percent+"%"; saveProgress(); }
    function addPoints(p, tabId) { let old = totalScore; totalScore += p; combo++; if(combo>5) { totalScore+=Math.floor(p*0.2); } if(p>0){ setStreak(1); playTone(p>=30?'win':'ok'); } updateUI(); if(!blockCompletedFlags[tabId] && totalScore-old>=10) blockCompletedFlags[tabId]=true; }
    function saveProgress() { localStorage.setItem('linguaBoostCoreTrainer', JSON.stringify({score:totalScore, blocks:blockCompletedFlags, streak, bestStreak, soundEnabled})); }
    function loadProgress() { let d=localStorage.getItem('linguaBoostCoreTrainer'); if(d){ let obj=JSON.parse(d); totalScore=obj.score||0; blockCompletedFlags=obj.blocks||new Array(9).fill(false); streak=obj.streak||0; bestStreak=obj.bestStreak||0; soundEnabled=obj.soundEnabled!==false; updateUI(); const sb=document.getElementById('streakBox'); if(sb) sb.innerText=`Streak ${streak} - Best ${bestStreak}`; const st=document.getElementById('soundToggle'); if(st) st.innerText=`Sound: ${soundEnabled?'ON':'OFF'}`; } }
    // ---------- 1. Grammar Blitz (tenses) ----------
    const blitzQuestions = [
        { text: "She usually ___ to school by bus.", options: ["go","goes","going"], correct:1 },
        { text: "Yesterday at 5pm I ___ dinner.", options: ["cooked","was cooking","have cooked"], correct:1 },
        { text: "They ___ the project already.", options: ["finished","have finished","finish"], correct:1 },
        { text: "I think it ___ rain tomorrow.", options: ["will","is going to","shall"], correct:0 },
        { text: "While I was reading, he ___.", options: ["arrived","was arriving","arrives"], correct:0 }
    ];
    let blitzAnswers = new Array(5).fill(null);
    function renderBlitz() { let html=''; blitzQuestions.forEach((q,i)=>{ html+=`<div class="grammar-quiz-item">${q.text}<br>${q.options.map((opt,idx)=>`<label style="margin-right:12px"><input type="radio" name="blitz${i}" value="${idx}"> ${opt}</label>`).join('')}</div>`; }); document.getElementById('blitzArea').innerHTML=html; }
    function checkBlitz(){ let corr=0; blitzQuestions.forEach((q,i)=>{ let sel=document.querySelector(`input[name="blitz${i}"]:checked`); if(sel && parseInt(sel.value)===q.correct) corr++; }); let pts=corr*10; addPoints(pts,0); showFeedback('blitzFeedback', `Tenses: ${corr}/${blitzQuestions.length} correct -> +${pts} points`, corr ? 'ok' : 'bad'); if(!corr){ setStreak(0); playTone('bad'); } }
    // ---------- 2. Speed Type (gerund/infinitive) ----------
    const speedGerund = [
        { text: "I enjoy ___ (listen) to music.", answer:"listening" },{ text: "She refused ___ (help) me.", answer:"to help" },{ text: "It's no use ___ (worry).", answer:"worrying" },{ text: "He suggested ___ (go) to the cinema.", answer:"going" },{ text: "They decided ___ (cancel) the game.", answer:"to cancel" }
    ];
    function renderSpeed(){ let html=''; speedGerund.forEach((q,i)=>{ html+=`<div class="grammar-quiz-item">${q.text}<br><input type="text" id="speedInp${i}" placeholder="type answer"></div>`; }); document.getElementById('speedArea').innerHTML=html; renderTimerToolbar('speedArea','speedTimer',60,'Gerund / infinitive speed'); }
    function checkSpeed(){ let corr=0; speedGerund.forEach((q,i)=>{ let val=document.getElementById(`speedInp${i}`).value.trim().toLowerCase(); if(val===q.answer) corr++; }); let pts=corr*8; addPoints(pts,1); showFeedback('speedFeedback', `Gerund/Inf: ${corr}/${speedGerund.length} → +${pts}`, corr ? 'ok' : 'bad'); if(!corr){ setStreak(0); playTone('bad'); } }
    // ---------- 3. Word Builder (used to) ----------
    const builderSentences = [
        { words: ["used","to","play"], correct:"used to play" },{ words: ["would","tell"], correct:"would tell" },{ words: ["getting","used","to"], correct:"getting used to" },{ words: ["used","to","live"], correct:"used to live" }
    ];
    let builderAnswers = new Array(4).fill('');
    function renderBuilder(){ let html=''; builderSentences.forEach((s,i)=>{ html+=`<div class="grammar-quiz-item">Build phrase: ${s.words.join(' ')} → <input type="text" id="builder${i}" placeholder="reorder + write" style="width:60%"></div>`; }); document.getElementById('builderArea').innerHTML=html; }
    function checkBuilder(){ let corr=0; builderSentences.forEach((s,i)=>{ let val=document.getElementById(`builder${i}`).value.trim().toLowerCase(); if(val===s.correct) corr++; }); let pts=corr*10; addPoints(pts,2); showFeedback('builderFeedback', `Word builder: ${corr}/${builderSentences.length} → +${pts}`, corr ? 'ok' : 'bad'); if(!corr){ setStreak(0); playTone('bad'); } }
    // ---------- 4. Canvas Match (simplified as dropвЂ‘based match because canvas needs heavy pointer) -----
    const matchItems = [{left:"There is a cat ___", right:"under the table."},{left:"I would like ___", right:"to visit Paris."},{left:"Let's ___", right:"go swimming!"},{left:"There are many ___", right:"books on the shelf."}];
    let canvasMatches = new Array(4).fill(null);
    function renderCanvasMatch(){ let html=`<div style="display:flex; gap:20px; flex-wrap:wrap;"><div>${matchItems.map((l,i)=>`<div class="drag-item" draggable="true" data-left-idx="${i}" style="background:#ede0f0; margin:10px; padding:10px; border-radius:40px;">${l.left}</div>`).join('')}</div><div>${matchItems.map((r,i)=>`<div class="drop-zone" data-right-idx="${i}" style="background:#f9eef7; border:2px dashed #cfa6d4; margin:10px; padding:10px; border-radius:40px;">${r.right}</div>`).join('')}</div></div>`;
        document.getElementById('canvasMatchContainer').innerHTML=html; attachMatchDrag(); }
    function attachMatchDrag(){ let dragData=null; document.querySelectorAll('[data-left-idx]').forEach(el=>{ el.addEventListener('dragstart',e=>{ dragData=el.getAttribute('data-left-idx'); e.dataTransfer.setData('text/plain',dragData); }); }); document.querySelectorAll('.drop-zone').forEach(zone=>{ zone.addEventListener('dragover',e=>e.preventDefault()); zone.addEventListener('drop',e=>{ let leftIdx=e.dataTransfer.getData('text/plain'); let rightIdx=zone.getAttribute('data-right-idx'); if(matchItems[leftIdx] && matchItems[leftIdx].right===matchItems[rightIdx].right){ zone.style.backgroundColor="#cde6cd"; canvasMatches[leftIdx]=rightIdx; } else { playTone('bad'); showFeedback('canvasMatchFeedback','Wrong match. Try another pair.','bad'); }; }); }); }
    function checkCanvas(){
      let correct = canvasMatches.filter((v,i)=> v !== null && matchItems[i].right===matchItems[v].right).length;
      let pts = correct*8;
      addPoints(pts, 3);
      showFeedback('canvasMatchFeedback', `Matching: ${correct}/4 → +${pts}`, correct ? 'ok' : 'bad');
      if(!correct){ setStreak(0); playTone('bad'); }
    }

    // ---------- 5. Comparatives speed ----------
    const compSpeed = [
      { text: "London is ___ (big) than Madrid.", answer: "bigger" },
      { text: "She is the ___ (good) student in class.", answer: "best" },
      { text: "This task is ___ (difficult) than the last one.", answer: "more difficult" },
      { text: "He drives ___ (careful) than his brother.", answer: "more carefully" }
    ];
    function renderCompSpeed(){
      let html = '';
      compSpeed.forEach((q,i)=>{
        html += `<div class="grammar-quiz-item">${q.text}<br><input type="text" id="comp${i}" placeholder="type answer"></div>`;
      });
      document.getElementById('compSpeedArea').innerHTML = html;
      renderTimerToolbar('compSpeedArea','compTimer',60,'Comparatives speed');
    }
    function checkCompSpeed(){
      let corr = 0;
      compSpeed.forEach((q,i)=>{
        let val = (document.getElementById(`comp${i}`).value||'').trim().toLowerCase();
        if(val === q.answer) corr++;
      });
      let pts = corr*10;
      addPoints(pts, 4);
      showFeedback('compSpeedFeedback', `Comparatives: ${corr}/${compSpeed.length} → +${pts}`, corr ? 'ok' : 'bad');
      if(!corr){ setStreak(0); playTone('bad'); }
    }

    // ---------- 6. Grammar 2048 cube (conditionals) ----------
    const cubePairs = [
      { ifPart: "If it rains tomorrow,",     mainPart: "we will stay at home." },
      { ifPart: "If I had more time,",       mainPart: "I would learn Italian." },
      { ifPart: "If she had studied harder,", mainPart: "she would have passed." },
      { ifPart: "If you mix red and blue,",  mainPart: "you get purple." }
    ];
    let cubeState = { selected: null, matched: new Set() };
    function renderCube(){
      const grid = document.getElementById('cubeGrid');
      if(!grid) return;
      // Build randomized halves
      const halves = [];
      cubePairs.forEach((p,i)=>{
        halves.push({ id: 'if-'+i,   text: p.ifPart,   pair: i, side: 'if' });
        halves.push({ id: 'main-'+i, text: p.mainPart, pair: i, side: 'main' });
      });
      halves.sort(()=>Math.random()-0.5);
      grid.innerHTML = halves.map(h =>
        `<div class="cube ${h.side}-part" data-id="${h.id}" data-pair="${h.pair}">${h.text}</div>`
      ).join('');
      grid.querySelectorAll('.cube').forEach(el=>{
        el.addEventListener('click', ()=> cubeClick(el));
      });
      updateCubeScore();
    }
    function cubeClick(el){
      if(cubeState.matched.has(el.dataset.id)) return;
      if(!cubeState.selected){
        cubeState.selected = el; el.classList.add('selected'); return;
      }
      if(cubeState.selected === el){
        el.classList.remove('selected'); cubeState.selected = null; return;
      }
      const a = cubeState.selected, b = el;
      a.classList.remove('selected');
      if(a.dataset.pair === b.dataset.pair && a.dataset.id !== b.dataset.id){
        a.classList.add('matched'); b.classList.add('matched');
        cubeState.matched.add(a.dataset.id); cubeState.matched.add(b.dataset.id);
        addPoints(15, 5); playTone('ok');
        showFeedback('cubeFeedback','Pair matched! +15','ok');
      } else {
        playTone('bad');
        showFeedback('cubeFeedback','Not a pair. Try again.','bad');
      }
      cubeState.selected = null;
      updateCubeScore();
    }
    function updateCubeScore(){
      const score = document.getElementById('cubeScore');
      if(score) score.innerText = `Matched pairs: ${cubeState.matched.size/2}/${cubePairs.length}`;
    }

    // ---------- 7. Future forms speed ----------
    const futureSpeed = [
      { text: "Look at those clouds! It ___ (rain).",     answer: "is going to rain" },
      { text: "I think tomorrow ___ (be) sunny.",          answer: "will be" },
      { text: "Wait! I ___ (help) you with that bag.",     answer: "'ll help" },
      { text: "Our train ___ (leave) at 8 am tomorrow.",   answer: "leaves" }
    ];
    function renderFutureSpeed(){
      let html = '';
      futureSpeed.forEach((q,i)=>{
        html += `<div class="grammar-quiz-item">${q.text}<br><input type="text" id="fut${i}" placeholder="type answer"></div>`;
      });
      document.getElementById('futureSpeedArea').innerHTML = html;
      renderTimerToolbar('futureSpeedArea','futureTimer',60,'Future forms');
    }
    function checkFutureSpeed(){
      let corr = 0;
      futureSpeed.forEach((q,i)=>{
        let val = (document.getElementById(`fut${i}`).value||'').trim().toLowerCase().replace(/\s+/g,' ');
        if(val === q.answer.toLowerCase()) corr++;
      });
      let pts = corr*10;
      addPoints(pts, 6);
      showFeedback('futureSpeedFeedback', `Future forms: ${corr}/${futureSpeed.length} → +${pts}`, corr ? 'ok' : 'bad');
      if(!corr){ setStreak(0); playTone('bad'); }
    }

    // ---------- 8. Vocabulary arcade (flashcards / bubble pop / category tap) ----------
    const vocabCards = [
      { en: 'achieve',   ru: 'достигать' },
      { en: 'discover',  ru: 'открывать' },
      { en: 'remind',    ru: 'напоминать' },
      { en: 'suggest',   ru: 'предлагать' },
      { en: 'consider',  ru: 'обдумывать' },
      { en: 'support',   ru: 'поддерживать' }
    ];
    const bubblePool = [
      { word: 'happy',  match: 'cheerful' },
      { word: 'big',    match: 'huge' },
      { word: 'tired',  match: 'exhausted' },
      { word: 'smart',  match: 'clever' }
    ];
    const whackCategories = {
      animals: ['cat','dog','horse','bear','fox','rabbit'],
      food:    ['apple','bread','cheese','rice','pasta','soup'],
      places:  ['city','village','beach','forest','mountain','park']
    };
    let vocabPoints = { bubble: 0, whack: 0 };
    function renderFlashcards(){
      const grid = document.getElementById('flash3d'); if(!grid) return;
      grid.innerHTML = vocabCards.map((c,i)=>
        `<div class="flip-card clean-card" data-i="${i}">
          <div class="flip-front">${c.en}</div>
          <div class="flip-back">${c.ru}</div>
        </div>`
      ).join('');
      grid.querySelectorAll('.flip-card').forEach(card=>{
        let flipped = false;
        card.addEventListener('click', ()=>{
          flipped = !flipped;
          card.querySelector('.flip-front').style.display = flipped ? 'none' : 'flex';
          card.querySelector('.flip-back').style.display  = flipped ? 'flex' : 'none';
        });
        // initial
        card.querySelector('.flip-front').style.display = 'flex';
        card.querySelector('.flip-back').style.display  = 'none';
        card.querySelector('.flip-front').style.alignItems = 'center';
        card.querySelector('.flip-front').style.justifyContent = 'center';
        card.querySelector('.flip-back').style.alignItems = 'center';
        card.querySelector('.flip-back').style.justifyContent = 'center';
      });
    }
    function renderBubblePop(){
      const area = document.getElementById('bubbleGameArea'); if(!area) return;
      // mix all words and matches
      const all = [];
      bubblePool.forEach((p,i)=>{
        all.push({text: p.word, pair:i});
        all.push({text: p.match, pair:i});
      });
      all.sort(()=>Math.random()-0.5);
      area.innerHTML = `<div class="bubble-grid">${
        all.map(b=>`<div class="bubble" data-pair="${b.pair}">${b.text}</div>`).join('')
      }</div>`;
      let selected = null;
      area.querySelectorAll('.bubble').forEach(el=>{
        el.addEventListener('click', ()=>{
          if(el.classList.contains('matched')) return;
          if(!selected){ selected = el; el.style.outline = '3px solid var(--core-accent)'; return; }
          if(selected === el){ el.style.outline=''; selected=null; return; }
          if(selected.dataset.pair === el.dataset.pair){
            selected.classList.add('matched'); el.classList.add('matched');
            selected.style.outline=''; el.style.outline='';
            selected.style.opacity = el.style.opacity = '0.45';
            vocabPoints.bubble += 10;
            document.getElementById('bubblePoints').innerText = vocabPoints.bubble;
            addPoints(10, 7); playTone('ok');
          } else {
            selected.style.outline=''; playTone('bad');
          }
          selected = null;
        });
      });
    }
    function renderWhack(){
      const area = document.getElementById('whackArea'); if(!area) return;
      const cats = Object.keys(whackCategories);
      const target = cats[Math.floor(Math.random()*cats.length)];
      const pool = [];
      cats.forEach(c=>{
        whackCategories[c].slice(0,3).forEach(w => pool.push({ word: w, cat: c }));
      });
      pool.sort(()=>Math.random()-0.5);
      area.innerHTML = `
        <div class="bubble-target">Tap only: <strong>${target.toUpperCase()}</strong></div>
        <div class="whack-grid" style="display:flex; flex-wrap:wrap; gap:10px; margin-top:10px;">
          ${pool.map(p => `<button class="mole" data-cat="${p.cat}">${p.word}</button>`).join('')}
        </div>`;
      area.querySelectorAll('.mole').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          if(btn.dataset.cat === target){
            btn.style.background = '#cde6cd'; btn.style.color = '#276846';
            vocabPoints.whack += 8;
            document.getElementById('whackPoints').innerText = vocabPoints.whack;
            addPoints(8, 7); playTone('ok');
          } else {
            btn.style.background = '#fff1f4'; btn.style.color = '#c0392b';
            playTone('bad'); setStreak(0);
          }
          btn.disabled = true;
        });
      });
    }

    // ---------- 9. Role-play branching ----------
    const dialogueTree = {
      start: {
        bot: "Welcome to our restaurant! Would you like a table by the window?",
        choices: [
          { text: "Yes, that would be great.", next: 'order' },
          { text: "Actually, can I sit by the wall?", next: 'order' }
        ]
      },
      order: {
        bot: "Perfect. Are you ready to order?",
        choices: [
          { text: "Yes — I'll have the pasta, please.", next: 'drink' },
          { text: "Could you recommend something?", next: 'drink' }
        ]
      },
      drink: {
        bot: "Great choice. Anything to drink?",
        choices: [
          { text: "A glass of water, please.", next: 'end' },
          { text: "What juices do you have?", next: 'end' }
        ]
      },
      end: {
        bot: "Perfect. I'll bring it shortly. Enjoy!",
        choices: []
      }
    };
    let dialogueState = 'start';
    function renderDialogue(){
      const area = document.getElementById('branchDialogue'); if(!area) return;
      const node = dialogueTree[dialogueState];
      let html = `<div style="background:#fff;padding:14px 18px;border-radius:14px;border:1px solid var(--core-line);margin-bottom:12px;">
        <strong>Bot:</strong> ${node.bot}
      </div>`;
      if(node.choices.length){
        html += `<div style="display:flex;gap:10px;flex-wrap:wrap;">${
          node.choices.map((c,i)=>`<button class="choice-btn" data-next="${c.next}" data-i="${i}">${c.text}</button>`).join('')
        }</div>`;
      } else {
        html += `<div style="color:var(--core-accent);font-weight:800;">Dialogue complete · +25</div>`;
        addPoints(25, 8); playTone('win');
      }
      area.innerHTML = html;
      area.querySelectorAll('.choice-btn').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          dialogueState = btn.dataset.next;
          addPoints(5, 8); playTone('ok');
          renderDialogue();
        });
      });
    }
    function resetDialogue(){ dialogueState = 'start'; renderDialogue(); }

    // ---------- TAB NAV + ROUTING ----------
    const TABS = [
      { id: 'blitzTab',          label: 'TENSES',     pill: 'QUIZ',   render: renderBlitz },
      { id: 'speedTypeTab',      label: 'GERUND',     pill: 'TIMER',  render: renderSpeed },
      { id: 'wordBuilderTab',    label: 'USED TO',    pill: 'BUILD',  render: renderBuilder },
      { id: 'canvasMatchTab',    label: 'MATCH',      pill: 'MATCH',  render: renderCanvasMatch },
      { id: 'comparativeSpeedTab', label: 'COMPARE',  pill: 'TIMER',  render: renderCompSpeed },
      { id: 'cube2048Tab',       label: 'IF',         pill: 'MERGE',  render: renderCube },
      { id: 'futureSpeedTab',    label: 'FUTURE',     pill: 'TIMER',  render: renderFutureSpeed },
      { id: 'vocabTripleTab',    label: 'VOCAB',      pill: 'ARCADE', render: ()=>{ renderFlashcards(); renderBubblePop(); renderWhack(); } },
      { id: 'roleplayTab',       label: 'ROLE-PLAY',  pill: 'SPEAK',  render: renderDialogue }
    ];
    function buildTabNav(){
      const nav = document.getElementById('tabNav'); if(!nav) return;
      nav.innerHTML = TABS.map((t,i)=>
        `<button class="tab-btn${i===0?' active':''}" data-tab="${t.id}">${t.label} <span class="game-type">${t.pill}</span></button>`
      ).join('');
      nav.querySelectorAll('.tab-btn').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          activateTab(btn.dataset.tab);
        });
      });
    }
    function activateTab(id){
      document.querySelectorAll('.tab-content').forEach(el=>{
        el.classList.toggle('active', el.id === id);
      });
      document.querySelectorAll('.tab-btn').forEach(btn=>{
        btn.classList.toggle('active', btn.dataset.tab === id);
      });
      const tab = TABS.find(t=>t.id===id);
      if(tab && typeof tab.render === 'function'){
        try { tab.render(); } catch(err){ console.warn('tab render error:', err); }
      }
      // Scroll into view on mobile
      if(window.innerWidth <= 760){
        const el = document.getElementById(id);
        if(el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // ---------- BUTTON WIRE-UP (handlers attached after DOMContentLoaded) ----------
    function wireButtons(){
      const wire = (id, fn) => { const b = document.getElementById(id); if(b) b.addEventListener('click', fn); };
      wire('checkBlitzBtn',       checkBlitz);
      wire('checkSpeedBtn',       checkSpeed);
      wire('checkBuilderBtn',     checkBuilder);
      wire('checkCanvasMatchBtn', checkCanvas);
      wire('checkCompSpeedBtn',   checkCompSpeed);
      wire('checkFutureSpeedBtn', checkFutureSpeed);
      // sound + reset
      wire('soundToggle', ()=>{
        soundEnabled = !soundEnabled;
        document.getElementById('soundToggle').innerText = `Sound: ${soundEnabled?'ON':'OFF'}`;
        saveProgress();
      });
      wire('resetProgressBtn', ()=>{
        if(!confirm('Reset all progress?')) return;
        localStorage.removeItem('linguaBoostCoreTrainer');
        totalScore = 0; streak = 0; bestStreak = 0;
        blockCompletedFlags = new Array(9).fill(false);
        updateUI();
        document.getElementById('streakBox').innerText = 'Streak 0';
        TABS.forEach(t => t.render && t.render());
      });
    }

    // ---------- INIT ----------
    document.addEventListener('DOMContentLoaded', ()=>{
      buildTabNav();
      wireButtons();
      activateTab('blitzTab');
      loadProgress();
    });

</script>
