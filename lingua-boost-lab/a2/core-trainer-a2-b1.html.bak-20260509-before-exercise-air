.bubble-target{display:inline-flex;align-items:center;padding:6px 12px;border-radius:999px;background:#f2e8ff;color:var(--core-accent);font-weight:900;}
.mole{
  animation:none!important;
  background:linear-gradient(135deg,#7c3aed,#ec4899)!important;
  border-radius:12px!important;
  padding:12px 16px!important;
  min-height:46px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  color:#fff!important;
  box-shadow:0 8px 18px rgba(124,58,237,.15);
}
.whack-grid{gap:10px!important;justify-content:center!important;}
