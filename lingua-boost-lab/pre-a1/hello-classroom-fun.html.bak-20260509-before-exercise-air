}

/* ── 5. AUDIO DIALOG ──────────────────────────── */
.audio-controls{
  display:flex; gap:12px; flex-wrap:wrap; justify-content:center;
  margin-bottom:14px;
}
.q-block{
  background:var(--card-2);
  border:1px dashed var(--line-2);
  border-radius:18px;
  padding:14px;
  margin:0 auto 12px;
  max-width:600px;
  text-align:left;
}
.q-block .q-text{
  font-family:var(--body); font-weight:700;
  color:var(--brand-2); margin-bottom:10px;
}
.q-options{ display:flex; flex-wrap:wrap; gap:8px; }
.q-opt{
  background:#fff;
  border:2px solid var(--line-2);
  color:var(--brand-2);
  font-family:var(--display); font-weight:700;
  font-size:.92rem;
  padding:7px 16px;
  border-radius:40px;
  cursor:pointer;
  transition:.1s;
}
.q-opt:hover{ border-color:var(--accent); }
.q-opt.selected{ background:var(--accent); color:#fff; border-color:var(--accent); }
.q-opt.right{ background:#d8f5d2; color:#2d6a23; border-color:#7bc36b; }
.q-opt.wrong{ background:#ffd6d6; color:#9a2222; border-color:#e74c3c; }

/* ── 6. SENTENCE BUILDER ─────────────────────── */
.builder-target{
  font-family:var(--display); font-weight:800;
  color:var(--brand-2); font-size:1.05rem;
  margin-bottom:10px;
}
.word-bank{
  display:flex; flex-wrap:wrap;
  gap:10px; justify-content:center;
  margin:0 auto 14px;
  max-width:600px;
}
.word-brick{
  background:var(--accent-3);
  color:var(--brand-2);
  font-family:var(--display); font-weight:700;
  font-size:.95rem;
  padding:9px 18px;
  border-radius:40px;
  cursor:pointer;
  border:1px solid var(--line-2);
  transition:.1s;
}
.word-brick:hover{ background:var(--accent-2); color:#fff; }
.builder-drop{
  background:var(--card-2);
  border:1px dashed var(--line-2);
  min-height:60px;
  border-radius:24px;
  padding:12px;
  display:flex; flex-wrap:wrap; align-items:center;
  gap:8px; justify-content:center;
  margin:0 auto 12px;
  max-width:600px;
}
.placed-word{
  background:var(--accent);
  color:#fff;
  padding:7px 14px;
  border-radius:40px;
  font-family:var(--display); font-weight:700; font-size:.9rem;
  cursor:pointer;
}

/* ── 7. TRUE / FALSE ──────────────────────────── */
.tf-item{
  background:var(--card-2);
  border:1px solid var(--line-2);
  border-radius:18px;
  padding:14px;
  margin:0 auto 10px;
  max-width:600px;
  text-align:left;
}
.tf-text{
  font-family:var(--body); font-weight:700;
  color:var(--brand-2); margin-bottom:10px;
}
.tf-buttons{ display:flex; gap:8px; flex-wrap:wrap; }
.tf-btn{
  background:#fff;
  border:2px solid var(--line-2);
  color:var(--brand-2);
  font-family:var(--display); font-weight:800;
  font-size:.85rem; letter-spacing:.05em;
  padding:8px 18px;
  border-radius:40px;
  cursor:pointer;
}
.tf-btn:hover{ border-color:var(--accent); }
.tf-btn.selected{ background:var(--accent); color:#fff; border-color:var(--accent); }
.tf-btn.right{ background:#d8f5d2; color:#2d6a23; border-color:#7bc36b; }
.tf-btn.wrong{ background:#ffd6d6; color:#9a2222; border-color:#e74c3c; }

/* ── 8. PREPOSITIONS (12-item · springy) ──────── */
.prep-scene{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:12px;
  max-width:780px; margin:0 auto 18px;
}
.prep-hint-board{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:10px;
  max-width:780px;
  margin:0 auto 14px;
}
.prep-hint-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:18px;
  padding:10px 12px;
  color:var(--brand-2);
  font-family:var(--display);
  font-weight:800;
  text-align:left;
}
.prep-hint-card strong{
  display:block;
  margin-bottom:6px;
  color:var(--accent);
}
.prep-hint-card span{
  display:block;
  font-family:var(--body);
  font-size:.9rem;
  line-height:1.35;
  font-weight:700;
}
.prep-zone{
  background:#fff;
  border:2px dashed var(--line-2);
  border-radius:20px;
  padding:14px 12px 12px;
  font-family:var(--display); font-weight:800;
  color:var(--brand-2); font-size:.95rem;
  min-height:130px;
  display:flex; flex-direction:column; align-items:center; gap:8px;
  text-align:center;
  cursor:pointer;
  transition:background .2s, border-color .2s;
}
.prep-zone-label{
  letter-spacing:-.01em;
  display:flex; align-items:center; gap:6px;
}
.prep-zone-label .ico{ font-size:1.15rem; }
.prep-zone-cue{
  margin-top:-2px;
  font-family:var(--mono);
  font-size:.68rem;
  font-weight:800;
  letter-spacing:.08em;
  color:var(--muted);
}
.prep-zone-items{
  flex:1;
  display:flex; flex-wrap:wrap; gap:6px;
  align-items:flex-start; justify-content:center;
  width:100%;
  min-height:60px;
}
.prep-zone.has-item{ background:var(--card-2); border-style:solid; }
.prep-zone.armed   { background:var(--soft); border-color:var(--accent); border-style:solid; }
.prep-zone.right   { background:#e6f5dd; border-color:#7bc36b; border-style:solid; }
.prep-zone.wrong   { background:#ffe5e0; border-color:#e7a8a0; border-style:solid; }
.prep-zone-items > .prep-placed{
  background:#fff;
  border:1px solid var(--line-2);
  color:var(--brand-2);
  font-family:var(--display); font-weight:700;
  font-size:.85rem;
  padding:5px 10px;
  border-radius:30px;
  display:inline-flex; align-items:center; gap:5px;
  cursor:pointer;
  animation:prepLand .5s cubic-bezier(.34,1.56,.64,1);
}
.prep-zone-items > .prep-placed.right{ background:#d8f5d2; border-color:#9bc886; color:#2d6a23; }
.prep-zone-items > .prep-placed.wrong{ background:#ffd6d6; border-color:#e7a8a0; color:#9a2222; }
.prep-pool{
  display:flex; flex-wrap:wrap; gap:8px;
  justify-content:center;
  max-width:780px; margin:0 auto 6px;
  padding:14px;
  background:var(--card-2);
  border:1px dashed var(--line-2);
  border-radius:18px;
  min-height:70px;
}
.prep-obj{
  background:var(--accent-3);
  border:2px solid var(--line-2);
  color:var(--brand-2);
  font-family:var(--display); font-weight:700;
  font-size:.95rem;
  padding:8px 14px;
  border-radius:40px;
  cursor:pointer;
  display:inline-flex; align-items:center; gap:6px;
  box-shadow:0 4px 0 var(--accent-3);
  transform-origin:50% 100%;
  animation:prepSpring .55s cubic-bezier(.34,1.56,.64,1) backwards;
}
.prep-obj .ico{ font-size:1.05rem; line-height:1; }
.prep-badge{
  background:#fff;
  border:1px solid rgba(125,77,30,.18);
  color:var(--accent);
  border-radius:999px;
  padding:2px 7px;
  font-family:var(--mono);
  font-size:.68rem;
  font-weight:900;
  letter-spacing:.08em;
}
.prep-obj:hover{ background:var(--accent-2); color:#fff; transform:translateY(-2px); }
.prep-obj.selected{
  background:var(--accent); color:#fff; border-color:var(--accent);
  box-shadow:0 4px 0 var(--brand-2);
  transform:translateY(-3px) scale(1.05);
}
.prep-obj.fly-out{
  animation:prepFly .42s cubic-bezier(.55,-.2,.35,1.4) forwards;
  pointer-events:none;
}
@keyframes prepSpring{
  0%   { opacity:0; transform:scale(.3) translateY(20px); }
  60%  { opacity:1; transform:scale(1.18) translateY(-4px); }
  85%  { transform:scale(.96) translateY(2px); }
  100% { transform:scale(1) translateY(0); }
}
@keyframes prepFly{
  0%   { transform:scale(1) translateY(0); opacity:1; }
  60%  { transform:scale(1.4) translateY(-22px); opacity:.8; }
  100% { transform:scale(.2) translateY(-46px); opacity:0; }
}
@keyframes prepLand{
  0%   { transform:scale(.4) translateY(-18px); opacity:0; }
  60%  { transform:scale(1.18) translateY(2px); opacity:1; }
  100% { transform:scale(1) translateY(0); opacity:1; }
}
.prep-rule{
  display:flex; flex-wrap:wrap; gap:10px; justify-content:center;
  max-width:780px; margin:0 auto 14px;
  font-family:var(--mono); font-size:.78rem; font-weight:700;
  color:var(--muted); letter-spacing:.04em;
}
.prep-rule span{
  background:var(--card-2);
  border:1px solid var(--line);
  border-radius:30px;
  padding:5px 12px;
}
@media (max-width:560px){
  .prep-hint-board,
  .prep-scene{ grid-template-columns:1fr; }
}

/* ── 9. FIND THE ERROR (pronouns) ──────────────── */
.error-sentence{
  background:var(--card-2);
  border:2px solid var(--line-2);
  border-radius:18px;
  padding:14px 16px;
  margin:0 auto 10px;
  max-width:600px;
  font-family:var(--display); font-weight:700;
  color:var(--brand-2);
  font-size:1.05rem;
  line-height:1.7;
  text-align:left;
}
.error-sentence .e-label{
  font-family:var(--mono); font-weight:700;
  font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
  color:var(--muted);
  display:block;
  margin-bottom:8px;
}
.error-word{
  display:inline-block;
  padding:2px 8px;
  margin:0 1px;
  border-radius:8px;
  cursor:pointer;
  transition:.12s;
}
.error-word:hover{ background:var(--soft); }
.error-word.found{ background:#d8f5d2; color:#2d6a23; text-decoration:line-through; cursor:default; }
.error-word.miss { background:#ffd6d6; color:#9a2222; animation:errorShake .3s ease; }
.error-fix{
  display:none;
  margin-top:10px;
  font-family:var(--body); font-weight:700; font-size:.95rem;
  color:#2d6a23;
  background:#e6f5dd;
  border:1px solid #9bc886;
  border-radius:12px;
  padding:8px 12px;
}
.error-sentence.solved .error-fix{ display:block; }
@keyframes errorShake{
  0%,100%{ transform:translateX(0); }
  25%   { transform:translateX(-3px); }
  50%   { transform:translateX(3px); }
  75%   { transform:translateX(-2px); }
}

/* ── 10. FINAL · LEADERBOARD ──────────────────── */
.final-area{
  display:flex; flex-direction:column; align-items:center; gap:14px;
}
.final-textarea{
