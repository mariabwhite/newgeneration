  font-size:1.15rem;
}
.lb-name-input{
  background:#fff;
  border:2px dashed var(--accent-2);
  border-radius:10px;
  padding:8px 12px;
  font-family:var(--body); font-weight:700;
  color:var(--brand-2);
  font-size:.95rem;
  width:100%;
  outline:none;
