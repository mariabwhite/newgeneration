<!DOCTYPE html>
<html lang="en" data-theme="cream">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Hello! Classroom Fun · LinguaBoost Lab</title>

<!-- Fonts (matched to China + Space + Easter set) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;800;900&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ════════════════════════════════════════════════════
   HELLO! CLASSROOM FUN · Pre-A1
   Topbar geometry from China + Easter; cream/orange palette
   ════════════════════════════════════════════════════ */

:root{
  --bg:        #fef8f0;
  --bg-2:      #fdf0e2;
  --card:      #ffffff;
  --card-2:    #fff9f0;
  --soft:      rgba(226, 106, 44, 0.08);
  --term-bg:   rgba(226, 106, 44, 0.10);

  --text:      #2b1c12;
  --muted:     #6b4f3c;
  --faint:     #997558;

  --accent:    #e26a2c;
  --accent-2:  #f08240;
  --accent-3:  #ffcf9a;
  --accent-on: #fff8f3;

  --brand:     #b8542a;
  --brand-2:   #8a3c1c;

  --line:      rgba(184, 84, 42, 0.14);
  --line-2:    rgba(184, 84, 42, 0.26);

  --ok:        #2f7d52;
  --warn:      #c0392b;

  --display:   "Unbounded", "Nunito", "Manrope", system-ui, sans-serif;
  --body:      "Manrope", "Nunito", system-ui, sans-serif;
  --mono:      "JetBrains Mono", Consolas, monospace;

  --radius:    1.2rem;
  --shadow:    0 12px 28px rgba(184, 84, 42, 0.14);
}

*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0; min-height:100vh;
  font-family:var(--body);
  color:var(--text);
  background:linear-gradient(145deg, var(--bg) 0%, var(--bg-2) 100%);
  background-attachment:fixed;
  -webkit-tap-highlight-color:transparent;
}
a{color:inherit;text-decoration:none;}
h1,h2,h3,h4,p{margin:0;}
button,input,select,textarea{font:inherit;}
img{max-width:100%;height:auto;display:block;}

/* ── TOPBAR (China + Easter geometry, exact) ──── */
.topbar{
  position:sticky; top:0; z-index:100;
  display:flex; align-items:center; gap:16px;
  padding:10px clamp(16px,3vw,28px);
  background:color-mix(in srgb, var(--bg) 88%, transparent);
  border-bottom:1px solid var(--line);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  min-height:56px;
}
.brand{display:flex;align-items:center;gap:12px;}
.brand-mark{
  width:36px; height:36px;
  border:1px solid var(--line-2); border-radius:8px;
  background:var(--soft);
  display:grid; place-items:center; position:relative;
  font-family:var(--display); font-size:20px; font-weight:900; color:var(--accent);
}
.brand-mark::after{
  content:""; position:absolute; right:4px; bottom:4px;
  width:5px; height:5px; border-radius:50%; background:var(--brand);
}
.brand-copy{display:grid;gap:2px;}
.brand-name{font-family:var(--display); font-size:14px; font-weight:800; letter-spacing:-.02em; line-height:1; color:var(--text);}
.brand-tag{font-family:var(--mono); font-size:9px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--faint);}
.topbar-nav{display:flex; gap:clamp(12px,2vw,22px); margin-left:12px; flex-wrap:wrap;}
.top-link{
  font-family:var(--mono); font-size:10px; font-weight:700;
  letter-spacing:.14em; text-transform:uppercase;
  color:var(--muted); transition:color .18s; cursor:pointer;
}
.top-link:hover, .top-link.active{ color:var(--accent); }

/* ── WRAP ──────────────────────────────────────── */
.wrap{
  max-width:1240px;
  margin:0 auto;
  padding:24px clamp(16px,3vw,28px) 64px;
}
.crumbs{
  display:flex; flex-wrap:wrap; gap:8px;
  font-family:var(--mono); font-size:10px; font-weight:700;
  letter-spacing:.12em; text-transform:uppercase;
  color:var(--muted);
  margin:8px 0 18px;
}
.crumbs .sep{opacity:.4;}
.crumbs a:hover{color:var(--accent);}
.crumbs .here{color:var(--accent);}

/* ── HERO BANNER (China + Pink pattern) ──────── */
.hero-banner{
  position:relative;
  border-radius:var(--radius);
  overflow:hidden;
  margin-bottom:24px;
  border:1px solid var(--line);
  box-shadow:var(--shadow);
  background:linear-gradient(135deg, #fff5e6 0%, #ffe4c4 50%, #ffd1a3 100%);
  /* Sized by content when no image; image expands when present */
  min-height:280px;
}
/* When the image actually loads, snap to the design aspect ratio */
.hero-banner.has-img{
  aspect-ratio:1672/941;
}
.hero-banner-img{
  position:absolute; inset:0;
  width:100%; height:100%;
  object-fit:cover;
  object-position:center center;
  display:block;
  z-index:0;
}
.hero-banner-overlay{
  position:relative; z-index:2;
  padding:clamp(24px,4vw,52px);
  display:flex; align-items:center;
  min-height:inherit;
}
.hero-banner.has-img .hero-banner-overlay{
  position:absolute; inset:0;
  background:linear-gradient(to right,
    rgba(255, 245, 232, 0.92) 0%,
    rgba(255, 245, 232, 0.78) 32%,
    rgba(255, 245, 232, 0.30) 50%,
    rgba(255, 245, 232, 0.0) 60%);
}
/* Decorative right-side icon when image is missing, hidden when image present */
.hero-banner::after{
  content:"📖";
  position:absolute;
  right:clamp(24px,5vw,72px); top:50%;
  transform:translateY(-50%);
  font-size:clamp(3rem,8vw,6.5rem);
  opacity:.55;
  filter:drop-shadow(0 4px 8px rgba(184,84,42,.18));
  pointer-events:none;
}
.hero-banner.has-img::after{ display:none; }
.hero-banner-overlay > .hero-content{
  max-width:520px;
}
.hero-eyebrow{
  font-family:var(--mono); font-size:11px; font-weight:700;
  letter-spacing:.18em; text-transform:uppercase;
  color:var(--accent);
  margin-bottom:12px;
}
.hero-title{
  font-family:var(--display); font-weight:900;
  font-size:clamp(1.7rem, 4.2vw, 3.2rem);
  line-height:1.05; letter-spacing:-.02em; color:var(--text);
  margin-bottom:12px;
  text-shadow:0 1px 0 rgba(255,255,255,.5);
}
.hero-title em{ color:var(--accent); font-style:normal; }
.hero-lead{
  font-size:clamp(.95rem, 1.4vw, 1.08rem);
  line-height:1.55;
  color:var(--muted); margin:0 0 16px;
}
.hero-meta{
  display:flex; flex-wrap:wrap; gap:8px;
}
.meta-pill{
  background:rgba(255,255,255,.85);
  border:1px solid var(--line-2);
  color:var(--brand-2);
  font-family:var(--mono); font-size:11px; font-weight:700;
  padding:6px 12px; border-radius:60px;
  letter-spacing:.06em;
  backdrop-filter:blur(2px);
}
@media (max-width:760px){
  .hero-banner{ aspect-ratio:auto; min-height:340px; }
  .hero-banner-overlay{
    background:linear-gradient(to bottom,
      rgba(255, 245, 232, 0.92) 0%,
      rgba(255, 245, 232, 0.78) 50%,
      rgba(255, 245, 232, 0.30) 75%,
      rgba(255, 245, 232, 0.0) 95%);
    align-items:flex-start;
  }
}

/* ── LESSON ILLUSTRATION POSTER ──────────────── */
.lesson-illustration{
  width:100%;
  max-width:none;
  margin:0 auto 14px;
  border-radius:var(--radius);
  overflow:hidden;
  border:1px solid var(--line);
  background:
    radial-gradient(circle at 16% 20%, rgba(255,255,255,.62), transparent 28%),
    linear-gradient(135deg, #fff4df 0%, #ffd9c9 48%, #ffe9b8 100%);
  box-shadow:0 6px 16px rgba(184,84,42,.10);
  aspect-ratio:1672/941;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:clamp(10px, 1.8vw, 24px);
}
.lesson-illustration img{
  width:auto;
  height:100%;
  max-width:100%;
  object-fit:contain;
  display:block;
  border-radius:18px;
}
.lesson-illustration.strip-fit{
  aspect-ratio:1580/306;
  padding:0;
}
.lesson-illustration.strip-fit img{
  width:100%;
  height:100%;
  max-width:none;
  object-fit:fill;
  border-radius:0;
}
.lesson-illustration.prep-poster{
  margin-bottom:42px;
}
.poster-gap-prep{
  height:86px;
}
.lesson-illustration.image-height-poster{
  aspect-ratio:auto;
  padding:0;
}
.lesson-illustration.image-height-poster img{
  width:100%;
  height:auto;
  max-width:none;
  object-fit:contain;
  border-radius:0;
}

/* ── PROGRESS HEADER ───────────────────────────── */
.progress-header{
  display:flex; justify-content:space-between; align-items:center;
  flex-wrap:wrap; gap:12px;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:60px;
  padding:10px 20px;
  margin-bottom:14px;
  box-shadow:var(--shadow);
}
/* Horizontal filling progress (China step-tracker pattern) */
.step-tracker{
  display:flex; align-items:center; gap:16px;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:60px;
  padding:10px 20px;
  margin-bottom:24px;
  box-shadow:var(--shadow);
}
.step-count{
  font-family:var(--mono); font-size:10px; font-weight:700;
  letter-spacing:.16em; text-transform:uppercase;
  color:var(--brand-2); white-space:nowrap;
}
.step-track{
  flex:1; height:8px;
  background:var(--bg-2);
  border-radius:6px; overflow:hidden;
  border:1px solid var(--line);
}
.step-fill{
  height:100%; width:0%;
  background:linear-gradient(90deg, var(--accent), var(--accent-2));
  border-radius:6px;
  transition:width .35s ease;
}
.step-name{
  font-family:var(--mono); font-size:11px; font-weight:700;
  color:var(--muted); white-space:nowrap;
}
@media (max-width:480px){
  .step-tracker{ padding:8px 14px; gap:10px; }
  .step-count{ font-size:9px; letter-spacing:.1em; }
  .step-name{ font-size:10px; }
}
.stars{ font-size:22px; letter-spacing:5px; }
.star-lit{ color:var(--accent); text-shadow:0 0 4px rgba(226,106,44,.45); }
.star-dim{ color:var(--accent-3); opacity:.55; }
.score{
  background:var(--accent);
  color:#fff;
  padding:6px 18px;
  border-radius:40px;
  font-family:var(--mono); font-weight:700; font-size:.8rem;
  letter-spacing:.08em;
}
.reset-progress{
  background:var(--accent-3);
  color:var(--brand-2);
  border:none;
  padding:6px 16px;
  border-radius:40px;
  font-family:var(--mono); font-weight:700; font-size:.7rem;
  letter-spacing:.1em; text-transform:uppercase;
  cursor:pointer;
  transition:.15s;
}
.reset-progress:hover{ background:var(--accent-2); color:#fff; }

/* ── SECTIONS ──────────────────────────────────── */
.section{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:clamp(18px,2.5vw,28px);
  margin-bottom:22px;
  box-shadow:var(--shadow);
  text-align:center;
}
.section-title{
  display:inline-block;
  font-family:var(--display);
  font-size:clamp(1.05rem, 2vw, 1.35rem);
  font-weight:800;
  background:var(--term-bg);
  color:var(--brand-2);
  padding:8px 24px;
  border-radius:60px;
  border:1px solid var(--line-2);
  margin-bottom:18px;
  letter-spacing:-.01em;
}
.section .feedback{
  background:var(--card-2);
  border:1px solid var(--line);
  border-radius:60px;
  padding:10px 18px;
  margin:14px auto 0;
  text-align:center;
  color:var(--brand-2);
  font-family:var(--mono); font-size:.78rem; font-weight:700;
  letter-spacing:.04em;
  max-width:560px;
}
.section .feedback.ok{ background:#e6f5dd; color:#2f6d23; border-color:#9bc886; }
.section .feedback.err{ background:#ffe5e0; color:#9a2222; border-color:#e7a8a0; }

/* ── BUTTONS ───────────────────────────────────── */
.btn{
  background:var(--accent);
  border:none;
  color:#fff;
  font-family:var(--display); font-weight:800;
  font-size:.95rem;
  padding:11px 22px;
  border-radius:60px;
  cursor:pointer;
  box-shadow:0 4px 0 var(--brand-2);
  transition:transform .05s linear, box-shadow .05s linear;
  margin:8px 6px 0;
  letter-spacing:-.01em;
}
.btn:hover{ background:var(--accent-2); }
.btn:active{ transform:translateY(2px); box-shadow:0 1px 0 var(--brand-2); }
.btn:disabled{ background:var(--accent-3); color:var(--brand-2); cursor:not-allowed; box-shadow:0 2px 0 var(--accent-3); }
.btn.ghost{
  background:#fff; color:var(--brand-2);
  border:2px solid var(--line-2); box-shadow:0 4px 0 var(--accent-3);
}
.btn.ghost:hover{ border-color:var(--accent); color:var(--accent); }

/* ── 1. COMIC STRIP ────────────────────────────── */
.comic-strip{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(170px, 1fr));
  gap:14px;
  max-width:920px; margin:0 auto;
}
.comic-panel{
  background:var(--card-2);
  border:2px solid var(--line-2);
  border-radius:18px;
  padding:14px 12px;
  cursor:pointer;
  transition:.12s;
  display:flex; flex-direction:column; align-items:center; gap:8px;
}
.comic-panel:hover{ border-color:var(--accent); transform:translateY(-2px); }
.comic-bubble{
  background:#fff; border:1px solid var(--line-2);
  border-radius:18px;
  padding:8px 14px;
  font-family:var(--display); font-weight:800;
  color:var(--brand-2); font-size:1rem;
}
.comic-avatar{ font-size:2rem; }
.comic-translation{
  font-family:var(--mono); font-size:.78rem; font-weight:700;
  color:var(--muted); letter-spacing:.04em;
}

/* ── 2. SIMON SAYS (animated) ──────────────────── */
.simon-stage{
  position:relative;
  background:linear-gradient(180deg, #fff5e6 0%, #ffe4c4 100%);
  border:2px solid var(--line-2);
  border-radius:24px;
  height:220px;
  margin:0 auto 14px;
  max-width:640px;
  display:flex; align-items:flex-end; justify-content:center;
  overflow:hidden;
}
.simon-stage::after{
  content:"";
  position:absolute; left:0; right:0; bottom:0;
  height:24px;
  background:linear-gradient(180deg, transparent, rgba(184,84,42,.10));
  pointer-events:none;
}
.simon-kid{
  font-size:5.5rem;
  line-height:1;
  margin-bottom:14px;
  display:inline-block;
  transform-origin:50% 100%;
  filter:drop-shadow(0 4px 6px rgba(184,84,42,.15));
  user-select:none;
}
.simon-prompt{
  position:absolute; top:14px; left:50%;
  transform:translateX(-50%);
  background:#fff;
  border:2px solid var(--line-2);
  border-radius:40px;
  padding:6px 18px;
  font-family:var(--display); font-weight:800; font-size:.95rem;
  color:var(--brand-2);
  white-space:nowrap;
  opacity:0;
  transition:opacity .22s;
  max-width:90%; overflow:hidden; text-overflow:ellipsis;
}
.simon-prompt.show{ opacity:1; }
.simon-prompt.trick{ background:#ffe5e0; color:#9a2222; border-color:#e7a8a0; }
.simon-countdown{
  position:absolute; inset:0;
  display:none; align-items:center; justify-content:center;
  background:rgba(255,245,232,.85);
  font-family:var(--display); font-weight:900;
  font-size:5rem;
  color:var(--accent);
  z-index:3;
}
.simon-countdown.show{ display:flex; }
.simon-countdown.pop{ animation:simonPop .55s ease; }
.simon-start-panel{
  position:absolute;
  inset:0;
  z-index:4;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:12px;
  padding:18px;
  text-align:center;
  background:rgba(255,245,232,.92);
  color:var(--brand-2);
  font-family:var(--display);
  font-weight:800;
}
.simon-start-panel.hide{ display:none; }
.simon-start-panel p{
  max-width:420px;
  margin:0;
  font-family:var(--body);
  font-weight:700;
  font-size:.98rem;
  line-height:1.45;
}
.simon-start-panel .btn{ margin:0; }
.simon-grid.locked .simon-btn{ opacity:.55; }
@keyframes simonPop{
  0%   { transform:scale(.4); opacity:0; }
  40%  { transform:scale(1.15); opacity:1; }
  100% { transform:scale(1); opacity:1; }
}
/* action animations on .simon-kid */
.simon-kid.act-stand{ animation:standUp .9s ease; }
.simon-kid.act-sit  { animation:sitDown .9s ease; }
.simon-kid.act-clap { animation:clapHands 1s ease; }
.simon-kid.act-nose { animation:touchNose 1s ease; }
.simon-kid.act-jump { animation:jumpUp .9s ease; }
@keyframes standUp {
  0%   { transform:scaleY(.55) translateY(28px); }
  60%  { transform:scaleY(1.05) translateY(-4px); }
  100% { transform:scaleY(1) translateY(0); }
}
@keyframes sitDown {
  0%   { transform:scaleY(1) translateY(0); }
  60%  { transform:scaleY(.55) translateY(28px); }
  100% { transform:scaleY(.55) translateY(28px); }
}
@keyframes clapHands {
  0%,100%{ transform:translateX(0) rotate(0); }
  20%   { transform:translateX(-6px) rotate(-3deg); }
  40%   { transform:translateX(6px)  rotate(3deg); }
  60%   { transform:translateX(-6px) rotate(-3deg); }
  80%   { transform:translateX(6px)  rotate(3deg); }
}
@keyframes touchNose {
  0%,100%{ transform:rotate(0); }
  30%    { transform:rotate(-6deg) translateX(-3px); }
  60%    { transform:rotate(6deg)  translateX(3px); }
}
@keyframes jumpUp {
  0%,100%{ transform:translateY(0); }
  40%    { transform:translateY(-46px) scaleY(1.04); }
  70%    { transform:translateY(0) scaleY(.96); }
  85%    { transform:translateY(-8px); }
}

.simon-grid{
  display:flex; flex-wrap:wrap; gap:12px;
  justify-content:center; max-width:640px; margin:0 auto;
}
.simon-btn{
  background:#fff;
  border:2px solid var(--line-2);
  color:var(--brand-2);
  font-family:var(--display); font-weight:800;
  font-size:1rem;
  padding:12px 20px;
  border-radius:60px;
  cursor:pointer;
  box-shadow:0 4px 0 var(--accent-3);
  transition:.1s;
  display:inline-flex; align-items:center; gap:8px;
}
.simon-btn .ico{ font-size:1.1rem; line-height:1; }
.simon-btn:hover{ border-color:var(--accent); }
.simon-btn:active{ transform:translateY(2px); box-shadow:0 1px 0 var(--accent-3); }
.simon-btn:disabled{ opacity:.55; cursor:not-allowed; }

/* ── 3 / 9. FLIP CARDS ────────────────────────── */
.flip-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));
  gap:14px; perspective:800px;
  max-width:760px; margin:0 auto;
}
.flip-card{ background:transparent; height:130px; cursor:pointer; }
.flip-inner{
  position:relative; width:100%; height:100%;
  transition:transform .5s; transform-style:preserve-3d;
  border-radius:20px;
}
.flip-card.flipped .flip-inner{ transform:rotateY(180deg); }
.flip-front, .flip-back{
  position:absolute; inset:0;
  backface-visibility:hidden;
  border-radius:20px;
  display:flex; align-items:center; justify-content:center;
  background:#fff;
  border:2px solid var(--line-2);
  font-family:var(--display); font-weight:800;
  font-size:1.05rem;
  color:var(--brand-2);
  text-align:center;
  padding:8px;
  box-shadow:0 6px 14px rgba(184,84,42,.08);
}
.flip-back{
  transform:rotateY(180deg);
  background:var(--term-bg);
}
.flip-grid.pastel .flip-front,
.flip-grid.pastel .flip-back{
  background:#fff5e6;
  border-color:#ffd6a3;
  color:#7d4d1e;
}
.flip-grid.pastel .flip-back{ background:#ffe6cc; }

/* ── 4. SNAKE ─────────────────────────────────── */
.snake-area{
  display:flex; flex-direction:column; align-items:center;
  gap:12px;
  user-select:none; -webkit-user-select:none; touch-action:manipulation;
}
.snake-target{
  font-family:var(--display); font-weight:800;
  font-size:1.05rem;
  color:var(--brand-2);
  background:var(--card-2);
  border:2px solid var(--line-2);
  border-radius:40px;
  padding:8px 18px;
  display:inline-flex; align-items:center; gap:8px;
}
.snake-target em{
  color:var(--accent); font-style:normal;
}
.snake-canvas-wrap{
  position:relative;
  width:100%; max-width:500px;
}
.snake-canvas{
  background:#1e3a1e;
  border-radius:14px;
  border:3px solid var(--brand-2);
