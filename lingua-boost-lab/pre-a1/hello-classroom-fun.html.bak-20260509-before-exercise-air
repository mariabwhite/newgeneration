<script>
/* ════════════════════════════════════════════════════
   LESSON SCRIPT
   10 Activities:
     0 comic   1 simon    2 flip-hello   3 snake     4 audio
     5 builder 6 truefals 7 prepositions 8 pronouns  9 final
   ════════════════════════════════════════════════════ */

(() => {
  /* ── SPEECH ─────────────────────────────────── */
  let englishVoices = [];

  function refreshEnglishVoices(){
    if(!window.speechSynthesis) return [];
    englishVoices = window.speechSynthesis.getVoices()
      .filter(v => /^en[-_]/i.test(v.lang || '') || /english/i.test(v.name || ''));
    return englishVoices;
  }

  function pickEnglishVoice(gender){
    const voices = englishVoices.length ? englishVoices : refreshEnglishVoices();
    if(!voices.length) return null;
    const preferred = voices
      .map(v => {
        const name = (v.name || '').toLowerCase();
        const lang = (v.lang || '').toLowerCase();
        let score = lang.startsWith('en-us') ? 10 : lang.startsWith('en-gb') ? 8 : 4;
        if(/natural|online|google|jenny|aria|guy|david|mark|zira|sonia|libby|ryan/.test(name)) score += 6;
        if(gender === 'male' && /guy|david|mark|ryan/.test(name)) score += 8;
        if(gender === 'female' && /jenny|aria|zira|sonia|libby/.test(name)) score += 8;
        return { voice:v, score };
      })
      .sort((a, b) => b.score - a.score);
    return preferred[0].voice;
  }

  if(window.speechSynthesis){
    refreshEnglishVoices();
    window.speechSynthesis.onvoiceschanged = refreshEnglishVoices;
  }

  function speak(text, opts){
    if(!opts) opts = {};
    if(!window.speechSynthesis) return;
    window.speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang  = 'en-US';
    const voice = pickEnglishVoice(opts.gender);
    if(voice){
      u.voice = voice;
      u.lang = voice.lang || 'en-US';
    }
    u.rate  = (typeof opts.rate  === 'number') ? opts.rate  : 0.88;
    u.pitch = (typeof opts.pitch === 'number') ? opts.pitch : 1;
    window.speechSynthesis.speak(u);
  }

  /* ── PARTICLES ──────────────────────────────── */
  const particleCanvas = document.getElementById('particle-canvas');
  const pCtx = particleCanvas.getContext('2d');
  let particles = [];
  let particleAnim = null;
  function resizeParticle(){
    particleCanvas.width  = window.innerWidth;
    particleCanvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resizeParticle);
  resizeParticle();
  function createParticles(x, y, count){
    if(typeof count !== 'number') count = 20;
    for(let i = 0; i < count; i++){
      particles.push({
        x: x || window.innerWidth / 2,
        y: y || window.innerHeight / 2,
        vx: (Math.random() - 0.5) * 6,
        vy: (Math.random() - 0.5) * 6 - 2,
        life: 1,
        size: Math.random() * 6 + 3,
        color: `hsl(${Math.random() * 30 + 25}, 80%, 55%)`
      });
    }
    if(!particleAnim) particleAnim = requestAnimationFrame(drawParticles);
  }
  function drawParticles(){
    pCtx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);
    let alive = false;
    for(let i = 0; i < particles.length; i++){
      const p = particles[i];
      p.x += p.vx; p.y += p.vy; p.vy += 0.1; p.life -= 0.02;
      if(p.life <= 0){ particles.splice(i, 1); i--; continue; }
      alive = true;
      pCtx.globalAlpha = p.life * 0.85;
      pCtx.fillStyle   = p.color;
      pCtx.beginPath();
      pCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      pCtx.fill();
    }
    pCtx.globalAlpha = 1;
    if(alive) particleAnim = requestAnimationFrame(drawParticles);
    else particleAnim = null;
  }

  /* ── PROGRESS ───────────────────────────────── */
  const ACTIVITIES = 10;
  const STORAGE_KEY = 'helloClassroomProgress_v3';
  const NAME_KEY    = 'helloClassroomKidName_v3';
  let completed = new Array(ACTIVITIES).fill(false);

  function loadProgress(){
    try{
      const saved = localStorage.getItem(STORAGE_KEY);
      if(saved){
        const arr = JSON.parse(saved);
        if(Array.isArray(arr) && arr.length === ACTIVITIES){
          completed = arr.map(Boolean);
        }
      }
    }catch(_){}
    updateStarsUI();
  }
  function saveProgress(){
    try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(completed)); }catch(_){}
  }
  function updateStarsUI(){
    const starCount = completed.filter(Boolean).length;
    const cont = document.getElementById('starContainer');
    cont.innerHTML = '';
    for(let i = 0; i < ACTIVITIES; i++){
      const s = document.createElement('span');
      s.textContent = '★';
      s.classList.add(i < starCount ? 'star-lit' : 'star-dim');
      cont.appendChild(s);
    }
    document.getElementById('scoreDisplay').textContent = `${starCount} / ${ACTIVITIES}`;
    const pf = document.getElementById('progressFill');
    const pt = document.getElementById('progressText');
    if(pf) pf.style.width = `${(starCount / ACTIVITIES) * 100}%`;
    if(pt) pt.textContent = `${starCount} / ${ACTIVITIES} activities`;
    const ks = document.getElementById('kidStars');
    if(ks) ks.textContent = `${starCount} ★`;
    if(starCount === ACTIVITIES){
      const cm = document.getElementById('completionMsg');
      if(cm) cm.innerHTML = 'Congratulations! You finished all 10 activities!';
      const fm = document.getElementById('finalMedal');
      if(fm) fm.textContent = '★';
    }
    refreshFinishButtonState();
  }
  function completeActivity(idx){
    if(idx < 0 || idx >= ACTIVITIES) return;
    if(completed[idx]) return;
    completed[idx] = true;
    saveProgress();
    updateStarsUI();
    createParticles(window.innerWidth / 2, window.innerHeight / 2, 18);
    if(completed.filter(Boolean).length === ACTIVITIES){
      createParticles(window.innerWidth / 2, window.innerHeight / 2, 60);
      // Speech is user-triggered only.
    }
  }
  document.getElementById('resetProgressBtn').addEventListener('click', () => {
    completed.fill(false);
    saveProgress();
    try{ localStorage.removeItem(NAME_KEY); }catch(_){}
    location.reload();
  });

  /* ── PHRASES ────────────────────────────────── */
  const phrases = [
    { en:"Hello",                  ru:"Привет" },
    { en:"What is your name?",     ru:"Как тебя зовут?" },
    { en:"How are you?",           ru:"Как дела?" },
    { en:"I am fine, thank you",   ru:"У меня всё хорошо, спасибо" },
    { en:"Goodbye",                ru:"До свидания" },
    { en:"See you later",          ru:"Увидимся позже" }
  ];

  /* ── 1. COMIC STRIP (idx 0) ─────────────────── */
  const comicContainer = document.getElementById('comicStrip');
  phrases.forEach((p, idx) => {
    const panel = document.createElement('div');
    panel.className = 'comic-panel';
    panel.innerHTML = `
      <div class="comic-bubble">${p.en}</div>
      <div class="comic-avatar">${idx % 2 === 0 ? '👧' : '👦'}</div>
      <div class="comic-translation">${p.ru}</div><button class="sound-chip" type="button">&#128266; Listen</button>`;
    panel.addEventListener('click', () => {
      speak(p.en);
      completeActivity(0);
    });
    comicContainer.appendChild(panel);
  });

  /* ── 2. SIMON SAYS (idx 1) ──────────────────── */
  const simonFeedback   = document.getElementById('simonFeedback');
  const simonKid        = document.getElementById('simonKid');
  const simonPrompt     = document.getElementById('simonPrompt');
  const simonCountdown  = document.getElementById('simonCountdown');
  const simonStartPanel = document.getElementById('simonStartPanel');
  const simonStartBtn   = document.getElementById('simonStartBtn');
  const simonGrid       = document.getElementById('simonGrid');
  const SIMON_HITS_FOR_STAR = 3;
  const SIMON_KID_BY_ACTION = {
    stand:'🧍', sit:'🪑', clap:'👏', nose:'🤔', jump:'🤸'
  };
  let simonHits = 0;
  let simonBusy = false;
  let simonStarted = false;

  function simonSetButtonsEnabled(enabled){
    document.querySelectorAll('.simon-btn').forEach(b => b.disabled = !enabled);
    if(simonGrid) simonGrid.classList.toggle('locked', !enabled);
  }
  simonSetButtonsEnabled(false);

  function simonSetCountdown(text, animate){
    if(text === null){
      simonCountdown.classList.remove('show','pop');
      simonCountdown.textContent = '';
      return;
    }
    simonCountdown.textContent = text;
    simonCountdown.classList.add('show');
    if(animate){
      simonCountdown.classList.remove('pop');
      // force reflow so animation restarts
      void simonCountdown.offsetWidth;
      simonCountdown.classList.add('pop');
    }
  }
  function simonShowPrompt(text, isTrick){
    simonPrompt.textContent = text;
    simonPrompt.classList.toggle('trick', !!isTrick);
    simonPrompt.classList.add('show');
  }
  function simonHidePrompt(){ simonPrompt.classList.remove('show','trick'); }

  async function simonRun(action, label){
    if(!simonStarted || simonBusy) return;
    simonBusy = true;
    document.querySelectorAll('.simon-btn').forEach(b => b.disabled = true);
    simonHidePrompt();

    // ~10% chance of "trick" (no Simon says) round, but only after first hit
    const isTrick = simonHits >= 1 && Math.random() < 0.18;
    const intro = isTrick ? 'Just…' : 'Simon says…';
    simonShowPrompt(intro, isTrick);
    speak(intro, { rate:0.9 });

    // 3-2-1 countdown
    for(const n of ['3','2','1']){
      simonSetCountdown(n, true);
      speak(n, { rate:1.05, pitch:1.3 });
      await new Promise(r => setTimeout(r, 700));
    }
    simonSetCountdown(null);

    // Reveal action
    simonShowPrompt(`${intro} ${label}!`, isTrick);
    const niceLabel = label.toLowerCase();
    speak(isTrick ? niceLabel : `Simon says, ${niceLabel}!`, { rate:0.9 });

    // Animate kid (always — kid demonstrates regardless, child decides whether to copy)
    const animClass = `act-${action}`;
    simonKid.classList.remove('act-stand','act-sit','act-clap','act-nose','act-jump');
    void simonKid.offsetWidth;
    simonKid.classList.add(animClass);
    const replaceEmoji = SIMON_KID_BY_ACTION[action] || '🧒';
    simonKid.textContent = replaceEmoji;

    await new Promise(r => setTimeout(r, 1100));

    // Restore default kid
    simonKid.classList.remove(animClass);
    simonKid.textContent = '🧒';

    // Score: real Simon round = +1; trick round handled later
    if(!isTrick){
      simonHits++;
      simonFeedback.textContent = simonHits >= SIMON_HITS_FOR_STAR
        ? `Awesome — ${simonHits} actions done!`
        : `Great! ${simonHits} of ${SIMON_HITS_FOR_STAR}.`;
      if(simonHits >= SIMON_HITS_FOR_STAR) completeActivity(1);
    } else {
      simonFeedback.innerHTML = `<strong>Tricky!</strong> No "Simon says" — you should freeze!`;
    }

    setTimeout(() => {
      simonHidePrompt();
      document.querySelectorAll('.simon-btn').forEach(b => b.disabled = false);
      simonBusy = false;
    }, 900);
  }

  if(simonStartBtn){
    simonStartBtn.addEventListener('click', () => {
      simonStarted = true;
      simonStartPanel.classList.add('hide');
      simonSetButtonsEnabled(true);
      simonFeedback.textContent = 'Choose an action. If the bubble says Simon says, copy it!';
      // Speech is user-triggered only.
    });
  }
  document.querySelectorAll('.simon-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      simonRun(btn.dataset.action, btn.dataset.label);
    });
  });

  /* ── 3. FLIP CARDS (idx 2) ─────────────────── */
  const flipContainer = document.getElementById('helloFlipGrid');
  let flipFlipped = 0;
  phrases.forEach(p => {
    const card = document.createElement('div');
    card.className = 'flip-card';
    card.innerHTML = `
      <div class="flip-inner">
        <div class="flip-front">${p.en}</div>
        <div class="flip-back">${p.ru}</div>
      </div>`;
    let didFlip = false;
    card.addEventListener('click', () => {
      card.classList.toggle('flipped');
      if(card.classList.contains('flipped')){
        speak(p.en);
        if(!didFlip){ didFlip = true; flipFlipped++; }
        if(flipFlipped >= 3) completeActivity(2);
      }
    });
    flipContainer.appendChild(card);
  });

  /* ── 4. SNAKE (idx 3) ───────────────────────── */
  const SNAKE_COLS = 25, SNAKE_ROWS = 20, SNAKE_CELL = 20;
  const SNAKE_TICK_MS = 240;             // slower for kids
  const SNAKE_GOAL = 3;                  // phrases to eat for the star

  const snakeCanvas    = document.getElementById('snakeCanvas');
  const sCtx           = snakeCanvas.getContext('2d');
  const snakeFeedback  = document.getElementById('snakeFeedback');
  const snakeWordList  = document.getElementById('snakeWordList');
  const snakeOverlay   = document.getElementById('snakeOverlay');
  const snakeOverlayT  = document.getElementById('snakeOverlayTitle');
  const snakeOverlayS  = document.getElementById('snakeOverlaySub');
  const snakeStartBtn  = document.getElementById('snakeStartBtn');
  const snakeRestartBtn= document.getElementById('restartSnakeBtn');
  const snakeTargetEl  = document.getElementById('snakeTargetWord');

  let snake          = [{x:10, y:10}, {x:9, y:10}, {x:8, y:10}];
  let snakeDir       = 'RIGHT';
  let snakeQueuedDir = 'RIGHT';
  let snakeFood      = {x:15, y:10};
  let snakeCollected = [];
  let snakeInterval  = null;
  let snakeActive    = false;

  function snakeCurrentPhrase(){
    return phrases[snakeCollected.length % phrases.length];
  }
  function snakeUpdateTarget(){
    const p = snakeCurrentPhrase();
    if(snakeTargetEl) snakeTargetEl.textContent = p.en;
  }
  function snakeRandomFood(){
    let f, tries = 0;
    do {
      f = { x: Math.floor(Math.random() * SNAKE_COLS), y: Math.floor(Math.random() * SNAKE_ROWS) };
      tries++;
    } while(snake.some(s => s.x === f.x && s.y === f.y) && tries < 80);
    snakeFood = f;
  }
  function snakeUpdate(){
    if(!snakeActive) return;
    // commit queued direction (prevents 180° self-collision from fast double tap)
    if(!snakeIsOpposite(snakeQueuedDir, snakeDir)) snakeDir = snakeQueuedDir;

    const h = { x: snake[0].x, y: snake[0].y };
    if(snakeDir === 'RIGHT') h.x++;
    if(snakeDir === 'LEFT')  h.x--;
    if(snakeDir === 'UP')    h.y--;
    if(snakeDir === 'DOWN')  h.y++;

    // wall
    if(h.x < 0 || h.x >= SNAKE_COLS || h.y < 0 || h.y >= SNAKE_ROWS){
      return snakeGameOver('Bumped a wall');
    }
    // self-collision: ignore the tail since it will move away
    const body = snake.slice(0, snake.length - 1);
    if(body.some(s => s.x === h.x && s.y === h.y)){
      return snakeGameOver('Bumped yourself');
    }

    snake.unshift(h);
    if(h.x === snakeFood.x && h.y === snakeFood.y){
      const eaten = snakeCurrentPhrase().en;
      snakeCollected.push(eaten);
      speak(eaten);
      snakeWordList.innerHTML = snakeCollected
        .map(w => `<span class="word-chip">${w}</span>`).join('');
      snakeFeedback.textContent = snakeCollected.length >= SNAKE_GOAL
        ? `You caught ${snakeCollected.length} — keep going if you want!`
        : `Yum! ${snakeCollected.length} of ${SNAKE_GOAL} eaten.`;
      if(snakeCollected.length >= SNAKE_GOAL) completeActivity(3);
      snakeUpdateTarget();
      snakeRandomFood();
    } else {
      snake.pop();
    }
    snakeDraw();
  }
  function snakeDraw(){
    const w = snakeCanvas.width, h = snakeCanvas.height;
    sCtx.clearRect(0, 0, w, h);

    // grid stripes for readability
    sCtx.fillStyle = 'rgba(255,255,255,0.04)';
    for(let y = 0; y < SNAKE_ROWS; y++){
      if(y % 2 === 0) sCtx.fillRect(0, y * SNAKE_CELL, w, SNAKE_CELL);
    }

    // food: pulsating round-ish chip
    const fx = snakeFood.x * SNAKE_CELL, fy = snakeFood.y * SNAKE_CELL;
    sCtx.fillStyle = '#ffb347';
    sCtx.beginPath();
    if(sCtx.roundRect){
      sCtx.roundRect(fx + 2, fy + 2, SNAKE_CELL - 4, SNAKE_CELL - 4, 6);
    } else {
      sCtx.rect(fx + 2, fy + 2, SNAKE_CELL - 4, SNAKE_CELL - 4);
    }
    sCtx.fill();
    sCtx.fillStyle = '#fff';
    sCtx.fillRect(fx + 8, fy + 5, 3, 3);

    // body
    for(let i = snake.length - 1; i >= 1; i--){
      const s = snake[i];
      sCtx.fillStyle = i % 2 === 0 ? '#ffd95a' : '#f4bf30';
      sCtx.fillRect(s.x * SNAKE_CELL + 1, s.y * SNAKE_CELL + 1, SNAKE_CELL - 2, SNAKE_CELL - 2);
    }
    // head
    const head = snake[0];
    sCtx.fillStyle = '#ffe37a';
    sCtx.fillRect(head.x * SNAKE_CELL, head.y * SNAKE_CELL, SNAKE_CELL, SNAKE_CELL);
    // eyes
    sCtx.fillStyle = '#6d4b00';
    const ex = head.x * SNAKE_CELL, ey = head.y * SNAKE_CELL;
    let e1, e2;
    if(snakeDir === 'RIGHT'){ e1 = [ex+13, ey+4]; e2 = [ex+13, ey+12]; }
    else if(snakeDir === 'LEFT'){ e1 = [ex+4, ey+4]; e2 = [ex+4, ey+12]; }
    else if(snakeDir === 'UP'){ e1 = [ex+4, ey+4]; e2 = [ex+12, ey+4]; }
    else { e1 = [ex+4, ey+13]; e2 = [ex+12, ey+13]; }
    sCtx.fillRect(e1[0], e1[1], 3, 3);
    sCtx.fillRect(e2[0], e2[1], 3, 3);
  }
  function snakeShowOverlay(title, sub, btnText){
    if(!snakeOverlay) return;
    snakeOverlayT.textContent = title;
    snakeOverlayS.innerHTML   = sub;
    if(btnText){ snakeStartBtn.textContent = btnText; snakeStartBtn.style.display = ''; }
    else snakeStartBtn.style.display = 'none';
    snakeOverlay.classList.add('show');
  }
  function snakeHideOverlay(){
    if(snakeOverlay) snakeOverlay.classList.remove('show');
  }
  function snakeReset(){
    snake          = [{x:10, y:10}, {x:9, y:10}, {x:8, y:10}];
    snakeDir       = 'RIGHT';
    snakeQueuedDir = 'RIGHT';
    snakeCollected = [];
    snakeWordList.innerHTML = '';
    snakeUpdateTarget();
    snakeRandomFood();
    snakeDraw();
  }
  function snakeStart(){
    if(snakeInterval) clearInterval(snakeInterval);
    snakeReset();
    snakeActive   = true;
    snakeFeedback.innerHTML = `Catch <strong>${snakeCurrentPhrase().en}</strong> — eat ${SNAKE_GOAL} phrases for a star!`;
    snakeInterval = setInterval(snakeUpdate, SNAKE_TICK_MS);
    snakeHideOverlay();
  }
  function snakeGameOver(reason){
    snakeActive = false;
    if(snakeInterval){ clearInterval(snakeInterval); snakeInterval = null; }
    const got = snakeCollected.length;
    snakeFeedback.innerHTML = `${reason}! You caught <strong>${got}</strong> phrase${got === 1 ? '' : 's'}.`;
    snakeShowOverlay(
      got >= SNAKE_GOAL ? 'Great run!' : 'Game over',
      got >= SNAKE_GOAL
        ? `You caught ${got} phrases — well done!`
        : `You caught ${got} of ${SNAKE_GOAL}. Try again!`,
      '↻ New game'
    );
  }
  function snakeIsOpposite(a, b){
    return (a === 'LEFT'  && b === 'RIGHT') ||
           (a === 'RIGHT' && b === 'LEFT')  ||
           (a === 'UP'    && b === 'DOWN')  ||
           (a === 'DOWN'  && b === 'UP');
  }
  function snakeChangeDir(d){
    if(snakeIsOpposite(d, snakeDir)) return;
    snakeQueuedDir = d;
  }

  // Start / Restart
  snakeStartBtn.addEventListener('click', snakeStart);
  snakeRestartBtn.addEventListener('click', snakeStart);

  // D-pad: pointer events handle both mouse and touch reliably
  document.querySelectorAll('.snake-btn').forEach(btn => {
    const fire = (e) => {
      e.preventDefault();
      snakeChangeDir(btn.dataset.dir);
      btn.classList.add('pressed');
      setTimeout(() => btn.classList.remove('pressed'), 120);
    };
    btn.addEventListener('click', fire);
    btn.addEventListener('touchstart', fire, { passive:false });
  });

  // Keyboard
  window.addEventListener('keydown', (e) => {
    const map = { ArrowRight:'RIGHT', ArrowLeft:'LEFT', ArrowUp:'UP', ArrowDown:'DOWN' };
    if(map[e.key]){ e.preventDefault(); snakeChangeDir(map[e.key]); }
  });

  // Swipe on canvas
  (function attachSwipe(){
    let sx = 0, sy = 0, tracking = false;
    snakeCanvas.addEventListener('touchstart', (e) => {
      const t = e.changedTouches[0];
      sx = t.clientX; sy = t.clientY; tracking = true;
    }, { passive:true });
    snakeCanvas.addEventListener('touchend', (e) => {
      if(!tracking) return; tracking = false;
      const t = e.changedTouches[0];
      const dx = t.clientX - sx, dy = t.clientY - sy;
      if(Math.abs(dx) < 20 && Math.abs(dy) < 20) return;
      if(Math.abs(dx) > Math.abs(dy)) snakeChangeDir(dx > 0 ? 'RIGHT' : 'LEFT');
      else                            snakeChangeDir(dy > 0 ? 'DOWN' : 'UP');
    }, { passive:true });
  })();

  // Initial: idle state with overlay, no auto-start
  snakeReset();
  snakeShowOverlay(
    'Ready to play?',
    `Eat <strong>${SNAKE_GOAL}</strong> phrases to earn a star.<br>Use the arrows below, swipe, or your keyboard.`,
    '▶ Start'
  );

  /* ── 5. AUDIO DIALOG (idx 4) ────────────────── */
  const dialogText = "Hello! My name is Tom. What is your name? Hi Tom, I am Lily. Nice to meet you!";
  const audioQuestionsData = [
    { q:"What is the boy's name?",          options:["Tom","Lily"], answer:"Tom"  },
    { q:"What is the girl's name?",         options:["Tom","Lily"], answer:"Lily" },
    { q:"Do they say 'Nice to meet you'?",  options:["Yes","No"],   answer:"Yes"  }
  ];
  const audioContainer = document.getElementById('audioQuestions');
  audioQuestionsData.forEach((item, idx) => {
    const block = document.createElement('div');
    block.className = 'q-block';
    block.innerHTML = `<div class="q-text">${idx + 1}. ${item.q}</div>
                       <div class="q-options" data-q="${idx}"></div>`;
    const opts = block.querySelector('.q-options');
    item.options.forEach(opt => {
      const o = document.createElement('button');
      o.type = 'button';
      o.className = 'q-opt';
      o.textContent = opt;
      o.addEventListener('click', () => {
        opts.querySelectorAll('.q-opt').forEach(x => x.classList.remove('selected'));
        o.classList.add('selected');
      });
      opts.appendChild(o);
    });
    audioContainer.appendChild(block);
  });
  document.getElementById('playMaleBtn').addEventListener('click',   () => speak(dialogText, { gender:'male', force:true }));
  document.getElementById('playFemaleBtn').addEventListener('click', () => speak(dialogText, { gender:'female', force:true }));
  document.getElementById('checkAudioBtn').addEventListener('click', () => {
    let correct = 0;
    audioContainer.querySelectorAll('.q-options').forEach((opts, qi) => {
      opts.querySelectorAll('.q-opt').forEach(opt => {
        opt.classList.remove('right','wrong');
        if(opt.classList.contains('selected')){
          if(opt.textContent === audioQuestionsData[qi].answer){ opt.classList.add('right'); correct++; }
          else { opt.classList.add('wrong'); }
        }
      });
    });
    const fb = document.getElementById('audioFeedback');
    if(correct === audioQuestionsData.length){
      fb.textContent = `Perfect! ${correct}/${audioQuestionsData.length} correct.`;
      fb.classList.add('ok'); fb.classList.remove('err');
      completeActivity(4);
    } else {
      fb.textContent = `${correct}/${audioQuestionsData.length} correct — try again.`;
      fb.classList.add('err'); fb.classList.remove('ok');
    }
  });

  /* ── 6. SENTENCE BUILDER (idx 5) ────────────── */
  const builderTokens = ["Hello,","my","name","is","Tom"];
  const builderGoal   = builderTokens.join(' ');
  document.getElementById('builderGoal').textContent = builderGoal;
  let bankTokens   = [...builderTokens].sort(() => Math.random() - 0.5);
  let placedTokens = [];
  const wordBank        = document.getElementById('wordBank');
  const sentenceTarget  = document.getElementById('sentenceTarget');
  const builderFeedback = document.getElementById('builderFeedback');

  function renderBuilder(){
    wordBank.innerHTML = '';
    sentenceTarget.innerHTML = '';
    bankTokens.forEach((w, i) => {
      const t = document.createElement('div');
      t.className = 'word-brick';
      t.textContent = w;
      t.addEventListener('click', () => {
        placedTokens.push(w);
        bankTokens.splice(i, 1);
        renderBuilder();
      });
      wordBank.appendChild(t);
    });
    placedTokens.forEach((w, i) => {
      const p = document.createElement('div');
      p.className = 'placed-word';
      p.textContent = w;
      p.addEventListener('click', () => {
        placedTokens.splice(i, 1);
        bankTokens.push(w);
        renderBuilder();
      });
      sentenceTarget.appendChild(p);
    });
  }
  renderBuilder();
  document.getElementById('checkBuilderBtn').addEventListener('click', () => {
    const built = placedTokens.join(' ');
    if(built === builderGoal){
      builderFeedback.textContent = `Correct! "${built}"`;
      builderFeedback.classList.add('ok'); builderFeedback.classList.remove('err');
      speak(built);
      completeActivity(5);
    } else {
      builderFeedback.textContent = `Try again — target: "${builderGoal}"`;
      builderFeedback.classList.add('err'); builderFeedback.classList.remove('ok');
    }
  });

  /* ── 7. TRUE / FALSE (idx 6) ────────────────── */
  const tfStatements = [
    { text:"Hello means 'Goodbye' in English.",                   answer:false },
    { text:"We say 'How are you?' to ask about someone's mood.",  answer:true  },
    { text:"'Goodbye' is a way to end a conversation.",           answer:true  }
  ];
  const tfContainer = document.getElementById('trueFalseContainer');
  tfStatements.forEach((item, i) => {
    const div = document.createElement('div');
    div.className = 'tf-item';
    div.innerHTML = `
      <div class="tf-text">${i + 1}. ${item.text}</div>
      <div class="tf-buttons">
        <button class="tf-btn" data-tfidx="${i}" data-val="true"  type="button">TRUE</button>
        <button class="tf-btn" data-tfidx="${i}" data-val="false" type="button">FALSE</button>
      </div>`;
    tfContainer.appendChild(div);
  });
  tfContainer.querySelectorAll('.tf-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.parentElement.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
    });
  });
  document.getElementById('checkTFBtn').addEventListener('click', () => {
    let correct = 0;
    tfContainer.querySelectorAll('.tf-btn').forEach(btn => {
      btn.classList.remove('right','wrong');
      const i   = parseInt(btn.dataset.tfidx, 10);
      const val = btn.dataset.val === 'true';
      if(btn.classList.contains('selected')){
        if(val === tfStatements[i].answer){ btn.classList.add('right'); correct++; }
        else { btn.classList.add('wrong'); }
      }
    });
    const fb = document.getElementById('tfFeedback');
    if(correct === tfStatements.length){
      fb.textContent = `${correct}/${tfStatements.length} correct — well done!`;
      fb.classList.add('ok'); fb.classList.remove('err');
      completeActivity(6);
    } else {
      fb.textContent = `${correct}/${tfStatements.length} correct — try again.`;
      fb.classList.add('err'); fb.classList.remove('ok');
    }
  });

  /* ── 8. PREPOSITIONS (idx 7) — 12 items, spring ── */
  const prepItems = [
    // IN the box (4)
    { id:'ball',   emoji:'⚽', label:'ball',   prep:'in'    },
    { id:'toy',    emoji:'🧸', label:'toy',    prep:'in'    },
    { id:'car',    emoji:'🚗', label:'car',    prep:'in'    },
    { id:'block',  emoji:'🧱', label:'block',  prep:'in'    },
    // ON the table (4)
    { id:'book',   emoji:'📘', label:'book',   prep:'on'    },
    { id:'pencil', emoji:'✏️', label:'pencil', prep:'on'    },
    { id:'cup',    emoji:'☕', label:'cup',    prep:'on'    },
    { id:'hat',    emoji:'🎩', label:'hat',    prep:'on'    },
    // UNDER the chair (4)
    { id:'cat',    emoji:'🐱', label:'cat',    prep:'under' },
    { id:'dog',    emoji:'🐶', label:'dog',    prep:'under' },
    { id:'shoe',   emoji:'👟', label:'shoe',   prep:'under' },
    { id:'mouse',  emoji:'🐭', label:'mouse',  prep:'under' }
  ];
  const PREP_PASS_THRESHOLD = 10;          // 10 / 12 right = star
  const placedPrep = {};                    // id → prep
  let prepSelectedEl = null;
  const prepPool = document.getElementById('prepObjects');
  const prepFeedback = document.getElementById('prepFeedback');
  const prepPlaceNames = { in:'IN the box', on:'ON the table', under:'UNDER the chair' };

  function prepObjectMarkup(item){
    return `<span class="ico">${item.emoji}</span><span>${item.label}</span><span class="prep-badge">${item.prep.toUpperCase()}</span>`;
  }

  // Shuffle for variety
  const prepShuffled = [...prepItems].sort(() => Math.random() - 0.5);

  prepShuffled.forEach((o, i) => {
    const el = document.createElement('div');
    el.className = 'prep-obj';
    el.dataset.id   = o.id;
    el.dataset.prep = o.prep;
    el.style.animationDelay = `${i * 60}ms`;
    el.innerHTML = prepObjectMarkup(o);
    el.addEventListener('click', () => {
      if(el.classList.contains('fly-out')) return;
      if(prepSelectedEl === el){
        el.classList.remove('selected');
        prepSelectedEl = null;
        document.querySelectorAll('.prep-zone.armed').forEach(z => z.classList.remove('armed'));
        if(prepFeedback) prepFeedback.textContent = 'Choose an object first, then tap its matching zone.';
        return;
      }
      document.querySelectorAll('.prep-obj.selected').forEach(n => n.classList.remove('selected'));
      el.classList.add('selected');
      prepSelectedEl = el;
      document.querySelectorAll('.prep-zone').forEach(z => z.classList.add('armed'));
      if(prepFeedback) prepFeedback.textContent = `${o.label} → ${prepPlaceNames[o.prep]}. Tap that zone.`;
    });
    prepPool.appendChild(el);
  });

  document.querySelectorAll('.prep-zone').forEach(zone => {
    zone.addEventListener('click', () => {
      if(!prepSelectedEl) return;
      const id   = prepSelectedEl.dataset.id;
      const item = prepItems.find(x => x.id === id);
      if(!item) return;
      const targetZone = zone.dataset.prep;

      // Animate fly-out, then drop chip into zone
      const flying = prepSelectedEl;
      flying.classList.remove('selected');
      flying.classList.add('fly-out');

      setTimeout(() => {
        if(flying.parentNode) flying.parentNode.removeChild(flying);
        const items = zone.querySelector('.prep-zone-items');
        const chip = document.createElement('div');
        chip.className = 'prep-placed';
        chip.dataset.id = id;
        chip.innerHTML = `<span>${item.emoji}</span><span>${item.label}</span><span class="prep-badge">${item.prep.toUpperCase()}</span>`;
        chip.title = 'Tap to send back';
        chip.addEventListener('click', (e) => {
          e.stopPropagation();
          // Send the chip back to the pool
          delete placedPrep[id];
          chip.remove();
          zone.classList.remove('right','wrong');
          if(zone.querySelector('.prep-zone-items').children.length === 0){
            zone.classList.remove('has-item');
          }
          // Re-create chip in pool
          const newEl = document.createElement('div');
          newEl.className = 'prep-obj';
          newEl.dataset.id   = id;
          newEl.dataset.prep = item.prep;
          newEl.style.animationDelay = '0ms';
          newEl.innerHTML = prepObjectMarkup(item);
          newEl.addEventListener('click', () => {
            if(prepSelectedEl === newEl){
              newEl.classList.remove('selected');
              prepSelectedEl = null;
              document.querySelectorAll('.prep-zone.armed').forEach(z => z.classList.remove('armed'));
              if(prepFeedback) prepFeedback.textContent = 'Choose an object first, then tap its matching zone.';
              return;
            }
            document.querySelectorAll('.prep-obj.selected').forEach(n => n.classList.remove('selected'));
            newEl.classList.add('selected');
            prepSelectedEl = newEl;
            document.querySelectorAll('.prep-zone').forEach(z => z.classList.add('armed'));
            if(prepFeedback) prepFeedback.textContent = `${item.label} → ${prepPlaceNames[item.prep]}. Tap that zone.`;
          });
          prepPool.appendChild(newEl);
        });
        items.appendChild(chip);
        zone.classList.add('has-item');
      }, 380);

      placedPrep[id] = targetZone;
      if(prepFeedback) prepFeedback.textContent = `${item.label} placed in ${prepPlaceNames[targetZone]}.`;
      prepSelectedEl = null;
      document.querySelectorAll('.prep-zone.armed').forEach(z => z.classList.remove('armed'));
    });
  });

  document.getElementById('checkPrepBtn').addEventListener('click', () => {
    const placedIds = Object.keys(placedPrep);
    document.querySelectorAll('.prep-zone').forEach(z => z.classList.remove('right','wrong'));
    document.querySelectorAll('.prep-placed').forEach(c => c.classList.remove('right','wrong'));

    if(placedIds.length < prepItems.length){
      const left = prepItems.length - placedIds.length;
      const fb = prepFeedback || document.getElementById('prepFeedback');
      fb.textContent = `Place ${left} more object${left === 1 ? '' : 's'} first.`;
      fb.classList.add('err'); fb.classList.remove('ok');
      return;
    }

    let correct = 0;
    placedIds.forEach(id => {
      const item = prepItems.find(x => x.id === id);
      const placedZone = placedPrep[id];
      const chip = document.querySelector(`.prep-placed[data-id='${id}']`);
      if(item && item.prep === placedZone){
        if(chip) chip.classList.add('right');
        correct++;
      } else {
        if(chip) chip.classList.add('wrong');
      }
    });
    const fb = document.getElementById('prepFeedback');
    if(correct >= PREP_PASS_THRESHOLD){
      fb.textContent = `${correct}/${prepItems.length} correct — fantastic!`;
      fb.classList.add('ok'); fb.classList.remove('err');
      completeActivity(7);
    } else {
      fb.textContent = `${correct}/${prepItems.length} correct — fix the red ones and try again (need ${PREP_PASS_THRESHOLD}).`;
      fb.classList.add('err'); fb.classList.remove('ok');
    }
  });

  /* ── 9. PRONOUNS (idx 8) — Find the error ─────── */
  const errorSentences = [
    { words:["She", "have", "a", "red", "book."],   errorIdx:1, fix:"She HAS a red book." },
    { words:["He",  "are",  "very", "happy."],      errorIdx:1, fix:"He IS very happy."    },
    { words:["We",  "is",   "good", "friends."],    errorIdx:1, fix:"We ARE good friends." },
    { words:["I",   "are",  "five", "years", "old."], errorIdx:1, fix:"I AM five years old." },
    { words:["They","has",  "two",  "cats."],       errorIdx:1, fix:"They HAVE two cats."  }
  ];
  const PRONOUN_ERROR_THRESHOLD = 4;
  let errorSolved = 0;
  const errorContainer = document.getElementById('errorSentencesContainer');

  errorSentences.forEach((s, si) => {
    const block = document.createElement('div');
    block.className = 'error-sentence';
    block.dataset.idx = si;
    const label = document.createElement('span');
    label.className = 'e-label';
    label.textContent = `Sentence ${si + 1}`;
    block.appendChild(label);
    const line = document.createElement('div');
    s.words.forEach((w, wi) => {
      const span = document.createElement('span');
      span.className = 'error-word';
      span.textContent = w;
      span.addEventListener('click', () => {
        if(block.classList.contains('solved')) return;
        if(span.classList.contains('found') || span.classList.contains('miss')) return;
        if(wi === s.errorIdx){
          span.classList.add('found');
          block.classList.add('solved');
          speak(s.fix.replace(/[A-Z]{2,}/g, m => m.toLowerCase()));
          errorSolved++;
          if(errorSolved >= PRONOUN_ERROR_THRESHOLD) completeActivity(8);
        } else {
          span.classList.add('miss');
          setTimeout(() => span.classList.remove('miss'), 600);
        }
      });
      line.appendChild(span);
      line.appendChild(document.createTextNode(' '));
    });
    block.appendChild(line);
    const fix = document.createElement('div');
    fix.className = 'error-fix';
    fix.textContent = `✓ Correct: ${s.fix}`;
    block.appendChild(fix);
    errorContainer.appendChild(block);
  });

  /* ── 10. FINAL · LEADERBOARD (idx 9) ────────── */
  const kidNameInput  = document.getElementById('kidNameInput');
  const finalStory    = document.getElementById('finalStory');
  const finishBtn     = document.getElementById('completeFinalBtn');
  const completionMsg = document.getElementById('completionMsg');

  try{
    const savedName = localStorage.getItem(NAME_KEY);
    if(savedName) kidNameInput.value = savedName;
  }catch(_){}

  function refreshFinishButtonState(){
    if(!finishBtn) return;
    const otherDone = completed.slice(0, 9).filter(Boolean).length === 9;
    const hasName   = kidNameInput.value.trim().length >= 2;
    const hasStory  = finalStory.value.trim().length >= 50;
    if(completed[9]){
      finishBtn.disabled = true;
      finishBtn.textContent = 'Submitted!';
    } else if(otherDone && hasName && hasStory){
      finishBtn.disabled = false;
    } else {
      finishBtn.disabled = true;
    }
    if(completed[9]){
      // already submitted
    } else if(!otherDone){
      const left = 9 - completed.slice(0, 9).filter(Boolean).length;
      completionMsg.textContent = `Finish ${left} more game${left === 1 ? '' : 's'} above first.`;
    } else if(!hasStory){
      completionMsg.textContent = 'Write a short story (at least 50 letters).';
    } else if(!hasName){
      completionMsg.textContent = 'Type your name on line 1!';
    } else {
      completionMsg.textContent = 'Press "Submit my story" to finish!';
    }
  }
  kidNameInput.addEventListener('input', () => {
    try{ localStorage.setItem(NAME_KEY, kidNameInput.value.trim()); }catch(_){}
    refreshFinishButtonState();
  });
  finalStory.addEventListener('input', refreshFinishButtonState);
  finishBtn.addEventListener('click', () => {
    if(finishBtn.disabled) return;
    const name = kidNameInput.value.trim();
    speak(`Amazing story, ${name}! You finished the lab!`);
    completeActivity(9);
    createParticles(window.innerWidth / 2, window.innerHeight / 2, 80);
    finishBtn.textContent = 'Submitted!';
    finishBtn.disabled = true;
    completionMsg.innerHTML = `Welcome to line 1, <strong>${name}</strong>!`;
  });

  /* ── INIT ───────────────────────────────────── */
  loadProgress();
})();
</script>

<script defer src="../assets/lab-unify-repair.js?v=2" data-lab-unify-repair></script>
