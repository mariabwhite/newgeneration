}
.map-tile span { color: var(--muted); font-size: 13px; }
.progress {
  width: min(100% - 48px, 1040px);
  margin: 0 auto 18px;
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 8px;
}
.progress-step {
  min-width: 0;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 8px 6px;
  text-align: center;
  background: rgba(255,255,255,.62);
