}

function resetSelectQuiz(name) {
  const wrap = document.querySelector(`[data-select-quiz="${name}"]`);
  [...wrap.querySelectorAll("select")].forEach((select) => {
    select.value = "";
    select.style.borderColor = "";
    select.style.boxShadow = "";
  });
}

function revealModels(taskNumber) {
  document.querySelectorAll("#block" + taskNumber + " .model-answer").forEach((el) => el.classList.add("show"));
  completeTask(taskNumber);
}

function toggleModels() {
  document.querySelectorAll(".model-answer").forEach((el) => el.classList.toggle("show"));
}

function showSample() {
  document.getElementById("sampleAnswer").classList.add("show");
}

function checkWriting() {
  const text = document.getElementById("writingBox").value.trim();
  const score = document.getElementById("score12");
  const words = text ? text.split(/\s+/).length : 0;
  const theCount = (text.match(/\bthe\b/gi) || []).length;
  const hasGeo = /\b(Sea|Ocean|River|Lake|Mount|Mountains|Alps|Nile|Sahara|Ukraine|Crimea|Canada|Japan|Gulf|Strait|Peninsula|Island|Islands)\b/i.test(text);
  if (words >= 80 && theCount >= 4 && hasGeo) {
    score.textContent = `Ready: ${words} words, ${theCount} uses of "the".`;
    score.style.color = "var(--ok)";
    completeTask(12);
  } else {
    score.textContent = `Add more detail: ${words}/80+ words, ${theCount}/4+ uses of "the", and clear geographical names.`;
    score.style.color = "var(--muted)";
  }
}

function launchConfetti() {
  const canvas = document.getElementById("confettiCanvas");
  const ctx = canvas.getContext("2d");
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  const colors = ["#d7942d", "#2c7a4d", "#1e4a76", "#f1d7a3", "#8fb6a0"];
  const pieces = Array.from({ length: 140 }, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height - canvas.height,
    r: Math.random() * 6 + 3,
    color: colors[Math.floor(Math.random() * colors.length)],
    speed: Math.random() * 3 + 1,
    angle: Math.random() * Math.PI * 2,
    spin: Math.random() * .18 - .09
  }));
  let frame = 0;
  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    pieces.forEach((p) => {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.angle);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
      ctx.restore();
      p.y += p.speed;
      p.x += Math.sin(frame / 16 + p.r) * 1.4;
      p.angle += p.spin;
      if (p.y > canvas.height + 20) p.y = -20;
    });
    frame += 1;
    if (frame < 220) requestAnimationFrame(draw);
    else ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
  draw();
}

