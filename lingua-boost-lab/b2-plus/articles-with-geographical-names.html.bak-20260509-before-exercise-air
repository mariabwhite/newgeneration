<style>
:root {
  --display: "Unbounded", "Manrope", system-ui, sans-serif;
  --body: "Manrope", system-ui, sans-serif;
  --mono: "JetBrains Mono", Consolas, monospace;
  --bg: #f4f0e8;
  --surface: #fffdf8;
  --surface-soft: #f8f2e6;
  --ink: #172332;
  --muted: #64707d;
  --line: rgba(23,35,50,.14);
  --accent: #2c7a4d;
  --accent2: #1e4a76;
  --accent3: #d7942d;
  --ok: #2c7a4d;
  --miss: #b6463b;
  --shadow: 0 22px 60px rgba(30,74,118,.12);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  min-height: 100vh;
  color: var(--ink);
  font-family: var(--body);
  line-height: 1.65;
  background:
    radial-gradient(circle at 10% 8%, color-mix(in srgb, var(--accent3) 20%, transparent), transparent 30%),
    radial-gradient(circle at 86% 4%, color-mix(in srgb, var(--accent2) 13%, transparent), transparent 34%),
    linear-gradient(180deg, #f9f5ec 0%, var(--bg) 52%, #eef2ec 100%);
}
a { color: inherit; }
button, input, select, textarea { font: inherit; }
.lab-topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  min-height: 56px;
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 8px clamp(18px, 3vw, 32px);
