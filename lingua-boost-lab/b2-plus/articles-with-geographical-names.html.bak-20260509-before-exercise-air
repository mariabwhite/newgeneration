  font-size: 14px;
  font-weight: 800;
  line-height: 1;
}
.lab-brand-tag, .lab-back, .lab-pill-nav, .lab-tool-btn, .lab-badge, .section-badge, .progress-label, .section-kicker, .btn {
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.lab-brand-tag { color: var(--muted); }
.lab-nav {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.lab-back, .lab-pill-nav, .lab-tool-btn {
  min-height: 32px;
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  border: 1px solid var(--line);
  padding: 0 12px;
  text-decoration: none;
  color: var(--muted);
  background: rgba(255,255,255,.55);
}
.lab-pill-accent { background: var(--accent2); color: #fff; border-color: var(--accent2); }
.lab-tool-btn { cursor: pointer; }
.lab-hero {
  width: min(100% - 48px, 1240px);
  margin: 24px auto 18px;
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: clamp(30px, 5vw, 58px);
  background:
    linear-gradient(135deg, rgba(255,255,255,.95), rgba(255,253,248,.84)),
    radial-gradient(circle at 92% 10%, color-mix(in srgb, var(--accent3) 23%, transparent), transparent 33%);
