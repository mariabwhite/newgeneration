];

function articleOptions(id, answer) {
  return `<select id="${id}" data-answer="${answer}"><option value="">Choose</option><option value="the">the</option><option value="zero">zero article</option></select>`;
}

function buildWouldRather(reset = false) {
  const list = document.getElementById("ratherList");
  if (!list) return;
  list.innerHTML = "";
  WOULD_RATHER.forEach((item, index) => {
    const card = document.createElement("article");
