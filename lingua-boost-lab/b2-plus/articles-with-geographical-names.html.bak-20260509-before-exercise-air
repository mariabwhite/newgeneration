  align-items: center;
  gap: 10px;
  text-decoration: none;
}
.lab-mark {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  background: var(--accent2);
  box-shadow: 0 8px 18px rgba(30,74,118,.18);
}
.lab-mark img { width: 27px; height: 27px; object-fit: contain; }
.lab-brand-copy { display: grid; gap: 1px; }
.lab-brand-name {
