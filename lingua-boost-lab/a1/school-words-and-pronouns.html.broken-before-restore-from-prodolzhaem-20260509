/* Codex stylefix: Easter typography geometry + thematic pictorial badges */
.brand-mark img,.lab-mark img,.topbar-badge-img{
  width:26px;height:26px;display:block;object-fit:contain;border-radius:6px;
}
.brand-mark,.lab-mark{
  overflow:hidden;flex:0 0 auto;
}
.lab-hero-visual{
  background:linear-gradient(135deg,color-mix(in srgb,var(--accent3,var(--accent)) 32%,#fff),color-mix(in srgb,var(--accent2,var(--accent)) 72%,#fff)) !important;
}
.lab-hero-visual img{
  width:76px;height:76px;object-fit:contain;filter:drop-shadow(0 8px 14px rgba(0,0,0,.16));
}
.topbar-brand.with-badge,.brand.with-badge{
  display:inline-flex;align-items:center;gap:10px;
}
.topbar-brand.with-badge::before,.brand.with-badge::before{
  content:"";width:34px;height:34px;display:inline-block;border-radius:8px;
  background:var(--lesson-badge) center/26px 26px no-repeat,var(--accent2,var(--accent));
  box-shadow:0 2px 8px rgba(0,0,0,.12);flex:0 0 auto;
}
.lesson-hero-title{
