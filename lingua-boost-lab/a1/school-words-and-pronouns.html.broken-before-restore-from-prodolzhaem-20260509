// BUBBLE POP (bonus)
const bubWords = ['I','you','he','she','we','they','it','pencil','ruler','notebook'];
let bubBubbles = [], bubScore = 0, bubAnim = null, bubRunning = false;
const bubCanvas = document.getElementById('bubCanvas');
const bubColors = [
  ['#fff7ff','#d992ef','#8b24ad'],
  ['#f7fbff','#9fd6ff','#5f61d6'],
  ['#fffaf2','#ffc577','#b554b8'],
  ['#f7fff8','#9ee9c2','#7f2fb0']
];
function bubResize(){
  if(!bubCanvas) return;
  const rect = bubCanvas.getBoundingClientRect();
  const width = Math.max(320, Math.round(rect.width || bubCanvas.clientWidth || 0));
  const height = Math.max(300, Math.round(rect.height || bubCanvas.clientHeight || 320));
  const dpr = Math.max(1, window.devicePixelRatio || 1);
  bubCanvas.width = Math.round(width * dpr);
  bubCanvas.height = Math.round(height * dpr);
  const ctx = bubCanvas.getContext('2d');
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  bubCanvas.dataset.drawWidth = width;
  bubCanvas.dataset.drawHeight = height;
}
function bubTextSize(ctx, text, maxWidth){
  let size = text.length > 8 ? 13 : 15;
  while(size > 10){
    ctx.font = `900 ${size}px Manrope, system-ui, sans-serif`;
    if(ctx.measureText(text).width <= maxWidth) break;
    size--;
  }
  return size;
}
function bubPlace(count, preview=false){
  if(!bubCanvas) return [];
  bubResize();
  const w = Number(bubCanvas.dataset.drawWidth) || bubCanvas.clientWidth || 320;
  const h = Number(bubCanvas.dataset.drawHeight) || bubCanvas.clientHeight || 320;
  const ctx = bubCanvas.getContext('2d');
  const bubbles = [];
  const compact = w < 420;
  const radiusBase = Math.max(22, Math.min(52, w / (preview ? 8.5 : (compact ? 8 : 12)), h / (preview ? 6.2 : (compact ? 7 : 8))));
  for(let i=0;i<count;i++){
    const word = preview ? ['pencil','you','she','notebook','they'][i % 5] : bubWords[Math.floor(Math.random()*bubWords.length)];
    let candidate = null;
    if(compact){
      const spots = [[.31,.22],[.70,.28],[.50,.50],[.28,.74],[.72,.76]];
      const spot = spots[i % spots.length];
      candidate = { x: w * spot[0], y: h * spot[1], r: radiusBase };
    } else {
      for(let tries=0;tries<140;tries++){
        const r = radiusBase + Math.random()*8;
        const x = r + 18 + Math.random()*Math.max(1, w - (r + 18)*2);
        const y = r + 18 + Math.random()*Math.max(1, h - (r + 18)*2);
        if(bubbles.every(b => Math.hypot(x-b.x, y-b.y) > r + b.r + 10)){
          candidate = {x,y,r};
          break;
        }
      }
    }
    if(!candidate){
      const r = Math.max(compact ? 22 : 30, radiusBase - 8);
      candidate = {
        x: r + 18 + (i % (compact ? 3 : 4)) * Math.max(r * 2 + 8, (w - 2*r - 36) / Math.max(1, (compact ? 2 : 3))),
        y: r + 18 + Math.floor(i / (compact ? 3 : 4)) * Math.max(r * 2 + 10, (h - 2*r - 36) / 2),
        r
      };
    }
    const palette = bubColors[i % bubColors.length];
    const speed = preview ? 0 : .65 + Math.random()*.8;
    bubbles.push({
      ...candidate,
      vx: (Math.random()-.5)*speed,
      vy: (Math.random()-.5)*speed,
      word,
      popped: false,
      palette,
      textSize: bubTextSize(ctx, word, candidate.r * 1.42)
    });
  }
  return bubbles;
}
function bubDrawBackground(ctx,w,h){
  ctx.clearRect(0,0,w,h);
  ctx.save();
  ctx.globalAlpha = .45;
  for(let i=0;i<12;i++){
    ctx.beginPath();
    ctx.arc((i*97)%w, (i*53)%h, 1.8 + (i%3), 0, Math.PI*2);
    ctx.fillStyle = '#ffffff';
    ctx.fill();
  }
  ctx.restore();
}
function bubDraw(){
  if(!bubCanvas) return;
  const ctx = bubCanvas.getContext('2d');
  const w = Number(bubCanvas.dataset.drawWidth) || bubCanvas.clientWidth || 320;
  const h = Number(bubCanvas.dataset.drawHeight) || bubCanvas.clientHeight || 320;
  bubDrawBackground(ctx,w,h);
  for(const b of bubBubbles){
    if(b.popped) continue;
    const grad = ctx.createRadialGradient(b.x-b.r*.34,b.y-b.r*.38,b.r*.12,b.x,b.y,b.r);
    grad.addColorStop(0,b.palette[0]);
    grad.addColorStop(.62,b.palette[1]);
    grad.addColorStop(1,b.palette[2]);
    ctx.beginPath();
    ctx.arc(b.x,b.y,b.r,0,Math.PI*2);
    ctx.fillStyle = grad;
    ctx.fill();
    ctx.strokeStyle = 'rgba(99,27,132,.68)';
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(b.x-b.r*.32,b.y-b.r*.36,b.r*.18,0,Math.PI*2);
    ctx.fillStyle = 'rgba(255,255,255,.68)';
    ctx.fill();
    ctx.fillStyle = '#210039';
    ctx.font = `900 ${b.textSize}px Manrope, system-ui, sans-serif`;
    ctx.textAlign='center';
    ctx.textBaseline='middle';
    ctx.fillText(b.word, b.x, b.y);
  }
}
function bubMakeRound(){
  const w = Number(bubCanvas.dataset.drawWidth) || bubCanvas.clientWidth || 320;
  bubBubbles = bubPlace(w < 420 ? 5 : 7);
  bubDraw();
}
function bubPreview(){
  bubRunning = false;
  bubBubbles = bubPlace(5, true);
  bubDraw();
}
function bubStep(){
  if(!bubCanvas || !bubRunning) return;
  const w = Number(bubCanvas.dataset.drawWidth) || bubCanvas.clientWidth || 320;
  const h = Number(bubCanvas.dataset.drawHeight) || bubCanvas.clientHeight || 320;
  for(const b of bubBubbles){
    if(b.popped) continue;
    b.x += b.vx; b.y += b.vy;
    if(b.x < b.r || b.x > w-b.r) { b.vx *= -1; b.x = Math.max(b.r, Math.min(w-b.r, b.x)); }
    if(b.y < b.r || b.y > h-b.r) { b.vy *= -1; b.y = Math.max(b.r, Math.min(h-b.r, b.y)); }
  }
  bubDraw();
  bubAnim = requestAnimationFrame(bubStep);
}
function bubClientPoint(e){
  const point = e.touches && e.touches.length ? e.touches[0] : e.changedTouches && e.changedTouches.length ? e.changedTouches[0] : e;
  return { x: point.clientX, y: point.clientY };
}
function bubClick(e){
  if(e) e.preventDefault?.();
  if(!bubCanvas) return;
  if(!bubRunning){
    bubRunning = true;
    bubScore = 0;
    document.getElementById('bubScoreDisplay').innerHTML = 'Score: 0 / 10';
    document.getElementById('bubResetBtn').style.display = '';
    document.getElementById('bubStartBtn').textContent = 'Restart';
    if(!bubBubbles.length || bubBubbles.every(x=>x.popped)) bubMakeRound();
    if(bubAnim) cancelAnimationFrame(bubAnim);
    bubAnim = requestAnimationFrame(bubStep);
  }
  const rect = bubCanvas.getBoundingClientRect();
  const point = bubClientPoint(e);
  const scaleX = (Number(bubCanvas.dataset.drawWidth) || rect.width || 1) / (rect.width || 1);
  const scaleY = (Number(bubCanvas.dataset.drawHeight) || rect.height || 1) / (rect.height || 1);
  const cx = (point.x - rect.left) * scaleX;
  const cy = (point.y - rect.top) * scaleY;
  for(const b of bubBubbles){
    if(b.popped) continue;
    if(Math.hypot(cx-b.x, cy-b.y) <= b.r + 6){
      b.popped = true; bubScore++;
      document.getElementById('bubScoreDisplay').innerHTML = `Score: ${bubScore} / 10`;
      if(bubScore >= 10){
        bubRunning = false;
        if(bubAnim) cancelAnimationFrame(bubAnim);
        bubAnim = null;
        document.getElementById('bubScoreDisplay').innerHTML = 'Score: 10 / 10 &mdash; Bubble pop master!';
        document.getElementById('bubResetBtn').style.display = '';
        bubDraw();
      } else if(bubBubbles.every(x=>x.popped)){
        bubMakeRound();
      } else {
        bubDraw();
      }
      return;
    }
  }
}
function startBubbles(){
  if(!bubCanvas) return;
  if(bubAnim) cancelAnimationFrame(bubAnim);
  bubAnim = null;
  bubRunning = true;
  bubScore = 0;
  document.getElementById('bubScoreDisplay').innerHTML = 'Score: 0 / 10';
  document.getElementById('bubResetBtn').style.display = '';
  document.getElementById('bubStartBtn').textContent = 'Restart';
  bubMakeRound();
  bubAnim = requestAnimationFrame(bubStep);
}
function resetBubbles(){
  if(!bubCanvas) return;
  if(bubAnim) cancelAnimationFrame(bubAnim);
  bubAnim = null;
  bubScore = 0;
  document.getElementById('bubScoreDisplay').innerHTML = 'Score: 0 / 10';
  document.getElementById('bubResetBtn').style.display = 'none';
  document.getElementById('bubStartBtn').textContent = 'Play';
  bubPreview();
}
if(bubCanvas){
  bubResize();
  bubCanvas.addEventListener('click', bubClick);
  bubCanvas.addEventListener('pointerdown', bubClick);
  document.getElementById('bubStartBtn')?.addEventListener('click', startBubbles);
  document.getElementById('bubResetBtn')?.addEventListener('click', resetBubbles);
  window.addEventListener('resize', ()=>{ bubResize(); if(bubRunning) bubMakeRound(); else bubPreview(); });
  bubPreview();
}
window.startBubbles = startBubbles;
window.resetBubbles = resetBubbles;
</script>
