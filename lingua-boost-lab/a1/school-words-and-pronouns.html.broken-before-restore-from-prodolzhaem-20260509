<!DOCTYPE html>
<html lang="en" data-lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>School Words & Pronouns &mdash; A1 | LinguaBoost Lab</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;800;900&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg:#f3e5f5;--surface:#fff;--accent:#9c27b0;--accent2:#7b1fa2;
  --accent3:#ce93d8;--text:#1a0030;--muted:#7a5080;
  --ok:#2c7a4d;--miss:#c0392b;--radius:1.2rem;--shadow:0 6px 24px rgba(0,0,0,.1);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'Manrope',sans-serif;font-size:16px;min-height:100vh;}

/* TOPBAR */
.topbar{background:var(--surface);box-shadow:var(--shadow);padding:.75rem 1.5rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;position:sticky;top:0;z-index:100;}
.topbar-brand{font-family:var(--display,'Unbounded','Manrope',system-ui,sans-serif);font-weight:900;font-size:1.2rem;color:var(--accent);white-space:nowrap;}
.pills{display:flex;gap:.4rem;flex-wrap:wrap;}
.pill{background:var(--accent3);color:var(--accent2);border-radius:2rem;padding:.2rem .75rem;font-size:.8rem;font-weight:700;}
.topbar-right{margin-left:auto;display:flex;align-items:center;gap:.75rem;}
.btn-lang{background:var(--accent);color:#fff;border:none;border-radius:2rem;padding:.35rem .9rem;font-weight:700;font-size:.85rem;cursor:pointer;}
.btn-lang:hover{background:var(--accent2);}
.btn-back{background:none;border:2px solid var(--accent);color:var(--accent);border-radius:2rem;padding:.3rem .9rem;font-weight:700;font-size:.85rem;cursor:pointer;text-decoration:none;display:inline-block;}
.btn-back:hover{background:var(--accent);color:#fff;}

/* HERO */
.hero{text-align:center;padding:2.5rem 1rem 1.5rem;}
.breadcrumb{font-size:.85rem;color:var(--muted);margin-bottom:.75rem;}
.hero h1{font-family:var(--display,'Unbounded','Manrope',system-ui,sans-serif);font-weight:900;font-size:2.4rem;color:var(--accent2);margin-bottom:.75rem;}
.subtitle-pill{display:inline-block;background:var(--accent);color:#fff;border-radius:2rem;padding:.4rem 1.2rem;font-weight:700;font-size:.95rem;}

/* STAR BAR */
.star-bar{display:flex;justify-content:center;gap:.75rem;padding:1rem;flex-wrap:wrap;}
.star{font-size:1.6rem;opacity:.3;transition:opacity .4s,transform .4s;}
.star.lit{opacity:1;transform:scale(1.2);}

/* RAIL */
.rail{display:flex;justify-content:center;gap:.5rem;padding:.5rem 1rem 1.5rem;flex-wrap:wrap;}
.rail-step{width:2.4rem;height:2.4rem;border-radius:50%;background:#e0c8f0;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.9rem;color:var(--muted);transition:background .4s,color .4s;}
.rail-step.done{background:var(--ok);color:#fff;}

/* SECTIONS */
.section{background:var(--surface);border-radius:var(--radius);box-shadow:var(--shadow);margin:1.5rem auto;max-width:900px;overflow:hidden;}
.section-head{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;padding:1.2rem 1.5rem;display:flex;align-items:center;gap:.75rem;}
.section-head h2{font-family:var(--display,'Unbounded','Manrope',system-ui,sans-serif);font-weight:900;font-size:1.3rem;}
.section-num{background:rgba(255,255,255,.25);border-radius:50%;width:2rem;height:2rem;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:1rem;flex-shrink:0;}
.section-body{padding:1.5rem;}

/* FLASHCARDS */
.flip-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:1rem;}
.flip-card{perspective:800px;height:90px;cursor:pointer;}
.flip-inner{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .5s;border-radius:.8rem;}
.flip-card.flipped .flip-inner{transform:rotateY(180deg);}
.flip-face{position:absolute;inset:0;border-radius:.8rem;display:flex;align-items:center;justify-content:center;text-align:center;padding:.5rem;backface-visibility:hidden;-webkit-backface-visibility:hidden;}
.flip-front{background:var(--accent);color:#fff;font-family:var(--display,'Unbounded','Manrope',system-ui,sans-serif);font-weight:900;font-size:1.2rem;}
.flip-back{background:var(--accent2);color:#fff;transform:rotateY(180deg);font-size:.95rem;font-weight:700;flex-direction:column;gap:.2rem;}

/* MEMORY GAME */
.memory-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;}
.mem-card{height:70px;background:var(--accent);border-radius:.8rem;cursor:pointer;display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--accent);font-size:1.1rem;user-select:none;transition:background .3s,transform .2s;position:relative;overflow:hidden;}
.mem-card::before{content:'?';position:absolute;color:rgba(255,255,255,.7);font-size:1.5rem;font-family:var(--display,'Unbounded','Manrope',system-ui,sans-serif);font-weight:900;transition:opacity .3s;}
.mem-card.face-up::before,.mem-card.matched::before{opacity:0;}
.mem-card.face-up{background:var(--surface);border:2px solid var(--accent);color:var(--text);}
.mem-card.matched{background:#e8f5e9;border:2px solid var(--ok);color:var(--ok);}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.shake{animation:shake .3s;}

/* SPELLING BEE */
.bee-progress{color:var(--muted);font-size:.9rem;margin-bottom:.75rem;font-weight:600;}
.bee-row{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;margin-bottom:.75rem;}
.bee-input{border:2px solid var(--accent3);border-radius:.6rem;padding:.5rem .9rem;font-size:1rem;font-family:'Manrope',sans-serif;width:220px;outline:none;}
.bee-input:focus{border-color:var(--accent);}
.btn{background:var(--accent);color:#fff;border:none;border-radius:.6rem;padding:.5rem 1.2rem;font-weight:700;cursor:pointer;font-size:.95rem;transition:background .2s;}
.btn:hover{background:var(--accent2);}
.btn:disabled{opacity:.5;cursor:default;}
.btn-speak{background:var(--accent3);color:var(--accent2);font-size:1.2rem;border:none;border-radius:50%;width:2.5rem;height:2.5rem;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.btn-speak:hover{background:var(--accent);color:#fff;}
.bee-feedback{font-weight:700;margin-top:.5rem;min-height:1.4em;}
.bee-feedback.ok{color:var(--ok);}
.bee-feedback.miss{color:var(--miss);}
.bee-score-bar{display:flex;gap:.4rem;margin-top:.75rem;flex-wrap:wrap;}
.bee-dot{width:1.1rem;height:1.1rem;border-radius:50%;background:#e0c8f0;}
.bee-dot.ok{background:var(--ok);}
.bee-dot.miss{background:var(--miss);}

/* PRONOUN MATCHING */
.match-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
.match-col{display:flex;flex-direction:column;gap:.5rem;}
.match-btn{border:2px solid var(--accent3);background:var(--surface);border-radius:.7rem;padding:.6rem 1rem;font-weight:700;cursor:pointer;text-align:center;transition:background .2s,border-color .2s;font-size:1rem;color:var(--text);}
.match-btn:hover:not(.matched){border-color:var(--accent);background:#f9f0ff;}
.match-btn.selected{background:var(--accent);color:#fff;border-color:var(--accent);}
.match-btn.matched{background:#e8f5e9;border-color:var(--ok);color:var(--ok);cursor:default;}
.match-status{margin-top:.75rem;font-weight:700;color:var(--muted);}

/* QUIZ */
.quiz-item{margin-bottom:1.25rem;padding:1rem;background:#faf0ff;border-radius:.8rem;border-left:4px solid var(--accent3);}
.quiz-q{font-weight:700;margin-bottom:.6rem;}
.quiz-opts{display:flex;flex-direction:column;gap:.4rem;}
.quiz-opts label{display:flex;align-items:center;gap:.5rem;cursor:pointer;font-weight:600;}
.quiz-opts input{accent-color:var(--accent);}
.quiz-result{margin-top:.75rem;padding:.5rem;border-radius:.6rem;font-weight:700;}
.quiz-result.ok{background:#e8f5e9;color:var(--ok);}
.quiz-result.miss{background:#fdecea;color:var(--miss);}
.quiz-score{font-size:1.2rem;font-weight:700;margin-top:1rem;color:var(--accent2);}

/* SPEAK CARDS */
.speak-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1rem;}
.speak-card{background:#faf0ff;border-radius:.9rem;padding:1rem;border:2px solid var(--accent3);transition:border-color .3s;}
.speak-card.heard{border-color:var(--ok);background:#f0fff4;}
.speak-card-en{font-weight:700;font-size:1rem;color:var(--text);margin-bottom:.3rem;}
.speak-card-ru{font-size:.9rem;color:var(--muted);}
.speak-card-bottom{display:flex;justify-content:flex-end;margin-top:.6rem;}
.speak-progress{margin-top:.75rem;font-weight:600;color:var(--muted);}

/* ALL DONE */
.all-done{display:none;position:fixed;inset:0;background:rgba(155,39,176,.88);z-index:998;align-items:center;justify-content:center;text-align:center;color:#fff;flex-direction:column;gap:1rem;padding:2rem;}
.all-done.show{display:flex;}
.all-done h2{font-family:var(--display,'Unbounded','Manrope',system-ui,sans-serif);font-size:2rem;}
.all-done p{font-size:1.2rem;font-weight:600;}
.all-done .btn-close{background:#fff;color:var(--accent2);border:none;border-radius:2rem;padding:.6rem 1.5rem;font-weight:700;font-size:1rem;cursor:pointer;margin-top:.5rem;}

/* CONFETTI */
#confettiCanvas{position:fixed;top:0;left:0;pointer-events:none;z-index:999;}

/* FOOTER */
footer{text-align:center;padding:2rem 1rem;color:var(--muted);font-size:.82rem;margin-top:2rem;}

/* MOBILE */
@media(max-width:520px){
  .flip-grid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr));}
  .section-body{padding:1rem;}
  .memory-grid{grid-template-columns:repeat(4,1fr);}
  .speak-grid{grid-template-columns:1fr;}
  .hero h1{font-size:1.6rem;}
  .match-grid{grid-template-columns:1fr 1fr;}
  .match-btn{font-size:.85rem;padding:.5rem .4rem;}
  .bee-input{width:160px;}
}

/* Lab brand and logo */
.lab-topbar{display:flex;align-items:center;gap:1rem;padding:.7rem clamp(1rem,3vw,1.75rem);
  background:color-mix(in srgb,var(--surface,#fff) 92%,transparent);
  border-bottom:1px solid rgba(0,0,0,.09);backdrop-filter:blur(14px);
  position:sticky;top:0;z-index:200;min-height:54px}
.lab-brand{display:flex;align-items:center;gap:.65rem;text-decoration:none}
.lab-mark{width:36px;height:36px;border-radius:8px;background:var(--accent2);
  display:grid;place-items:center;font-family:var(--display,'Unbounded','Manrope',system-ui,sans-serif);font-weight:900;
  font-size:1.25rem;color:#fff;letter-spacing:-.05em;flex-shrink:0;
  box-shadow:0 2px 8px rgba(0,0,0,.18);position:relative}
.lab-mark::after{content:'';position:absolute;right:5px;bottom:5px;width:5px;height:5px;
  border-radius:50%;background:rgba(255,255,255,.65)}
.lab-brand-copy{display:grid;gap:1px}
.lab-brand-name{font-family:var(--display,'Unbounded','Manrope',system-ui,sans-serif);font-weight:900;font-size:.92rem;
  letter-spacing:-.02em;color:var(--text);line-height:1}
.lab-brand-tag{font-size:.55rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;
  color:var(--muted);line-height:1}
.lab-nav{display:flex;gap:.4rem;align-items:center;margin-left:auto;flex-wrap:wrap}
.lab-back{font-size:.75rem;font-weight:700;color:var(--muted);text-decoration:none;
  padding:.2rem .6rem;border-radius:.5rem;transition:color .18s}
.lab-back:hover{color:var(--accent2)}
.lab-pill-nav{display:inline-grid;place-items:center;padding:.2rem .65rem;
  border:1px solid rgba(0,0,0,.13);border-radius:999px;font-size:.65rem;font-weight:800;
  letter-spacing:.1em;text-transform:uppercase;background:rgba(0,0,0,.04);color:var(--muted)}
.lab-pill-accent{background:var(--accent2);color:#fff;border-color:var(--accent2)}
.lab-tool-btn{height:30px;padding:0 .75rem;border:1px solid rgba(0,0,0,.15);border-radius:7px;
  background:transparent;font-size:.7rem;font-weight:700;letter-spacing:.06em;cursor:pointer;
  color:var(--muted);transition:all .16s;font-family:'Manrope',sans-serif}
.lab-tool-btn:hover{border-color:var(--accent2);color:var(--accent2)}

/* Lab hero */
.lab-hero{border:1px solid rgba(0,0,0,.07);border-radius:1.5rem;
  margin:1.2rem auto 0;max-width:960px;
  padding:clamp(1.5rem,4vw,2.8rem) clamp(1.2rem,3vw,2.2rem);
  background:var(--surface,#fff);overflow:hidden;position:relative;
  box-shadow:0 4px 24px rgba(0,0,0,.06)}
.lab-hero::before{content:'';position:absolute;right:-80px;top:-80px;width:320px;height:320px;
  border-radius:50%;background:radial-gradient(circle,var(--accent3) 0%,transparent 68%);
  pointer-events:none;opacity:.22}
.lab-hero-inner{position:relative;z-index:1;display:grid;
  grid-template-columns:1fr 148px;gap:2rem;align-items:center}
.lab-eyebrow{font-size:.67rem;font-weight:800;letter-spacing:.22em;text-transform:uppercase;
  color:var(--accent2);margin-bottom:.8rem;display:flex;align-items:center;gap:.5rem}
.lab-eyebrow::before{content:'';display:inline-block;width:20px;height:2px;background:var(--accent2);flex-shrink:0}
.lab-hero-title{font-family:var(--display,'Unbounded','Manrope',system-ui,sans-serif);font-weight:900;
  font-size:clamp(1.75rem,5vw,3rem);line-height:1.05;letter-spacing:-.04em;
  margin-bottom:.8rem;color:var(--text)}
.lab-hero-title em{font-style:normal;color:var(--accent2)}
.lab-hero-lead{color:var(--muted);font-size:clamp(.85rem,1.7vw,1rem);line-height:1.7;margin-bottom:1.1rem}
.lab-hero-badges{display:flex;gap:.4rem;flex-wrap:wrap}
.lab-badge{display:inline-grid;place-items:center;padding:.22rem .65rem;
  border:1px solid rgba(0,0,0,.12);border-radius:999px;font-size:.64rem;font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;background:rgba(0,0,0,.04);color:var(--muted)}
.lab-hero-visual{width:148px;height:148px;border-radius:1.1rem;
  background:linear-gradient(135deg,var(--accent3) 0%,var(--accent) 100%);
  border:1px solid rgba(0,0,0,.06);display:flex;align-items:center;justify-content:center;
  flex-shrink:0;opacity:.85}
.lab-vis-inner{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:16px}
.lab-vis-dot{border-radius:6px;background:rgba(255,255,255,.55)}
.lab-vis-dot:nth-child(1){height:32px}
.lab-vis-dot:nth-child(2){height:20px;margin-top:auto}
.lab-vis-dot:nth-child(3){height:20px}
.lab-vis-dot:nth-child(4){height:32px;margin-top:auto}
@media(max-width:580px){
  .lab-hero-inner{grid-template-columns:1fr}
  .lab-hero-visual{display:none}
  .lab-topbar{flex-wrap:wrap;gap:.5rem}
}

/* Bubble Pop bonus */
.bub-score-bar{text-align:center;font-family:var(--display,'Unbounded','Manrope',system-ui,sans-serif);font-weight:900;
  font-size:1.1rem;color:var(--accent2);margin-bottom:.6rem}
#bubCanvas{width:100%;height:360px;display:block;border-radius:1rem;
  background:
    radial-gradient(circle at 16% 18%,rgba(255,255,255,.84),transparent 28%),
    linear-gradient(160deg,var(--bg,#f5f5f5) 54%,color-mix(in srgb,var(--accent3) 36%,transparent));
  cursor:crosshair;touch-action:none;border:1.5px solid rgba(0,0,0,.07)}
.bub-actions{display:flex;gap:.6rem;justify-content:center;margin-top:.8rem;flex-wrap:wrap}
@media(max-width:640px){#bubCanvas{height:320px}}



/* TOP ONLY: align demo header with A1 Lesson 01 without changing palettes */
