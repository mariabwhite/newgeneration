</figure>


<script>
// ===== CORE =====
const tasksDone = new Set();
const A1_TOTAL_TASKS = 6;
const A1_PROGRESS_KEY = 'linguaboost.lab.school.progress.v1';
let a1Combo = 1;
function a1SaveProgress(){try{localStorage.setItem(A1_PROGRESS_KEY,JSON.stringify({done:[...tasksDone],combo:a1Combo}));}catch(e){}}
function a1UpdateHud(showCombo){
  const done = tasksDone.size;
  const doneEl = document.getElementById('a1HudDone');
  const scoreEl = document.getElementById('a1HudScore');
  const comboEl = document.getElementById('a1HudCombo');
  if(doneEl) doneEl.textContent = done + ' / ' + A1_TOTAL_TASKS + ' done';
  if(scoreEl) scoreEl.textContent = 'Score ' + (done * 100);
  if(comboEl) comboEl.textContent = 'Combo x' + a1Combo;
  if(showCombo){const pop=document.getElementById('a1ComboPop');if(pop){pop.textContent='Combo x'+a1Combo;pop.classList.add('show');setTimeout(()=>pop.classList.remove('show'),900);}}
  if(typeof updateAdventureMap === 'function') updateAdventureMap();
}
const a1StepBlocks = [
  ['flashcards', 'Flashcards'],
  ['memory', 'Memory'],
  ['spelling', 'Spelling Bee'],
  ['pronouns', 'Pronouns'],
  ['quiz', 'Quiz'],
  ['speaking', 'Speak All']
];
function updateA1StepTracker(){
  const currentEl = document.querySelector('[data-step-current]');
  const fillEl = document.querySelector('[data-step-fill]');
  const nameEl = document.querySelector('[data-step-name]');
  if(!currentEl || !fillEl || !nameEl) return;
  let activeIndex = 0;
  a1StepBlocks.forEach(([id], index) => {
    const block = document.getElementById(id);
    if(block && block.getBoundingClientRect().top < window.innerHeight * 0.42) activeIndex = index;
  });
  currentEl.textContent = String(activeIndex + 1).padStart(2, '0');
  fillEl.style.width = (((activeIndex + 1) / a1StepBlocks.length) * 100) + '%';
  nameEl.textContent = a1StepBlocks[activeIndex][1];
}
window.addEventListener('DOMContentLoaded', updateA1StepTracker);
window.addEventListener('scroll', updateA1StepTracker, { passive: true });
window.addEventListener('resize', updateA1StepTracker);
function a1RestoreProgress(){
  try{const saved=JSON.parse(localStorage.getItem(A1_PROGRESS_KEY)||'{}');if(Array.isArray(saved.done)){saved.done.forEach(n=>{tasksDone.add(n);document.getElementById('rail'+n)?.classList.add('done');const star=document.getElementById('star'+n);if(star){star.classList.add('lit');star.textContent='\u{1F31F}';}});}a1Combo=Number(saved.combo)||Math.max(1,tasksDone.size+1);}catch(e){}
  a1UpdateHud(false);
}
window.addEventListener('DOMContentLoaded',a1RestoreProgress);
function completeTask(n) {
  if (tasksDone.has(n)) return;
  tasksDone.add(n);
  document.getElementById('rail' + n).classList.add('done');
  const star = document.getElementById('star' + n);
  star.classList.add('lit');
  star.textContent = '\u{1F31F}';
  a1Combo=Math.min(9,a1Combo+1);
a1UpdateHud(true);
a1SaveProgress();
  if (tasksDone.size === 6) {
    setTimeout(() => {
      document.getElementById('allDone').classList.add('show');
      launchConfetti();
    }, 400);
  }
}

function launchConfetti() {
  const canvas = document.getElementById('confettiCanvas');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  const colors = ['#9c27b0','#ce93d8','#7b1fa2','#f1c40f','#2c7a4d','#e91e63'];
  const pieces = Array.from({length:160}, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * canvas.height - canvas.height,
    r: Math.random() * 7 + 3,
    d: Math.random() * 160,
    color: colors[Math.floor(Math.random() * colors.length)],
    angle: Math.random() * Math.PI * 2,
    spin: Math.random() * .2 - .1,
    speed: Math.random() * 3 + 1
  }));
  let frame = 0;
  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    pieces.forEach(p => {
      ctx.beginPath();
      ctx.ellipse(p.x, p.y, p.r, p.r / 2, p.angle, 0, Math.PI * 2);
      ctx.fillStyle = p.color;
      ctx.fill();
      p.y += p.speed;
      p.x += Math.sin(p.d / 30) * 2;
      p.angle += p.spin;
      p.d++;
      if (p.y > canvas.height) p.y = -10;
    });
    if (++frame < 220) requestAnimationFrame(draw);
    else ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
  draw();
}

function speak(text) {
  if (!window.speechSynthesis) return;
  window.speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = 'en-US';
  u.rate = 0.85;
  window.speechSynthesis.speak(u);
}

function toggleLang() {
  const h = document.documentElement;
  const next = h.dataset.lang === 'ru' ? 'en' : 'ru';
  h.dataset.lang = next;
  document.querySelectorAll('[data-ru],[data-en]').forEach(el => {
    el.innerHTML = el.dataset[next] || el.innerHTML;
  });
}

// ===== SECTION 1: FLASHCARDS =====
const flashCards = [
  {en:'I',        ru:'СЏ'},
  {en:'you',      ru:'С‚С‹ / РІС‹'},
  {en:'he',       ru:'РѕРЅ'},
  {en:'she',      ru:'РѕРЅР°'},
  {en:'we',       ru:'РјС‹'},
  {en:'they',     ru:'РѕРЅРё'},
  {en:'it',       ru:'РѕРЅРѕ / СЌС‚Рѕ'},
  {en:'pencil',   ru:'РєР°СЂР°РЅРґР°С€'},
  {en:'ruler',    ru:'Р»РёРЅРµР№РєР°'},
  {en:'notebook', ru:'С‚РµС‚СЂР°РґСЊ'},
  {en:'backpack', ru:'СЂСЋРєР·Р°Рє'},
  {en:'classroom',ru:'РєР»Р°СЃСЃ'}
];

let flippedCount = 0;
(function buildFlip() {
  const grid = document.getElementById('flipGrid');
  flashCards.forEach(c => {
    const card = document.createElement('div');
    card.className = 'flip-card';
    card.innerHTML = `
      <div class="flip-inner">
        <div class="flip-face flip-front">${c.en}</div>
        <div class="flip-face flip-back">${c.ru}</div>
      </div>`;
    card.addEventListener('click', function() {
      if (!this.classList.contains('flipped')) {
        this.classList.add('flipped');
        flippedCount++;
        document.getElementById('flipProgress').textContent = 'Flipped: ' + flippedCount + ' / 12';
        if (flippedCount === 12) completeTask(1);
      }
    });
    grid.appendChild(card);
  });
})();

// ===== SECTION 2: MEMORY GAME =====
const memPairs = [
  {en:'I',        ru:'me'},
  {en:'you',      ru:'you'},
  {en:'pencil',   ru:'pencil'},
  {en:'ruler',    ru:'ruler'},
  {en:'notebook', ru:'notebook'},
  {en:'backpack', ru:'backpack'},
];

let memFlipped = [], memLocked = false, memMatched = 0;

(function buildMemory() {
  const cards = [];
  memPairs.forEach((p, i) => {
    cards.push({id: 'en' + i, word: p.en, pair: i});
    cards.push({id: 'ru' + i, word: p.ru, pair: i});
  });
  // Shuffle
  for (let i = cards.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [cards[i], cards[j]] = [cards[j], cards[i]];
  }
  const grid = document.getElementById('memGrid');
  cards.forEach(c => {
    const div = document.createElement('div');
    div.className = 'mem-card';
    div.dataset.pair = c.pair;
    div.dataset.id = c.id;
    div.dataset.word = c.word;
    div.addEventListener('click', onMemClick);
    grid.appendChild(div);
  });
})();

function onMemClick() {
  if (memLocked || this.classList.contains('matched') || this.classList.contains('face-up')) return;
  this.classList.add('face-up');
  this.textContent = this.dataset.word;
  memFlipped.push(this);
  if (memFlipped.length === 2) {
    memLocked = true;
    const [a, b] = memFlipped;
    if (a.dataset.pair === b.dataset.pair) {
      a.classList.add('matched');
      b.classList.add('matched');
      memMatched++;
      document.getElementById('memStatus').textContent = 'Pairs found: ' + memMatched + ' / 6';
      memFlipped = [];
      memLocked = false;
      if (memMatched === 6) completeTask(2);
    } else {
      setTimeout(() => {
        a.classList.remove('face-up');
        b.classList.remove('face-up');
        a.textContent = '';
        b.textContent = '';
        a.classList.add('shake');
        b.classList.add('shake');
        setTimeout(() => { a.classList.remove('shake'); b.classList.remove('shake'); }, 350);
        memFlipped = [];
        memLocked = false;
      }, 900);
    }
  }
}

// ===== SECTION 3: SPELLING BEE =====
const beeWords = ['pencil','ruler','notebook','backpack','classroom','teacher','student','homework'];
let beeIdx = 0, beeScore = 0;

(function buildBeeScoreBar() {
  const bar = document.getElementById('beeScoreBar');
  beeWords.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'bee-dot';
    d.id = 'beeDot' + i;
    bar.appendChild(d);
  });
})();

function speakBee() {
  if (beeIdx < beeWords.length) speak(beeWords[beeIdx]);
}

function checkBee() {
  if (beeIdx >= beeWords.length) return;
  const input = document.getElementById('beeInput');
  const val = input.value.trim().toLowerCase();
  const correct = beeWords[beeIdx];
  const fb = document.getElementById('beeFeedback');
  const dot = document.getElementById('beeDot' + beeIdx);
  if (val === correct) {
    beeScore++;
    fb.className = 'bee-feedback ok';
    fb.textContent = '&#10003; Correct!';
    dot.classList.add('ok');
  } else {
    fb.className = 'bee-feedback miss';
    fb.textContent = '&#10007; Correct spelling: ' + correct;
    dot.classList.add('miss');
  }
  beeIdx++;
  input.value = '';
  if (beeIdx < beeWords.length) {
    document.getElementById('beeProgress').textContent = 'Word ' + (beeIdx + 1) + ' / 8';
    setTimeout(() => { fb.textContent = ''; }, 800);
  } else {
    document.getElementById('beeProgress').textContent = 'Done!';
    document.getElementById('beeDone').style.display = 'block';
    input.disabled = true;
    if (beeScore >= 4) completeTask(3);
  }
}

document.getElementById('beeInput').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') checkBee();
});

// ===== SECTION 4: PRONOUN MATCHING =====
const pronounPairs = [
  {en:'I',        ru:'СЏ'},
  {en:'you',      ru:'С‚С‹ / РІС‹'},
  {en:'he',       ru:'РѕРЅ'},
  {en:'she',      ru:'РѕРЅР°'},
  {en:'we',       ru:'РјС‹'},
  {en:'they',     ru:'РѕРЅРё'},
  {en:'it',       ru:'РѕРЅРѕ / СЌС‚Рѕ'},
];

const matchRuShuffled = ['С‚С‹ / РІС‹','РѕРЅРё','РѕРЅ','РјС‹','РѕРЅРѕ / СЌС‚Рѕ','РѕРЅР°','СЏ'];
let matchSelected = null, matchCount = 0;

(function buildMatch() {
  const left = document.getElementById('matchLeft');
  const right = document.getElementById('matchRight');
  pronounPairs.forEach(p => {
    const btn = document.createElement('button');
    btn.className = 'match-btn';
    btn.textContent = p.en;
    btn.dataset.side = 'en';
    btn.dataset.en = p.en;
    btn.dataset.ru = p.ru;
    btn.addEventListener('click', onMatchClick);
    left.appendChild(btn);
  });
  matchRuShuffled.forEach(r => {
    const btn = document.createElement('button');
    btn.className = 'match-btn';
    btn.textContent = r;
    btn.dataset.side = 'ru';
    btn.dataset.ru = r;
    btn.addEventListener('click', onMatchClick);
    right.appendChild(btn);
  });
})();

function onMatchClick() {
  if (this.classList.contains('matched')) return;
  if (this.dataset.side === 'en') {
    document.querySelectorAll('#matchLeft .match-btn.selected').forEach(b => b.classList.remove('selected'));
    this.classList.add('selected');
    matchSelected = this;
  } else {
    if (!matchSelected) return;
    const enRu = matchSelected.dataset.ru.toLowerCase();
    const ruVal = this.dataset.ru.toLowerCase();
    if (enRu === ruVal) {
      matchSelected.classList.add('matched');
      matchSelected.classList.remove('selected');
      this.classList.add('matched');
      matchCount++;
      document.getElementById('matchStatus').textContent = 'Matched: ' + matchCount + ' / 7';
      matchSelected = null;
      if (matchCount === 7) completeTask(4);
    } else {
      this.classList.add('shake');
      matchSelected.classList.remove('selected');
      matchSelected = null;
      setTimeout(() => this.classList.remove('shake'), 350);
    }
  }
}

// ===== SECTION 5: QUIZ =====
const quizBankClean = [
  {q:'"I" is a...',                    opts:['pronoun','noun','verb'],                                   ans:'pronoun'},
  {q:'РєР°СЂР°РЅРґР°С€ = ?',                   opts:['ruler','notebook','pencil'],                               ans:'pencil'},
  {q:'"She" refers to...',             opts:['a boy','a girl','a thing'],                                ans:'a girl'},
  {q:'С‚РµС‚СЂР°РґСЊ = ?',                    opts:['backpack','notebook','ruler'],                             ans:'notebook'},
  {q:'We = ?',                         opts:['РѕРЅРё','РјС‹','РІС‹'],                                           ans:'РјС‹'},
  {q:'СЂСЋРєР·Р°Рє = ?',                     opts:['backpack','pencil','notebook'],                            ans:'backpack'},
  {q:'"He" refers to...',              opts:['a girl','a boy','yourself'],                               ans:'a boy'},
  {q:'Р»РёРЅРµР№РєР° = ?',                    opts:['pencil','ruler','eraser'],                                 ans:'ruler'},
  {q:'They = ?',                       opts:['РјС‹','РІС‹','РѕРЅРё'],                                           ans:'РѕРЅРё'},
  {q:'РєР»Р°СЃСЃ = ?',                      opts:['classroom','teacher','homework'],                          ans:'classroom'},
  {q:'"It" refers to...',              opts:['a person','a thing','a group'],                            ans:'a thing'},
  {q:'СѓС‡РёС‚РµР»СЊ = ?',                    opts:['student','homework','teacher'],                            ans:'teacher'},
  {q:'You (plural) = ?',               opts:['РјС‹','РІС‹','РѕРЅРё'],                                           ans:'РІС‹'},
  {q:'РґРѕРјР°С€РЅРµРµ Р·Р°РґР°РЅРёРµ = ?',           opts:['notebook','homework','pencil'],                            ans:'homework'},
  {q:'СѓС‡РµРЅРёРє = ?',                     opts:['teacher','student','ruler'],                               ans:'student'},
  {q:'She = ?',                        opts:['РѕРЅ','РѕРЅР°','РѕРЅРѕ'],                                          ans:'РѕРЅР°'},
  {q:'Backpack in Russian?',           opts:['С‚РµС‚СЂР°РґСЊ','Р»РёРЅРµР№РєР°','СЂСЋРєР·Р°Рє'],                              ans:'СЂСЋРєР·Р°Рє'},
  {q:'I = ?',                          opts:['СЏ','С‚С‹','РѕРЅ'],                                             ans:'СЏ'},
  {q:'Classroom in Russian?',          opts:['РєР»Р°СЃСЃ','СѓСЂРѕРє','С€РєРѕР»Р°'],                                    ans:'РєР»Р°СЃСЃ'},
  {q:'"We" refers to...',              opts:['one person','a group including speaker','others only'],     ans:'a group including speaker'}
];

function shuffle(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

const quizSelected = shuffle(quizBankClean).slice(0, 10);
let quizChecked = false;

(function buildQuiz() {
  const container = document.getElementById('quizContainer');
  quizSelected.forEach((q, i) => {
    const div = document.createElement('div');
    div.className = 'quiz-item';
    const optsHTML = q.opts.map(o =>
      `<label><input type="radio" name="q${i}" value="${o}"/> ${o}</label>`
    ).join('');
    div.innerHTML = `
      <div class="quiz-q">${i + 1}. ${q.q}</div>
      <div class="quiz-opts">${optsHTML}</div>
      <div class="quiz-result" id="qr${i}" style="display:none;"></div>`;
    container.appendChild(div);
  });
})();

function checkQuiz() {
  if (quizChecked) return;
  quizChecked = true;
  let score = 0;
  quizSelected.forEach((q, i) => {
    const sel = document.querySelector(`input[name="q${i}"]:checked`);
    const res = document.getElementById('qr' + i);
    res.style.display = 'block';
    if (sel && sel.value === q.ans) {
      score++;
      res.className = 'quiz-result ok';
      res.textContent = '&#10003; ' + q.ans;
    } else {
      res.className = 'quiz-result miss';
      res.textContent = '&#10007; correct: ' + q.ans;
    }
  });
  const display = document.getElementById('quizScoreDisplay');
  display.style.display = 'inline-block';
  display.textContent = `Score: ${score} / ${quizSelected.length}`;
  if (score >= 7) completeTask(5);
  document.getElementById('quizCheckBtn').disabled = true;
}

// ===== SECTION 6: SPEAK ALL =====
let speakHeard = 0;
const speakAllClean = [
  {en:'Hello, I am a student.',   ru:'Р—РґСЂР°РІСЃС‚РІСѓР№С‚Рµ, СЏ СѓС‡РµРЅРёРє.'},
  {en:'This is my pencil.',       ru:'Р­С‚Рѕ РјРѕР№ РєР°СЂР°РЅРґР°С€.'},
